#!/usr/bin/env bash
# Aplica, em ordem, as migrações de migrations/ ainda não aplicadas.
# Cada migração é um script bash; se falhar, as seguintes não rodam.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

feitas="$JANGADA_ESTADO/migracoes"
mkdir -p "$feitas"
n=0
for m in "$JANGADA_PATH"/migrations/*.sh; do
  [[ -e "$m" ]] || continue
  nome="$(basename "$m")"
  [[ -e "$feitas/$nome" ]] && continue
  echo "==> migração $nome"
  if bash "$m"; then
    touch "$feitas/$nome"
    n=$((n + 1))
  else
    echo "migração $nome falhou; corrija e rode jangada-migrar de novo" >&2
    exit 1
  fi
done
echo "migrações aplicadas: $n"
