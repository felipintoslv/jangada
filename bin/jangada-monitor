#!/usr/bin/env bash
# Abre o monitor do sistema (btop ou htop) em janela flutuante.
#
# Uso: jangada-monitor
set -euo pipefail
# shellcheck source=bin/jangada-shell-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-shell-config"
if [[ "${1:-}" == --json ]]; then
  diagnostico="$JANGADA_PATH/default/painel/monitoramento.py"
  if [[ ! -f "$diagnostico" ]]; then
    echo 'jangada-monitor: diagnóstico indisponível; módulo Monitor ausente ou incompleto' >&2
    exit 1
  fi
  exec python3 "$diagnostico"
fi

mon="htop"
if command -v btop >/dev/null 2>&1; then
  mon="btop"
elif command -v htop >/dev/null 2>&1; then
  mon="htop"
fi

# Solto do processo que chamou: vindo de um clique na waybar, um terminal em
# primeiro plano prende o módulo daquela barra até a janela fechar.
setsid -f "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.monitor --titulo "Monitor do Sistema" -e "$mon"
