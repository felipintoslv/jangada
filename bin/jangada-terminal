#!/usr/bin/env bash
# Abre o terminal preferido, opcionalmente com classe própria e um comando.
#
# Uso: jangada-terminal [--classe org.exemplo.nome] [--titulo texto] [-e comando args...]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

classe=""
titulo=""
comando=()
while (($#)); do
  case "$1" in
    --classe) classe="$2"; shift 2 ;;
    --titulo) titulo="$2"; shift 2 ;;
    -e) shift; comando=("$@"); break ;;
    *) echo "argumento desconhecido: $1" >&2; exit 1 ;;
  esac
done

term="$JANGADA_TERMINAL"
if [[ -z "$term" ]]; then
  for t in ghostty kitty foot alacritty; do
    command -v "$t" >/dev/null 2>&1 && { term="$t"; break; }
  done
fi
[[ -n "$term" ]] || { jangada_notificar "jangada" "nenhum terminal encontrado"; exit 1; }

args=()
case "$term" in
  *ghostty*)
    [[ -n "$classe" ]] && args+=("--class=$classe")
    [[ -n "$titulo" ]] && args+=("--title=$titulo")
    ((${#comando[@]})) && args+=(-e "${comando[@]}")
    ;;
  *kitty*)
    [[ -n "$classe" ]] && args+=(--class "$classe")
    [[ -n "$titulo" ]] && args+=(--title "$titulo")
    ((${#comando[@]})) && args+=("${comando[@]}")
    ;;
  foot)
    [[ -n "$classe" ]] && args+=("--app-id=$classe")
    [[ -n "$titulo" ]] && args+=("--title=$titulo")
    ((${#comando[@]})) && args+=("${comando[@]}")
    ;;
  *alacritty*)
    [[ -n "$classe" ]] && args+=(--class "$classe")
    [[ -n "$titulo" ]] && args+=(--title "$titulo")
    ((${#comando[@]})) && args+=(-e "${comando[@]}")
    ;;
  *)
    ((${#comando[@]})) && args+=(-e "${comando[@]}")
    ;;
esac

exec "$term" "${args[@]}"
