#!/usr/bin/env bash
# Abre o terminal preferido, opcionalmente com classe própria e um comando.
#
# Uso: jangada-terminal [--classe org.exemplo.nome] [--titulo texto] [-e comando args...]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

classe=""
titulo=""
comando=()
while (($#)); do
  case "$1" in
    --classe) classe="$2"; shift 2 ;;
    --titulo) titulo="$2"; shift 2 ;;
    -e) shift; comando=("$@"); break ;;
    *) echo "argumento desconhecido: $1" >&2; exit 1 ;;
  esac
done

term="$JANGADA_TERMINAL"
if [[ -z "$term" ]]; then
  for t in ghostty kitty foot alacritty; do
    command -v "$t" >/dev/null 2>&1 && { term="$t"; break; }
  done
  if [[ -z "$term" && "$(uname -s)" == "Darwin" ]]; then
    if [[ -x "/Applications/Ghostty.app/Contents/MacOS/ghostty" ]]; then
      term="/Applications/Ghostty.app/Contents/MacOS/ghostty"
    elif [[ -x "/Applications/Kitty.app/Contents/MacOS/kitty" ]]; then
      term="/Applications/Kitty.app/Contents/MacOS/kitty"
    elif [[ -x "/Applications/Alacritty.app/Contents/MacOS/alacritty" ]]; then
      term="/Applications/Alacritty.app/Contents/MacOS/alacritty"
    elif [[ -d "/Applications/iTerm.app" ]]; then
      term="iterm"
    else
      term="terminal.app"
    fi
  fi
fi
[[ -n "$term" ]] || { jangada_notificar "jangada" "nenhum terminal encontrado"; exit 1; }

args=()
case "$term" in
  *ghostty*)
    [[ -n "$classe" ]] && args+=("--class=$classe")
    [[ -n "$titulo" ]] && args+=("--title=$titulo")
    ((${#comando[@]})) && args+=(-e "${comando[@]}")
    ;;
  *kitty*)
    [[ -n "$classe" ]] && args+=(--class "$classe")
    [[ -n "$titulo" ]] && args+=(--title "$titulo")
    ((${#comando[@]})) && args+=("${comando[@]}")
    ;;
  foot)
    [[ -n "$classe" ]] && args+=("--app-id=$classe")
    [[ -n "$titulo" ]] && args+=("--title=$titulo")
    ((${#comando[@]})) && args+=("${comando[@]}")
    ;;
  *alacritty*)
    [[ -n "$classe" ]] && args+=(--class "$classe")
    [[ -n "$titulo" ]] && args+=(--title "$titulo")
    ((${#comando[@]})) && args+=(-e "${comando[@]}")
    ;;
  iterm)
    cmd_str="$(printf '%q ' "${comando[@]}")"
    exec osascript -e "tell application \"iTerm\" to create window with default profile command \"$cmd_str\""
    ;;
  terminal.app)
    cmd_str="$(printf '%q ' "${comando[@]}")"
    exec osascript -e "tell application \"Terminal\" to do script \"$cmd_str\""
    ;;
  *)
    ((${#comando[@]})) && args+=(-e "${comando[@]}")
    ;;
esac

exec "$term" "${args[@]}"
