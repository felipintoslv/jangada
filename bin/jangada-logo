#!/usr/bin/env bash
# Mostra o símbolo do jangada com as informações do sistema (fastfetch ou neofetch).
set -euo pipefail
JANGADA_PATH="${JANGADA_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export JANGADA_PATH
logo="$JANGADA_PATH/default/logo/jangada.txt"

if command -v fastfetch >/dev/null 2>&1; then
  # O caminho do logo no arquivo de configuração assume a instalação padrão;
  # a opção --logo garante o caminho certo em qualquer local.
  exec fastfetch -c "$JANGADA_PATH/default/fastfetch/config.jsonc" --logo "$logo" "$@"
elif command -v neofetch >/dev/null 2>&1; then
  # O neofetch marca as cores como ${c1}; o arquivo usa o formato do fastfetch ($1).
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  sed -E 's/\$([1-9])/${c\1}/g' "$logo" >"$tmp"
  neofetch --ascii "$tmp" --ascii_colors 15 3 3 6 "$@"
else
  # Sem nenhum dos dois, mostra só o desenho.
  sed -E -e $'s/\\$1/\e[97m/g' -e $'s/\\$2/\e[33m/g' -e $'s/\\$3/\e[33m/g' -e $'s/\\$4/\e[36m/g' -e $'s/$/\e[0m/' "$logo"
fi
