#!/usr/bin/env bash
# Atualizações pendentes de pacotes, para a barra e para a linha de comando.
#
# Uso: jangada-atualizacoes [--waybar]
#   --waybar   saída JSON para o módulo da barra; texto vazio esconde o módulo
# Sem argumento, lista as atualizações e sai com 1 quando não há nenhuma.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

# O checkupdates baixa o banco para uma cópia própria, então não mexe no
# /var/lib/pacman/sync nem exige raiz. Sem ele não há como contar sem sudo.
oficiais() {
  command -v checkupdates >/dev/null 2>&1 || return 0
  checkupdates 2>/dev/null || true
}

# O ajudante do AUR só é consultado se já estiver instalado. Ele fala com a
# rede, e é por isso que o intervalo do módulo é longo.
aur() {
  local ajudante
  for ajudante in paru yay; do
    if command -v "$ajudante" >/dev/null 2>&1; then
      "$ajudante" -Qua 2>/dev/null || true
      return 0
    fi
  done
}

lista_oficiais="$(oficiais)"
lista_aur="$(aur)"
n_oficiais=0; n_aur=0
[[ -n "$lista_oficiais" ]] && n_oficiais="$(wc -l <<<"$lista_oficiais")"
[[ -n "$lista_aur" ]] && n_aur="$(wc -l <<<"$lista_aur")"
total=$((n_oficiais + n_aur))

if [[ "${1:-}" == "--waybar" ]]; then
  if ((total == 0)); then
    # Texto vazio faz a waybar recolher o módulo, que é o comportamento
    # desejado: atualização pendente é aviso, não enfeite permanente.
    jq -cn '{text:"", tooltip:"sistema em dia", class:"vazio"}'
    exit 0
  fi
  dica="$total atualização(ões) pendente(s)"
  ((n_aur > 0)) && dica+=$'\n'"$n_oficiais nos repositórios oficiais, $n_aur no AUR"
  [[ -n "$lista_oficiais" ]] && dica+=$'\n\n'"$(head -n 20 <<<"$lista_oficiais")"
  ((n_oficiais > 20)) && dica+=$'\n'"... e mais $((n_oficiais - 20))"
  jq -cn --arg t "󰚰 $total" --arg d "$dica" '{text:$t, tooltip:$d, class:"pendente"}'
  exit 0
fi

if ((total == 0)); then
  echo "nenhuma atualização pendente"
  exit 1
fi
[[ -n "$lista_oficiais" ]] && printf '%s\n' "$lista_oficiais"
[[ -n "$lista_aur" ]] && printf '%s\n' "$lista_aur" | sed 's/^/AUR /'
