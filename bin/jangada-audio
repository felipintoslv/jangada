#!/usr/bin/env bash
# Gerencia e alterna dispositivos de áudio (fones, caixas de som, microfones) via wpctl e fuzzel.
#
# Uso:
#   jangada-audio [saida|entrada|menu]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

menu_fuzzel() {
  jangada_fuzzel --prompt "${1:-áudio} > "
}

obter_dispositivos() {
  local secao="$1"
  python3 - "$secao" << 'EOF'
import subprocess, re, sys

secao = sys.argv[1]
try:
    out = subprocess.check_output(["wpctl", "status"], text=True)
except Exception:
    sys.exit(0)

in_section = False
for line in out.splitlines():
    if f"├─ {secao}:" in line or f"└─ {secao}:" in line:
        in_section = True
        continue
    if in_section:
        if re.match(r"^\s*[├└]─", line):
            break
        m = re.search(r"│\s*(\*?)\s*(\d+)\.\s*(.*?)(?:\s*\[vol:.*\])?$", line)
        if m:
            is_active = bool(m.group(1))
            dev_id = m.group(2)
            name = m.group(3).strip()
            if name:
                low = name.lower()
                if secao == "Sinks":
                    if any(k in low for k in ["bluetooth", "bluez"]):
                        icon = "󰂯"
                    elif any(k in low for k in ["cloud", "fone", "headphone", "headset", "earbuds", "buds"]):
                        icon = "󰋋"
                    elif any(k in low for k in ["hdmi", "digital", "displayport"]):
                        icon = "󰡁"
                    else:
                        icon = "󰕾"
                else:
                    if any(k in low for k in ["bluetooth", "bluez"]):
                        icon = "󰂯"
                    elif any(k in low for k in ["webcam", "camera"]):
                        icon = "󰖉"
                    else:
                        icon = ""

                mark = "✔ " if is_active else "  "
                print(f"{mark} [{dev_id}] {icon}  {name}")
EOF
}

trocar_saida() {
  local lista escolha id nome
  lista="$(obter_dispositivos "Sinks")"
  if [[ -z "$lista" ]]; then
    notify-send -a jangada -u normal "Áudio" "Nenhum dispositivo de saída encontrado." 2>/dev/null || true
    return 1
  fi

  escolha="$(menu_fuzzel "saída de áudio" <<<"$lista")" || return 0
  [[ -n "$escolha" ]] || return 0

  id="$(grep -oP '\[\K[0-9]+(?=\])' <<<"$escolha")"
  nome="$(sed -E 's/^[✔ ]* \[[0-9]+\] [^ ]+  //' <<<"$escolha")"

  if [[ -n "$id" ]]; then
    wpctl set-default "$id"
    notify-send -a jangada -u low "Saída de áudio" "Dispositivo ativo: $nome" 2>/dev/null || true
  fi
}

trocar_entrada() {
  local lista escolha id nome
  lista="$(obter_dispositivos "Sources")"
  if [[ -z "$lista" ]]; then
    notify-send -a jangada -u normal "Áudio" "Nenhum microfone/entrada encontrado." 2>/dev/null || true
    return 1
  fi

  escolha="$(menu_fuzzel "microfone / entrada" <<<"$lista")" || return 0
  [[ -n "$escolha" ]] || return 0

  id="$(grep -oP '\[\K[0-9]+(?=\])' <<<"$escolha")"
  nome="$(sed -E 's/^[✔ ]* \[[0-9]+\] [^ ]+  //' <<<"$escolha")"

  if [[ -n "$id" ]]; then
    wpctl set-default "$id"
    notify-send -a jangada -u low "Microfone" "Dispositivo ativo: $nome" 2>/dev/null || true
  fi
}

menu_geral() {
  local opcoes opcao
  opcoes="$(printf '%s\n' \
    "󰋋  Trocar saída de áudio (fones / caixas)" \
    "  Trocar entrada de áudio (microfone)" \
    "󰝟  Alternar mudo da saída de som" \
    "  Alternar mudo do microfone")"

  if command -v pavucontrol >/dev/null 2>&1; then
    opcoes+=$'\n'"󰓃  Abrir controle avançado (pavucontrol)"
  elif command -v pwvucontrol >/dev/null 2>&1; then
    opcoes+=$'\n'"󰓃  Abrir controle avançado (pwvucontrol)"
  fi

  opcao="$(menu_fuzzel "áudio" <<<"$opcoes")" || return 0
  case "$opcao" in
    *"Trocar saída"*) trocar_saida ;;
    *"Trocar entrada"*) trocar_entrada ;;
    *"mudo da saída"*)
      wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
      notify-send -a jangada -u low "Áudio" "Mudo da saída alternado." 2>/dev/null || true
      ;;
    *"mudo do microfone"*)
      wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
      notify-send -a jangada -u low "Áudio" "Mudo do microfone alternado." 2>/dev/null || true
      ;;
    *"pavucontrol"*) setsid -f pavucontrol >/dev/null 2>&1 ;;
    *"pwvucontrol"*) setsid -f pwvucontrol >/dev/null 2>&1 ;;
  esac
}

case "${1:-menu}" in
  -h|--ajuda)
    sed -n '2,6s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  --listar-saidas)
    obter_dispositivos "Sinks"
    exit 0
    ;;
  --listar-entradas)
    obter_dispositivos "Sources"
    exit 0
    ;;
  saida|saída|sink|sinks)
    trocar_saida
    ;;
  entrada|source|sources|mic|microfone)
    trocar_entrada
    ;;
  menu|*)
    menu_geral
    ;;
esac
