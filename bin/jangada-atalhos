#!/usr/bin/env bash
# Mostra todos os atalhos ativos, lidos do próprio Hyprland.
#
# Uso:
#   jangada-atalhos           lista pesquisável no fuzzel (atalho SUPER+/)
#   jangada-atalhos --lista   mesma lista em texto, para o terminal
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

# O "hyprctl binds -j" devolve JSON inválido nesta versão, então lemos o texto.
# Cada atalho vem num bloco de "chave: valor" separado por linha em branco.
montar() {
  hyprctl binds 2>/dev/null | awk '
    function teclas(m,   s) {
      s = ""
      if (int(m / 64) % 2) s = s "SUPER + "
      if (int(m /  4) % 2) s = s "CTRL + "
      if (int(m /  8) % 2) s = s "ALT + "
      if (int(m /  1) % 2) s = s "SHIFT + "
      return s
    }
    /^[a-z]+$/            { mod = 0; key = ""; desc = ""; sub_ = ""; next }
    /^\tmodmask:/         { mod = $2; next }
    /^\tsubmap:/          { sub_ = substr($0, 10); next }
    /^\tkey:/             { key = $2; next }
    /^\tdescription:/     { desc = substr($0, 15); next }
    /^$/ {
      if (key == "") next
      if (sub_ != "") key = key "  [modo " sub_ "]"
      if (desc == "") desc = "—"
      printf "%s%s\t%s\n", teclas(mod), key, desc
      key = ""
    }
  ' | sort -u | awk -F'\t' '{ printf "%-28s %s\n", $1, $2 }'
}

case "${1:-}" in
  --lista) montar ;;
  -h|--ajuda) sed -n '2,6s/^# \{0,1\}//p' "$0" ;;
  "")
    montar | jangada_fuzzel --prompt "atalhos > "
    ;;
  *) echo "argumento desconhecido: $1" >&2; exit 1 ;;
esac
