#!/usr/bin/env bash
# Funções compartilhadas para identificar processos da interface desta sessão.
# Uso: source jangada-interface-processos (depois de jangada-config).

jangada_interface_pids() {
  local programa="$1" pid item config="" anterior="" mesmo args
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}${WAYLAND_DISPLAY:-}" ]] || return 0
  while IFS= read -r pid; do
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/environ" && -r "/proc/$pid/cmdline" ]] || continue
    mesmo=1
    for item in "JANGADA_CONFIG=$JANGADA_CONFIG" \
                "HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
                "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"; do
      # Variáveis ausentes não equivalem a outra sessão identificada.
      [[ "$item" == *= ]] && continue
      grep -zFxq -- "$item" "/proc/$pid/environ" 2>/dev/null || mesmo=0
    done
    ((mesmo)) || continue
    if [[ "$programa" == swaybg ]]; then
      grep -zFxq 'JANGADA_INTERFACE_PROCESSO=papel' "/proc/$pid/environ" 2>/dev/null || continue
    else
      config=""; anterior=""
      while IFS= read -r -d '' args; do
        if [[ "$anterior" == -c || "$anterior" == --config ]]; then config="$args"; fi
        [[ "$args" == --config=* ]] && config="${args#--config=}"
        anterior="$args"
      done <"/proc/$pid/cmdline"
      case "$programa:$config" in
        "waybar:$JANGADA_ESTADO/waybar/borda.jsonc"|"waybar:$JANGADA_CONFIG/waybar/config.jsonc"|\
        "waybar:$JANGADA_PATH/default/waybar/config.jsonc"|"mako:$JANGADA_CONFIG/mako/config") ;;
        *) continue ;;
      esac
    fi
    printf '%s\n' "$pid"
  done < <(pgrep -u "$(id -u)" -x "$programa" 2>/dev/null || true)
}

jangada_interface_sinalizar() {
  local programa="$1" sinal="$2" pid
  while IFS= read -r pid; do
    kill -s "$sinal" -- "$pid" 2>/dev/null || true
  done < <(jangada_interface_pids "$programa")
}

jangada_interface_recarregar_mako() {
  local dono pid
  # O makoctl usa o D-Bus do usuário; confira quem possui o serviço antes.
  dono="$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetConnectionUnixProcessID s org.freedesktop.Notifications 2>/dev/null)" || return 0
  [[ "$dono" =~ ^u\ ([0-9]+)$ ]] || return 0
  dono="${BASH_REMATCH[1]}"
  while IFS= read -r pid; do
    [[ "$pid" == "$dono" ]] || continue
    makoctl reload || true
    return 0
  done < <(jangada_interface_pids mako)
}
