#!/usr/bin/env bash
# Painel de indicadores do uso de IA: consolida os registros do jangada e dos
# agentes num cache e serve um app Shiny em 127.0.0.1.
#
# Uso: jangada-painel [OPÇÃO]
#   (sem opção)   atualiza o cache, sobe o app se preciso e abre o navegador
#   --gerar       só atualiza o cache
#   --json        atualiza o cache e imprime os indicadores do dia
#   --parar       encerra o app (libera a memória do R)
#   --waybar      JSON do módulo custom/indicadores; só lê o cache
#   --conferir    lista o que falta (R, pacotes R, pyarrow); não instala nada
#
# O cache fica em ~/.local/state/jangada/painel: uma tabela Parquet por fonte,
# gravada pelo default/painel/coletor.py, que lê os jsonl do Claude a partir
# de onde parou. O app (default/painel/app.R) só lê o cache e recarrega
# sozinho quando ele muda. Porta: JANGADA_PAINEL_PORTA (8765). O app só abre
# sessão com o token de ~/.local/state/jangada/painel-chave na URL.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

cache="$JANGADA_ESTADO/painel"
# O token que o app cobra na URL. A pasta fica oculta no jangada-isolar: o
# agente isolado alcança a porta, mas não sabe o token.
chave="$JANGADA_ESTADO/painel-chave/token"
pidf="$cache/app.pid"
errof="$cache/erro.txt"
marca="$cache/atualizando"
log="$cache/app.log"
url="http://127.0.0.1:$JANGADA_PAINEL_PORTA"
app_dir="$JANGADA_PATH/default/painel"
# Pacotes R do app. O install/ só confere; não instala pacote R.
pacotes_r=(shiny bslib bsicons plotly visNetwork igraph DT arrow jsonlite htmltools)

avisar_barra() { pkill -RTMIN+9 -x waybar 2>/dev/null || true; }

erro() {
  mkdir -p "$cache"
  printf '%s\n' "$1" >"$errof"
  echo "jangada-painel: $1" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send -a jangada-painel "Painel de indicadores" "$1" 2>/dev/null || true
  avisar_barra
  exit 1
}

no_ar() {
  local pid
  pid="$(cat "$pidf" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null \
    && tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q "jangada-painel-app"
}

gerar() {
  mkdir -p "$cache"
  command -v python3 >/dev/null 2>&1 || erro "python3 não instalado"
  python3 -c 'import pyarrow' 2>/dev/null || erro "falta o pyarrow do Python (pacote python-pyarrow)"
  # Uma coleta por vez; um segundo clique espera a primeira terminar. A trava
  # fica presa até o app subir: solta antes, o segundo clique sobe outro R
  # antes de o primeiro gravar o PID, e sobra um app órfão que o --parar não vê.
  exec 8>"$cache/.trava"
  flock -w 120 8 || erro "outra coleta não terminou em 2 minutos"
  # Coleta interrompida não deixa a barra presa em "atualizando".
  trap 'rm -f "$marca"; avisar_barra' EXIT
  : >"$marca"; avisar_barra
  local rc=0
  JANGADA_PAINEL_RETENCAO="${JANGADA_PAINEL_RETENCAO:-}" \
    python3 "$app_dir/coletor.py" "$cache" >"$cache/coleta.log" 2>&1 || rc=$?
  rm -f "$marca"
  ((rc == 0)) || erro "a coleta falhou: $(tail -n 3 "$cache/coleta.log" | tr '\n' ' ')"
  rm -f "$errof"
  avisar_barra
}

# Gera o token uma vez; a aba aberta continua valendo quando o app reinicia.
preparar_chave() {
  (umask 077; mkdir -p "${chave%/*}")
  chmod 700 "${chave%/*}"
  if [[ ! -s "$chave" ]]; then
    (umask 077; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$chave.tmp" && mv "$chave.tmp" "$chave") \
      || erro "não foi possível gravar o token em $chave"
  fi
}

subir() {
  mkdir -p "$cache"
  command -v Rscript >/dev/null 2>&1 || erro "R não instalado (pacote r)"
  preparar_chave
  rm -f "$errof"
  # O "jangada-painel-app" no comando identifica o processo no --parar.
  # shellcheck disable=SC2016  # código R
  setsid -f Rscript -e '
    invisible("jangada-painel-app")
    a <- commandArgs(trailingOnly = TRUE)
    p <- strsplit(a[[4]], " ")[[1]]
    faltam <- p[!vapply(p, requireNamespace, logical(1), quietly = TRUE)]
    if (length(faltam)) {
      writeLines(paste("faltam pacotes R:", paste(faltam, collapse = ", ")), a[[3]])
      quit(status = 2)
    }
    writeLines(as.character(Sys.getpid()), a[[5]])
    options(jangada.painel.cache = a[[2]], jangada.painel.chave = a[[7]])
    shiny::runApp(a[[1]], host = "127.0.0.1", port = as.integer(a[[6]]), launch.browser = FALSE)
  ' "$app_dir" "$cache" "$errof" "${pacotes_r[*]}" "$pidf" "$JANGADA_PAINEL_PORTA" "$chave" \
    </dev/null >"$log" 2>&1 8>&-
  local i
  for ((i = 0; i < 100; i++)); do
    [[ -s "$errof" ]] && erro "$(cat "$errof")"
    # A página passa do tamanho do cano: com grep -q, o grep sai no título e
    # o curl falha ao escrever o resto, o que o pipefail conta como falha.
    if [[ "$(curl -s --max-time 1 "$url" 2>/dev/null)" == *"Indicadores do jangada"* ]]; then
      avisar_barra
      return 0
    fi
    sleep 0.2
  done
  erro "o app não respondeu em $url; veja $log"
}

abrir() {
  # Com o app já aberto numa aba, foca a janela em vez de abrir outra.
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    local end
    end="$(hyprctl clients -j 2>/dev/null \
      | jq -r 'first(.[] | select((.title // "") | test("Indicadores do jangada")) | .address) // empty' 2>/dev/null || true)"
    if [[ -n "$end" ]]; then
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$end\" })" >/dev/null 2>&1 || true
      return 0
    fi
  fi
  preparar_chave
  local endereco
  endereco="$url/?token=$(cat "$chave")"
  setsid -f xdg-open "$endereco" >/dev/null 2>&1 || echo "abra $endereco"
}

parar() {
  if no_ar; then
    kill "$(cat "$pidf")" 2>/dev/null || true
    echo "painel encerrado"
  else
    echo "o painel não estava no ar"
  fi
  rm -f "$pidf"
  avisar_barra
}

conferir() {
  local faltam=()
  python3 -c 'import pyarrow' 2>/dev/null || faltam+=("pyarrow do Python (pacote python-pyarrow)")
  if command -v Rscript >/dev/null 2>&1; then
    local r
    # shellcheck disable=SC2016  # código R
    r="$(Rscript -e 'p <- commandArgs(TRUE); cat(p[!vapply(p, requireNamespace, logical(1), quietly = TRUE)])' \
      "${pacotes_r[@]}" 2>/dev/null)" || r="${pacotes_r[*]}"
    [[ -z "$r" ]] || faltam+=("pacotes R: $r")
  else
    faltam+=("R (pacote r)")
  fi
  ((${#faltam[@]} == 0)) && return 0
  printf 'falta %s\n' "${faltam[@]}"
  return 1
}

hm() { printf '%dh%02d' "$(($1 / 3600))" "$(($1 % 3600 / 60))"; }
curto() {
  awk -v n="$1" 'BEGIN {
    if (n >= 1e6) printf "%.1fM", n / 1e6
    else if (n >= 1e3) printf "%.0fk", n / 1e3
    else printf "%d", n }'
}

waybar() {
  local classe="parado" texto="󰄪" dica
  no_ar && classe="no-ar"
  if [[ -e "$marca" ]]; then
    printf '{"text": "󰑓", "tooltip": "Indicadores: atualizando", "class": "atualizando"}\n'
    return 0
  fi
  if [[ -s "$errof" ]]; then
    jq -cn --arg t "$texto" --arg d "Indicadores: $(cat "$errof")" '{text: $t, tooltip: $d, class: "erro"}'
    return 0
  fi
  if [[ -s "$cache/hoje.json" ]]; then
    local ap saida esp
    IFS=$'\t' read -r ap saida esp < <(jq -r '[(.aprovacao_1a_rodada // "-"), .tokens.saida, .aguardando_segundos] | @tsv' "$cache/hoje.json")
    dica="Indicadores de hoje"
    dica+=$'\n'"aprovação na 1ª rodada: ${ap}$([[ "$ap" == - ]] || echo %)"
    dica+=$'\n'"tokens de saída: $(curto "$saida")"
    dica+=$'\n'"tempo em aguardando: $(hm "$esp")"
  else
    dica="Indicadores: clique para gerar"
  fi
  dica+=$'\n'"(clique: abrir; botão direito: encerrar o app)"
  jq -cn --arg t "$texto" --arg d "$dica" --arg c "$classe" '{text: $t, tooltip: $d, class: $c}'
}

case "${1:-}" in
  "")
    gerar
    no_ar || subir
    # Solta antes de abrir: o navegador aberto pelo xdg-open herdaria a trava.
    exec 8>&-
    abrir
    ;;
  --gerar) gerar; cat "$cache/coleta.json"; echo ;;
  --json) gerar; cat "$cache/hoje.json"; echo ;;
  --parar) parar ;;
  --waybar) waybar ;;
  --conferir) conferir ;;
  -h|--ajuda|--help) sed -n '2,16s/^# \{0,1\}//p' "$0" ;;
  *) echo "jangada-painel: opção desconhecida: $1 (veja --ajuda)" >&2; exit 1 ;;
esac
