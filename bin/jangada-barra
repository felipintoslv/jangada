#!/usr/bin/env bash
# Inicia (ou reinicia) a waybar com a configuração do jangada.
#
# Uso:
#   jangada-barra                     sobe a barra na borda gravada
#   jangada-barra --posicao BORDA     grava a borda e sobe a barra
#   jangada-barra --posicao ciclo     passa para a próxima borda
#   jangada-barra --posicao           mostra a borda em uso
#
# Bordas: topo, base, esquerda, direita. A escolha fica em
# JANGADA_BARRA_POSICAO, no ~/.config/jangada/jangada.conf.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

cfg="$JANGADA_CONFIG/waybar/config.jsonc"
[[ -f "$cfg" ]] || cfg="$JANGADA_PATH/default/waybar/config.jsonc"
estilo="$JANGADA_CONFIG/waybar/style.css"
# Configuração gerada a cada partida: só a borda e o que ela muda. O resto vem
# do "include", que aponta o config.jsonc em uso.
gerado="$JANGADA_ESTADO/waybar/borda.jsonc"

# Ordem do ciclo, no sentido horário a partir do topo.
bordas=(topo direita base esquerda)

erro() { printf 'jangada-barra: %s\n' "$*" >&2; }

ajuda() { sed -n '2,12s/^# \{0,1\}//p' "$0"; }

# Nome da borda em "position" da waybar.
posicao_waybar() {
  case "$1" in
    topo) printf 'top\n' ;;
    base) printf 'bottom\n' ;;
    esquerda) printf 'left\n' ;;
    direita) printf 'right\n' ;;
    *) return 1 ;;
  esac
}

em_pe() { [[ "$1" == esquerda || "$1" == direita ]]; }

proxima_borda() {
  local atual="$1" i
  for i in "${!bordas[@]}"; do
    if [[ "${bordas[i]}" == "$atual" ]]; then
      printf '%s\n' "${bordas[(i + 1) % ${#bordas[@]}]}"
      return 0
    fi
  done
  printf '%s\n' "${bordas[0]}"
}

# Grava a escolha no arquivo do usuário. Sem arquivo, a borda vale só para
# esta partida: o jangada-barra não cria ~/.config/jangada/jangada.conf, que é
# trabalho da etapa 40 da instalação.
gravar_borda() {
  local valor="$1" conf="$JANGADA_CONFIG/jangada.conf"
  [[ -f "$conf" ]] || { erro "sem $conf; a borda vale só até a barra reiniciar"; return 0; }
  if grep -q '^JANGADA_BARRA_POSICAO=' "$conf"; then
    sed -i "s|^JANGADA_BARRA_POSICAO=.*|JANGADA_BARRA_POSICAO=$valor|" "$conf"
  else
    printf 'JANGADA_BARRA_POSICAO=%s\n' "$valor" >>"$conf"
  fi
}

# Escreve a configuração gerada. A waybar fica com a chave do arquivo que
# inclui quando ela aparece dos dois lados (waybar(5), "include"), então aqui
# entra só o que muda com a borda.
gerar_config() {
  local borda="$1" posicao
  posicao="$(posicao_waybar "$borda")"
  mkdir -p "$(dirname "$gerado")"
  {
    cat <<CABECALHO
// Gerado pelo jangada-barra a cada partida da barra. Não edite: o arquivo é
// reescrito. A configuração de verdade é a do include.
{
  "position": "$posicao",
CABECALHO
    if em_pe "$borda"; then
      cat <<'EM_PE'
  // Barra em pé. A largura de 32px (8 unidades da escala de base.css) não
  // comporta texto, então os módulos que mostram número trocam para o ícone
  // sozinho, o relógio quebra em duas linhas e o título da janela sai. O
  // "height": 0 desfaz a altura fixa do config.jsonc, que deixaria a barra
  // com 28px de comprimento. O "name" vira classe CSS: base.css usa
  // window#waybar.vertical para trocar o eixo da folga interna.
  "name": "vertical",
  "width": 32,
  "height": 0,
  "modules-left": ["hyprland/workspaces", "custom/agentes"],
  "clock": { "format": "{:%H\n%M}" },
  "cpu": { "format": "" },
  "memory": { "format": "" },
  "temperature": { "format": "", "format-critical": "󰈸" },
  "network": { "format-wifi": "󰤨", "format-ethernet": "󰈀" },
  "bluetooth": { "format-connected": "󰂱" },
  "pulseaudio": { "format": "{icon}" },
  "pulseaudio#microfone": { "format-source": "" },
  "battery": { "format": "{icon}" },
  "mpris": { "format": "{player_icon}", "format-paused": "{status_icon}" },
  // O texto do módulo de agentes vem do jangada-agentes, não do formato, e
  // não cabe em 32px: fica deitado, lido de baixo para cima.
  "custom/agentes": { "rotate": 90 },
  "tray": { "spacing": 4 },
EM_PE
    fi
    cat <<RODAPE
  "include": ["$cfg"]
}
RODAPE
  } >"$gerado"
}

case "${1:-}" in
  -h | --ajuda)
    ajuda
    exit 0
    ;;
  --posicao)
    escolha="${2:-}"
    if [[ -z "$escolha" ]]; then
      printf '%s\n' "$JANGADA_BARRA_POSICAO"
      exit 0
    fi
    if [[ "$escolha" == ciclo ]]; then
      escolha="$(proxima_borda "$JANGADA_BARRA_POSICAO")"
    fi
    if ! posicao_waybar "$escolha" >/dev/null; then
      erro "borda desconhecida: $escolha (use ${bordas[*]} ou ciclo)"
      exit 1
    fi
    gravar_borda "$escolha"
    JANGADA_BARRA_POSICAO="$escolha"
    ;;
  "") ;;
  *)
    erro "argumento desconhecido: $1"
    ajuda >&2
    exit 1
    ;;
esac

if ! posicao_waybar "$JANGADA_BARRA_POSICAO" >/dev/null; then
  erro "JANGADA_BARRA_POSICAO=$JANGADA_BARRA_POSICAO não é uma borda; usando topo"
  JANGADA_BARRA_POSICAO=topo
fi
gerar_config "$JANGADA_BARRA_POSICAO"

# A barra antiga sai antes de a nova subir. Sem waybar no ar, o pkill sai com
# 1 e não há o que esperar.
if pkill -x waybar 2>/dev/null; then
  sleep 0.3
fi
if [[ -f "$estilo" ]]; then
  exec waybar -c "$gerado" -s "$estilo"
else
  exec waybar -c "$gerado"
fi
