#!/usr/bin/env bash
# Gerencia conexões de rede (cabeada Ethernet e Wi-Fi) via nmcli e fuzzel.
#
# Uso:
#   jangada-rede [menu|status|wifi|cabo|editor]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

menu_fuzzel() {
  jangada_fuzzel --prompt "${1:-rede} > "
}

obter_cabeada() {
  local dev con ip
  nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null | while IFS=: read -r dev tipo estado con; do
    [[ "$tipo" == "ethernet" ]] || continue
    ip="$(nmcli -g IP4.ADDRESS device show "$dev" 2>/dev/null | head -1 || true)"
    if [[ "$estado" == "connected" ]]; then
      printf '✔  󰈀  Cabo: %s [%s] (%s)\n' "${con:-conectado}" "$dev" "${ip:-sem IP}"
      printf '   󰈂  Desconectar cabo [%s]\n' "$dev"
    else
      printf '   󰈀  Conectar cabo [%s]\n' "$dev"
    fi
  done
}

obter_wifi() {
  command -v nmcli >/dev/null 2>&1 || return 0
  if ! nmcli radio wifi 2>/dev/null | grep -qi "enabled"; then
    printf '   󰤮  Wi-Fi desativado (Clique para ativar)\n'
    return 0
  fi

  if ! nmcli -t -f TYPE device 2>/dev/null | grep -q "^wifi$"; then
    return 0
  fi

  # Escaneia redes disponíveis
  local redes
  redes="$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list 2>/dev/null | awk -F: '
    $2 != "" {
      in_use = ($1 == "*") ? "✔ " : "  "
      sec = ($4 != "") ? "🔒" : "🔓"
      printf "%s 󰤨  Wi-Fi: %s (%s%% · %s)\n", in_use, $2, $3, sec
    }
  ' | head -15 || true)"

  if [[ -n "$redes" ]]; then
    printf '%s\n' "$redes"
    printf '   󰤮  Desativar Wi-Fi\n'
  else
    printf '   󰤨  Nenhuma rede Wi-Fi ao alcance\n'
    printf '   󰤮  Desativar Wi-Fi\n'
  fi
}

# Tipo de chave da rede, pelo campo SECURITY da busca: wpa-psk para WPA1 e
# WPA2 (inclusive a transição WPA2/WPA3), sae para WPA3 puro. Devolve vazio
# para WEP e 802.1X, que pedem mais do que uma senha e ficam para o editor.
tipo_chave_wifi() {
  local ssid="$1" linha sec nome
  while IFS= read -r linha; do
    sec="${linha%%:*}"
    nome="${linha#*:}"
    # No modo -t, o nmcli escapa ":" e "\" dentro dos valores.
    nome="${nome//\\:/:}"
    nome="${nome//\\\\/\\}"
    [[ "$nome" == "$ssid" ]] || continue
    case "$sec" in
      *802.1X*|*WEP*) return 0 ;;
      *WPA1*|*WPA2*) echo wpa-psk; return 0 ;;
      *WPA3*) echo sae; return 0 ;;
    esac
  done < <(nmcli -t -f SECURITY,SSID device wifi list 2>/dev/null || true)
  echo wpa-psk
}

# UUID do perfil Wi-Fi com o nome dado, se houver. Perfis de outro tipo com
# o mesmo nome (VPN, cabo) são ignorados.
uuid_perfil_wifi() {
  nmcli -g connection.type,connection.uuid connection show id "$1" 2>/dev/null |
    sed -n 's/^802-11-wireless://p' | head -1 || true
}

conectar_wifi() {
  local ssid="$1" senha="" chave="" uuid=""
  notify-send -a jangada -u low "Rede" "Conectando a $ssid..." 2>/dev/null || true
  
  if nmcli -s device wifi connect "$ssid" >/dev/null 2>&1; then
    notify-send -a jangada -u low "Rede" "Conectado com sucesso a $ssid" 2>/dev/null || true
    return 0
  fi

  senha="$(jangada_fuzzel --password --prompt "senha para $ssid > " || true)"
  [[ -n "$senha" ]] || return 0

  # A senha não vai na linha de comando do nmcli, onde ficaria em
  # /proc/PID/cmdline, legível por qualquer processo do usuário. O perfil é
  # criado sem ela e a ativação a recebe pelo passwd-file, lido de um
  # descritor alimentado pelo printf, que é embutido no bash e não cria
  # processo com a senha nos argumentos. O NetworkManager guarda no perfil a
  # senha recebida, como faz com a digitada no applet.
  uuid="$(uuid_perfil_wifi "$ssid")"
  if [[ -z "$uuid" ]]; then
    chave="$(tipo_chave_wifi "$ssid")"
    if [[ -z "$chave" ]]; then
      notify-send -a jangada -u critical "Rede" "$ssid usa WEP ou 802.1X: configure pelo editor de rede" 2>/dev/null || true
      return 0
    fi
    if ! nmcli connection add type wifi con-name "$ssid" ssid "$ssid" \
      wifi-sec.key-mgmt "$chave" >/dev/null 2>&1; then
      notify-send -a jangada -u critical "Rede" "Não foi possível criar o perfil de $ssid" 2>/dev/null || true
      return 0
    fi
    uuid="$(uuid_perfil_wifi "$ssid")"
  fi
  if [[ -z "$uuid" ]]; then
    notify-send -a jangada -u critical "Rede" "Perfil de $ssid não encontrado" 2>/dev/null || true
    return 0
  fi

  if nmcli connection up uuid "$uuid" passwd-file /dev/fd/3 \
    3< <(printf '802-11-wireless-security.psk:%s\n' "$senha") >/dev/null 2>&1; then
    notify-send -a jangada -u low "Rede" "Conectado a $ssid" 2>/dev/null || true
  else
    notify-send -a jangada -u critical "Rede" "Falha na autenticação com $ssid" 2>/dev/null || true
  fi
}

menu_rede() {
  local opcoes escolha
  opcoes=""

  local cabeada
  cabeada="$(obter_cabeada)"
  [[ -n "$cabeada" ]] && opcoes+="$cabeada"$'\n'

  local wifi
  wifi="$(obter_wifi)"
  [[ -n "$wifi" ]] && opcoes+="$wifi"$'\n'

  opcoes+="󰈀  Reiniciar conexões de rede"$'\n'
  if command -v nm-connection-editor >/dev/null 2>&1; then
    opcoes+="󰒓  Configurações de rede (Editor gráfico)"$'\n'
  fi
  if command -v nmtui >/dev/null 2>&1; then
    opcoes+="󰍹  Painel nmtui no terminal"
  fi

  escolha="$(menu_fuzzel "rede" <<<"$opcoes")" || return 0
  [[ -n "$escolha" ]] || return 0

  case "$escolha" in
    *"Desconectar cabo"*)
      local dev
      dev="$(grep -oP '\[\K[^]]+(?=\])' <<<"$escolha")"
      nmcli device disconnect "$dev" 2>/dev/null || true
      notify-send -a jangada -u low "Rede" "Interface cabeada $dev desconectada" 2>/dev/null || true
      ;;
    *"Conectar cabo"*)
      local dev
      dev="$(grep -oP '\[\K[^]]+(?=\])' <<<"$escolha")"
      nmcli device connect "$dev" 2>/dev/null || true
      notify-send -a jangada -u low "Rede" "Conectando interface cabeada $dev..." 2>/dev/null || true
      ;;
    *"Wi-Fi desativado (Clique para ativar)"*)
      nmcli radio wifi on 2>/dev/null || true
      notify-send -a jangada -u low "Rede" "Wi-Fi ativado" 2>/dev/null || true
      ;;
    *"Desativar Wi-Fi"*)
      nmcli radio wifi off 2>/dev/null || true
      notify-send -a jangada -u low "Rede" "Wi-Fi desativado" 2>/dev/null || true
      ;;
    *"Wi-Fi:"*)
      local ssid
      ssid="$(sed -E 's/^[✔ ]* 󰤨  Wi-Fi: //; s/ \(.*//' <<<"$escolha")"
      conectar_wifi "$ssid"
      ;;
    *"Reiniciar conexões"*)
      notify-send -a jangada -u low "Rede" "Reiniciando serviços de rede..." 2>/dev/null || true
      nmcli networking off && sleep 1 && nmcli networking on
      notify-send -a jangada -u low "Rede" "Rede reiniciada" 2>/dev/null || true
      ;;
    *"Editor gráfico"*)
      setsid -f nm-connection-editor >/dev/null 2>&1
      ;;
    *"Painel nmtui"*)
      setsid -f "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.rede --titulo "Gerenciador de Rede" -e nmtui >/dev/null 2>&1
      ;;
  esac
}

case "${1:-menu}" in
  -h|--ajuda)
    sed -n '2,6s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  editor)
    setsid -f nm-connection-editor >/dev/null 2>&1
    ;;
  tui|nmtui)
    exec "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.rede --titulo "Gerenciador de Rede" -e nmtui
    ;;
  menu|*)
    menu_rede
    ;;
esac
