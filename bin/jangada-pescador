#!/usr/bin/env bash
# Atalho para conversa-de-pescador no padrão de comandos jangada-*.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

dir_raiz="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
cmd="$dir_raiz/conversa-de-pescador"
[[ -x "$cmd" ]] || cmd="$JANGADA_PATH/bin/conversa-de-pescador"

case "${1:-}" in
  --janela)
    jangada_focar_classe org.jangada.pescador && exit 0
    exec setsid -f "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.pescador \
      --titulo "Conversa de Pescador" -e "$cmd" >/dev/null 2>&1
    ;;
  --historico-janela)
    jangada_focar_classe org.jangada.pescador.historico && exit 0
    exec setsid -f "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.pescador.historico \
      --titulo "Repositório de Pesquisas - Conversa de Pescador" -e "$cmd" --historico >/dev/null 2>&1
    ;;
  *)
    exec "$cmd" "$@"
    ;;
esac
