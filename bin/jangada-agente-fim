#!/usr/bin/env bash
# Encerra uma sessão de agente e remove o worktree, conferindo alterações pendentes.
# O ramo agente/<nome> é mantido; apague-o com git branch -d quando quiser.
# Com --integrar, antes mescla o ramo na base (merge --no-ff no repositório
# principal) e, depois da limpeza, apaga o ramo já integrado.
#
# Uso: jangada-agente-fim [--integrar] SESSAO
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

integrar=0; s=""
while (($#)); do
  case "$1" in
    -h|--ajuda) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --integrar) integrar=1; shift ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) [[ -z "$s" ]] || { echo "sessão repetida: $1" >&2; exit 1; }; s="$1"; shift ;;
  esac
done
[[ -n "$s" ]] || { echo "informe a sessão (veja jangada-agentes --lista)" >&2; exit 1; }
arq="$JANGADA_ESTADO/agentes/$s.json"

# Sem arquivo de estado e sem sessão no tmux não há o que encerrar. Sem esta
# conferência um nome errado terminava em "sessão encerrada" sem ter feito nada.
if [[ ! -f "$arq" ]] && ! "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
  echo "sessão não encontrada: $s (veja jangada-agentes --lista)" >&2
  exit 1
fi

worktree=""; ramo=""; base=""; raiz=""; estado=""
if [[ -f "$arq" ]]; then
  worktree="$(jq -r '.worktree // ""' "$arq")"
  ramo="$(jq -r '.ramo // ""' "$arq")"
  base="$(jq -r '.base // ""' "$arq")"
  raiz="$(jq -r '.raiz // ""' "$arq")"
  estado="$(jq -r '.estado // ""' "$arq")"
fi

# Ciclo que já terminou fica no painel depois de o processo sair, então o pid
# do arquivo pode ter sido reaproveitado pelo sistema. Nesse caso encerrar a
# sessão é só arrumar a lista, e matar o pid mataria um processo alheio.
matar_pid=1
case "$estado" in
  concluido|aguardando) matar_pid=0 ;;
esac

confirmar() {
  local r
  read -r -p "$1 [s/N] " r
  [[ "${r,,}" == s* ]]
}

# Integração: as mesmas conferências da função concluir do shell, feitas antes
# de qualquer limpeza. Se o merge falhar, nada é removido.
atualizar_copia_instalada() {
  local r="$1"
  [[ -d "$JANGADA_PATH/.git" ]] || return 0

  local raiz_real caminho_real
  raiz_real="$(realpath "$r" 2>/dev/null || printf '%s' "$r")"
  caminho_real="$(realpath "$JANGADA_PATH" 2>/dev/null || printf '%s' "$JANGADA_PATH")"
  [[ "$raiz_real" != "$caminho_real" ]] || return 0

  local e_repo=0
  if [[ -n "${JANGADA_REPO:-}" && -d "$JANGADA_REPO" ]]; then
    local repo_real
    repo_real="$(realpath "$JANGADA_REPO" 2>/dev/null || true)"
    [[ -n "$repo_real" && "$raiz_real" == "$repo_real" ]] && e_repo=1
  fi

  local origem
  origem="$(git -C "$JANGADA_PATH" config --get remote.origin.url 2>/dev/null || true)"
  if [[ "$origem" == /* && -d "$origem/.git" ]]; then
    local origem_real
    origem_real="$(realpath "$origem" 2>/dev/null || true)"
    [[ -n "$origem_real" && "$raiz_real" == "$origem_real" ]] && e_repo=1
  fi

  if ((e_repo)); then
    local ramo_instalado
    ramo_instalado="$(git -C "$JANGADA_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -n "$base" && "$ramo_instalado" != "$base" ]]; then
      echo "cópia instalada ($JANGADA_PATH) está em '$ramo_instalado', não em '$base'; git pull não executado" >&2
      return 0
    fi
    if [[ -z "$(git -C "$JANGADA_PATH" status --porcelain 2>/dev/null)" ]]; then
      echo "atualizando a cópia instalada em $JANGADA_PATH..."
      git -C "$JANGADA_PATH" pull --ff-only || echo "!! não foi possível atualizar $JANGADA_PATH" >&2
    else
      echo "!! cópia instalada ($JANGADA_PATH) tem alterações locais; git pull não executado" >&2
    fi
  fi
}

integrado=0
apagar_ramo=0
if ((integrar)); then
  if [[ -z "$ramo" || -z "$base" || -z "$raiz" ]]; then
    echo "a sessão $s não tem ramo próprio (trabalho direto no repositório); nada a integrar"
    [[ -n "$raiz" ]] && atualizar_copia_instalada "$raiz"
  else
    if [[ -n "$worktree" && -d "$worktree" && -n "$(git -C "$worktree" status --porcelain)" ]]; then
      echo "alterações não salvas em commit no worktree $worktree:" >&2
      git -C "$worktree" status --short | head -20 >&2
      echo "faça commit delas (ou descarte) antes de integrar" >&2
      exit 1
    fi
    atual="$(git -C "$raiz" rev-parse --abbrev-ref HEAD)"
    if [[ "$atual" != "$base" ]]; then
      echo "o repositório principal ($raiz) está em '$atual', não em '$base'; troque para $base e rode de novo" >&2
      exit 1
    fi
    # O git já recusa o merge com alteração no índice ou em arquivo que o ramo
    # toca; esta conferência diz o motivo antes, e cobre o arquivo alterado que o
    # merge deixaria passar e que depois ninguém sabe se veio do ramo ou não.
    if [[ -n "$(git -C "$raiz" status --porcelain --untracked-files=no)" ]]; then
      echo "o repositório principal ($raiz) tem alterações sem commit:" >&2
      git -C "$raiz" status --short --untracked-files=no | head -20 >&2
      echo "faça commit delas (ou guarde com git stash) antes de integrar" >&2
      exit 1
    fi
    novos="$(git -C "$raiz" log --oneline "$base..$ramo" 2>/dev/null || true)"
    if [[ -z "$novos" ]]; then
      echo "o ramo $ramo não tem commits além de $base; nada a integrar"
    else
      echo "commits de $ramo a integrar em $base ($raiz):"
      printf '%s\n' "$novos" | head -30
      confirmar "mesclar e encerrar a sessão?" || { echo "nada foi feito"; exit 1; }
      if ! git -C "$raiz" merge --no-ff -m "Integra $ramo" "$ramo"; then
        echo "o merge falhou; resolva em $raiz (git merge --abort desfaz). A sessão foi mantida." >&2
        exit 1
      fi
      echo "integrado em $base"
      integrado=1
      atualizar_copia_instalada "$raiz"
    fi
    apagar_ramo=1
  fi
fi

forcar=0
if [[ -n "$worktree" && -d "$worktree" ]]; then
  pendentes="$(git -C "$worktree" status --porcelain)"
  if [[ -n "$pendentes" ]]; then
    echo "alterações não salvas em commit no worktree $worktree:"
    printf '%s\n' "$pendentes" | head -20
    confirmar "descartar essas alterações e remover o worktree?" || { echo "nada foi feito"; exit 1; }
    forcar=1
  fi
  if ((!integrar)) && [[ -n "$base" && -n "$ramo" ]]; then
    novos="$(git -C "$raiz" log --oneline "$base..$ramo" 2>/dev/null || true)"
    if [[ -n "$novos" ]]; then
      echo "commits no ramo $ramo que não estão em $base (continuarão no ramo):"
      printf '%s\n' "$novos" | head -20
    fi
  fi
fi

# A limpeza encerra a sessão, remove o worktree e apaga o estado, nessa ordem:
# o agente para antes de a pasta dele sumir. Quando o comando é chamado de
# dentro da própria sessão, encerrar a sessão mataria este script no meio;
# nesse caso a limpeza continua num processo separado, com registro em arquivo.
limpar() {
  local pid
  pid="$(jq -r '.pid // empty' "$arq" 2>/dev/null || true)"
  if ((matar_pid)) && [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
  fi
  "${JANGADA_TMUX[@]}" kill-session -t "=$s" 2>/dev/null || true
  if [[ -n "$worktree" && -d "$worktree" ]]; then
    if ((forcar)); then
      git -C "$raiz" worktree remove --force "$worktree"
    else
      git -C "$raiz" worktree remove "$worktree"
    fi
    echo "worktree removido: $worktree"
  fi
  if ((apagar_ramo)); then
    # -d, não -D: o git só apaga se o ramo estiver mesclado, o que confere a
    # integração feita acima.
    git -C "$raiz" branch -d "$ramo" && echo "ramo apagado: $ramo"
  elif [[ -n "$ramo" && -n "$worktree" ]]; then
    echo "ramo mantido: $ramo (apague com: git -C $raiz branch -d $ramo)"
  fi
  rm -f "$arq"
  # Os pareceres do jangada-validar contam as rodadas: uma sessão nova com o
  # mesmo nome começa da primeira.
  rm -f "$JANGADA_ESTADO/agentes/validacao-$s-r"*.md "$JANGADA_ESTADO/agentes/prompt-$s.md"
  echo "sessão encerrada: $s"
  "$JANGADA_PATH/bin/jangada-gancho" pos-agente-fim "$s" "$raiz" "$integrado"
}

if [[ "${JANGADA_SESSAO:-}" == "$s" ]]; then
  registro="$JANGADA_ESTADO/agentes/fim-$s.log"
  echo "encerrando a partir da própria sessão; registro em $registro"
  export s worktree ramo raiz arq forcar matar_pid apagar_ramo integrado
  export -f limpar
  # shellcheck disable=SC1090,SC2016
  setsid -f bash -c 'sleep 0.5; source "$1"; limpar' _ "$JANGADA_PATH/bin/jangada-config" >"$registro" 2>&1
  exit 0
fi

limpar
