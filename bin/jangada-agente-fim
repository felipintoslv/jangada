#!/usr/bin/env bash
# Encerra uma sessão de agente e remove o worktree, conferindo alterações pendentes.
# O ramo agente/<nome> é mantido; apague-o com git branch -d quando quiser.
# Na baseline 2026-10, --integrar recusa publicação automática e mantém a sessão.
# A revisão continua disponível pelo jangada-validar. A integração é manual.
# Uso: jangada-agente-fim [--integrar [--sem-revisao]] SESSAO
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

integrar=0; sem_revisao=0; s=""; gui_base=""; gui_candidato=""
while (($#)); do
  case "$1" in
    -h|--ajuda) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --integrar) integrar=1; shift ;;
    --confirmacao) gui_base="${2:-}"; gui_candidato="${3:-}"; shift 3 ;;
    --sem-revisao) sem_revisao=1; shift ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) [[ -z "$s" ]] || { echo "sessão repetida: $1" >&2; exit 1; }; s="$1"; shift ;;
  esac
done
if [[ -n "$gui_base$gui_candidato" ]]; then
  [[ "$gui_base" =~ ^[0-9a-f]{40}$ && "$gui_candidato" =~ ^[0-9a-f]{40}$ ]] \
    && ((integrar && !sem_revisao)) || { echo "confirmação gráfica exige --integrar, dois SHA completos e revisão" >&2; exit 1; }
fi
[[ -n "$s" ]] || { echo "informe a sessão (veja jangada-agentes --lista)" >&2; exit 1; }
[[ "$s" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "nome de sessão inválido: $s" >&2; exit 1; }
arq="$JANGADA_ESTADO/agentes/$s.json"

# Sem arquivo de estado e sem sessão no tmux não há o que encerrar. Sem esta
# conferência um nome errado terminava em "sessão encerrada" sem ter feito nada.
if [[ ! -f "$arq" ]] && ! "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
  echo "sessão não encontrada: $s (veja jangada-agentes --lista)" >&2
  exit 1
fi

worktree=""; ramo=""; base=""; raiz=""
if [[ -f "$arq" ]]; then
  worktree="$(jq -r '.worktree // "" | tostring' "$arq" 2>/dev/null)" || worktree=$'\n'
  ramo="$(jq -r '.ramo // "" | tostring' "$arq" 2>/dev/null)" || ramo=$'\n'
  base="$(jq -r '.base // "" | tostring' "$arq" 2>/dev/null)" || base=$'\n'
  raiz="$(jq -r '.raiz // "" | tostring' "$arq" 2>/dev/null)" || raiz=$'\n'
fi

# O arquivo de estado fica na pasta agentes/, gravável de dentro do
# jangada-isolar, e o que vem dele decide o merge, a remoção do worktree e o
# branch -d feitos aqui fora do isolamento. Por isso nada é usado sem
# conferência, e estado que não passa é recusado sem alterar nada:
# - o pid não é lido: nenhum script grava mais, e matar um número vindo do
#   estado encerraria qualquer processo do usuário;
# - ramo e worktree vêm juntos, no formato que o jangada-agente cria:
#   agente/NOME e $JANGADA_WORKTREES/REPO/NOME, sem link simbólico no caminho;
# - com o worktree no disco, ele precisa estar registrado no repositório da
#   raiz e os dois precisam ter o mesmo diretório git comum; sem ele, a raiz
#   precisa ser a raiz de um repositório com o nome que deu REPO;
# - a base precisa ser um nome de ramo válido que não comece com "-", para
#   não virar opção do git log.
recusar() {
  echo "estado inválido em $arq: $1" >&2
  echo "nada foi feito; confira o arquivo (ele é gravável pelo agente isolado)" >&2
  exit 1
}

# O mesmo slug do jangada-agente, que dá o nome da pasta do repositório.
slug() {
  { iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null <<<"$1" || printf '%s\n' "$1"; } \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -E -e 's/[^a-z0-9_-]+/-/g' -e 's/^-+//' -e 's/-+$//'
}

# Caminho absoluto e canônico do diretório git comum de $1, ou nada.
dir_comum() {
  local d
  d="$(jangada_git_seguro -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  realpath -e -- "$d" 2>/dev/null
}

conferir_estado() {
  local c
  for c in "$worktree" "$ramo" "$base" "$raiz"; do
    [[ "$c" != *[[:cntrl:]]* ]] || recusar "campo com caractere de controle"
  done
  [[ -z "$raiz" || "$raiz" == /* ]] || recusar "raiz não é caminho absoluto: $raiz"
  if [[ -z "$ramo" && -z "$worktree" ]]; then
    # Sessão direto no repositório: sem ramo, a base não serve para nada.
    base=""
    return 0
  fi
  [[ -n "$ramo" && -n "$worktree" && -n "$raiz" ]] \
    || recusar "ramo, worktree e raiz precisam vir juntos"
  [[ "$ramo" =~ ^agente/([a-z0-9_][a-z0-9_-]*)$ ]] || recusar "ramo fora do padrão agente/NOME: $ramo"
  local nome="${BASH_REMATCH[1]}" resto repo wts real
  resto="${worktree#"$JANGADA_WORKTREES"/}"
  [[ "$resto" != "$worktree" && "$resto" =~ ^([a-z0-9_-]*)/([a-z0-9_-]+)$ && "${BASH_REMATCH[2]}" == "$nome" ]] \
    || recusar "worktree fora de $JANGADA_WORKTREES/REPO/${nome}: $worktree"
  repo="${BASH_REMATCH[1]}"
  wts="$(realpath -m -- "$JANGADA_WORKTREES")"
  real="$(realpath -m -- "$worktree")"
  [[ "$real" == "$wts/$repo/$nome" ]] || recusar "o caminho do worktree passa por link simbólico: $worktree"
  [[ "$real" != "$(realpath -m -- "$raiz")" ]] || recusar "worktree e raiz são a mesma pasta: $worktree"
  if [[ -n "$base" ]]; then
    [[ "$base" != -* ]] && git check-ref-format "refs/heads/$base" \
      || recusar "base não é nome de ramo: $base"
  fi

  local topo
  topo="$(jangada_git_seguro -C "$raiz" rev-parse --show-toplevel 2>/dev/null)" \
    || recusar "raiz não é repositório git: $raiz"
  [[ "$(realpath -m -- "$topo")" == "$(realpath -m -- "$raiz")" ]] \
    || recusar "raiz não é a raiz do repositório: $raiz"

  if [[ -e "$worktree" || -L "$worktree" ]]; then
    [[ -d "$worktree" && ! -L "$worktree" ]] || recusar "worktree não é pasta: $worktree"
    local comum_wt comum_raiz linha registrado=0
    comum_wt="$(dir_comum "$worktree")" || recusar "worktree sem repositório git: $worktree"
    comum_raiz="$(dir_comum "$raiz")" || recusar "raiz sem repositório git: $raiz"
    [[ "$comum_wt" == "$comum_raiz" ]] \
      || recusar "worktree ($comum_wt) e raiz ($comum_raiz) são de repositórios diferentes"
    while IFS= read -r -d '' linha; do
      [[ "$linha" == "worktree "* && "$(realpath -m -- "${linha#worktree }")" == "$real" ]] && registrado=1
    done < <(jangada_git_seguro -C "$raiz" worktree list --porcelain -z 2>/dev/null)
    ((registrado)) || recusar "$worktree não é worktree registrado em $raiz"
  else
    [[ "$(slug "$(basename "$raiz")")" == "$repo" ]] \
      || recusar "raiz ($raiz) não é o repositório do worktree $worktree"
  fi
}
conferir_estado

confirmar() {
  local r
  read -r -p "$1 [s/N] " r
  [[ "${r,,}" == s* ]]
}

# Integração: as mesmas conferências da função concluir do shell, feitas antes
# de qualquer limpeza. Se o merge falhar, nada é removido.
#
# O git roda aqui fora do isolamento sobre o worktree e o repositório do
# agente, cujo .git o agente pode alterar: todas as chamadas passam por
# jangada_git_seguro (sem fsmonitor nem ganchos), e o status ignora submódulos.
#
# A cópia instalada não é atualizada aqui: o que entrou no repositório de
# origem dela só chega pelo jangada-update, que mostra os commits e pede
# confirmação antes de rodar migrações com sudo.
avisar_copia_instalada() {
  local r="$1"
  [[ -d "$JANGADA_PATH/.git" ]] || return 0

  local raiz_real caminho_real
  raiz_real="$(realpath "$r" 2>/dev/null || printf '%s' "$r")"
  caminho_real="$(realpath "$JANGADA_PATH" 2>/dev/null || printf '%s' "$JANGADA_PATH")"
  [[ "$raiz_real" != "$caminho_real" ]] || return 0

  local e_repo=0
  if [[ -n "${JANGADA_REPO:-}" && -d "$JANGADA_REPO" ]]; then
    local repo_real
    repo_real="$(realpath "$JANGADA_REPO" 2>/dev/null || true)"
    [[ -n "$repo_real" && "$raiz_real" == "$repo_real" ]] && e_repo=1
  fi

  local origem
  origem="$(git config -f "$JANGADA_PATH/.git/config" --get remote.origin.url 2>/dev/null || true)"
  if [[ "$origem" == /* && -d "$origem/.git" ]]; then
    local origem_real
    origem_real="$(realpath "$origem" 2>/dev/null || true)"
    [[ -n "$origem_real" && "$raiz_real" == "$origem_real" ]] && e_repo=1
  fi

  if ((e_repo)); then
    echo "a cópia instalada ($JANGADA_PATH) não foi atualizada: rode jangada-update para conferir e aplicar o que entrou"
  fi
  return 0
}

# A trava coordena chamadas do Jangada, mas não impede editores ou Git externo.
# A baseline não publica no worktree principal nem tenta recuperar com reset.
mesclar_sob_trava() {
  echo "integração automática bloqueada na baseline 2026-10; use revisão e integração manual supervisionada. A sessão, o ramo e o worktree foram mantidos." >&2
  return 12
}

integrado=0
apagar_ramo=0
if ((integrar)); then
  if [[ -z "$ramo" || -z "$base" || -z "$raiz" ]]; then
    echo "a sessão $s não tem ramo próprio (trabalho direto no repositório); nada a integrar"
    [[ -n "$raiz" ]] && avisar_copia_instalada "$raiz"
    echo "integração automática bloqueada; sessão e evidências mantidas" >&2
    exit 1
  else
    trava="$JANGADA_ESTADO/revisoes/travas/$(dir_comum "$raiz" | sha256sum | cut -c1-16)"
    (umask 077; mkdir -p "$trava")
    rc=0
    jangada_com_trava_dir "$trava" mesclar_sob_trava || rc=$?
    ((rc == 12)) || echo "outra integração segura a trava deste repositório; nada foi mesclado" >&2
    exit 1
  fi
fi

forcar=0
if [[ -n "$worktree" && -d "$worktree" ]]; then
  pendentes="$(jangada_git_seguro -C "$worktree" status --porcelain --ignore-submodules=all | tr -d '\000-\010\013-\037\177')"
  if [[ -n "$pendentes" ]]; then
    echo "alterações não salvas em commit no worktree $worktree:"
    printf '%s\n' "$pendentes" | head -20
    confirmar "descartar essas alterações e remover o worktree?" || { echo "nada foi feito"; exit 1; }
    forcar=1
  fi
  if ((!integrar)) && [[ -n "$base" && -n "$ramo" ]]; then
    novos="$(jangada_git_seguro -C "$raiz" log --oneline "$base..$ramo" 2>/dev/null | tr -d '\000-\010\013-\037\177' || true)"
    if [[ -n "$novos" ]]; then
      echo "commits no ramo $ramo que não estão em $base (continuarão no ramo):"
      printf '%s\n' "$novos" | head -20
    fi
  fi
fi

assinar=0
if ((integrado)) && [[ -f "$JANGADA_CONFIG/allowed_signers" && "$raiz" -ef "${JANGADA_REPO:-}" ]]; then
  assinar=1
fi

# A limpeza encerra a sessão, remove o worktree e apaga o estado, nessa ordem:
# o agente para antes de a pasta dele sumir. Quando o comando é chamado de
# dentro da própria sessão, encerrar a sessão mataria este script no meio;
# nesse caso a limpeza continua num processo separado, com registro em arquivo.
limpar() {
  (umask 077; mkdir -p "$JANGADA_ESTADO/revisoes/travas/$s")
  local trava_revisoes
  exec {trava_revisoes}<"$JANGADA_ESTADO/revisoes/travas/$s"
  flock -w 15 "$trava_revisoes" || { echo "revisão ocupada; encerramento adiado" >&2; return 1; }
  # Parar o agente não apaga os documentos nem o trabalho produzido.
  "${JANGADA_TMUX[@]}" kill-session -t "=$s" 2>/dev/null || true
  # O histórico protegido é publicado e conferido antes de qualquer remoção.
  # Falha de leitura, integridade, espaço ou publicação mantém os originais.
  local arquivo_historico
  arquivo_historico="$(python3 "$JANGADA_PATH/default/orquestracao/confianca.py" arquivar "$JANGADA_ESTADO" "$s")" \
    || { echo "encerramento bloqueado: evidências originais mantidas" >&2; return 1; }
  echo "evidências preservadas: $arquivo_historico"
  if [[ -n "$worktree" && -d "$worktree" ]]; then
    if ((forcar)); then
      jangada_git_seguro -C "$raiz" worktree remove --force "$worktree"
    else
      jangada_git_seguro -C "$raiz" worktree remove "$worktree"
    fi
    echo "worktree removido: $worktree"
  fi
  [[ -n "$worktree" ]] && jangada_agy_ajustar_confianca remover "$worktree" || true
  if ((apagar_ramo)); then
    # -d, não -D: o git só apaga se o ramo estiver mesclado, o que confere a
    # integração feita acima.
    jangada_git_seguro -C "$raiz" branch -d "$ramo" && echo "ramo apagado: $ramo"
  elif [[ -n "$ramo" && -n "$worktree" ]]; then
    echo "ramo mantido: $ramo (apague com: git -C $raiz branch -d $ramo)"
  fi
  if jq -e '.execucao | strings | test("^exe-[0-9a-f]{16}$")' "$arq" >/dev/null 2>&1; then
    local resultado_sessao=()
    ((integrado)) && resultado_sessao+=(--integrada)
    "$JANGADA_PATH/bin/jangada-projeto" --projeto "$raiz" sessao-encerrar "$s" "${resultado_sessao[@]}" >/dev/null \
      || echo "aviso: execução da sessão ficou sem registro de encerramento" >&2
  fi
  rm -f "$arq"
  # Os pareceres do jangada-validar contam as rodadas: uma sessão nova com o
  # mesmo nome começa da primeira. Só -rN.md, para não levar os de proj--fix-rotas
  # junto com os de proj--fix.
  local parecer
  for parecer in "$JANGADA_ESTADO/agentes/validacao-$s-r"[0-9]*.md; do
    [[ "${parecer#"$JANGADA_ESTADO/agentes/validacao-$s-r"}" =~ ^[0-9]+\.md$ ]] && rm -f "$parecer"
  done
  rm -f "$JANGADA_ESTADO/agentes/validacao-$s.aprovado" "$JANGADA_ESTADO/agentes/prompt-$s.md" \
    "$JANGADA_ESTADO/agentes/protocolo-$s.md"
  # As revisões feitas fora, pelo mesmo motivo. Dentro do isolamento a pasta
  # é a vazia que o oculta, e nada sai do disco; a marca que sobra vale só
  # para o commit dela.
  for parecer in "$JANGADA_ESTADO/revisoes/validacao-$s-r"[0-9]*.md; do
    [[ "${parecer#"$JANGADA_ESTADO/revisoes/validacao-$s-r"}" =~ ^[0-9]+\.md$ ]] && rm -f "$parecer"
  done
  rm -f "$JANGADA_ESTADO/revisoes/validacao-$s.aprovado" "$JANGADA_ESTADO/revisoes/$s.json"
  echo "sessão encerrada: $s"
  # Só depois do branch -d: assinar reescreve os commits do ramo, e o git
  # deixaria de vê-lo como mesclado.
  if ((assinar)); then
    "$JANGADA_PATH/bin/jangada-assinar" "$raiz" \
      || echo "!! a integração ficou sem assinatura; rode jangada-assinar antes do push" >&2
  fi
  "$JANGADA_PATH/bin/jangada-gancho" pos-agente-fim "$s" "$raiz" "$integrado"
}

if [[ "${JANGADA_SESSAO:-}" == "$s" ]]; then
  registro="$JANGADA_ESTADO/agentes/fim-$s.log"
  echo "encerrando a partir da própria sessão; registro em $registro"
  # A limpeza em processo separado não tem terminal para a confirmação.
  if ((assinar)); then
    echo "!! a integração ficou sem assinatura; rode jangada-assinar num terminal comum antes do push" >&2
    assinar=0
  fi
  export s worktree ramo raiz arq forcar apagar_ramo integrado assinar
  export -f limpar
  if command -v setsid >/dev/null 2>&1; then
    # shellcheck disable=SC1090,SC2016
    setsid -f bash -c 'sleep 0.5; source "$1"; limpar' _ "$JANGADA_PATH/bin/jangada-config" >"$registro" 2>&1
  else
    # shellcheck disable=SC1090,SC2016
    nohup bash -c 'sleep 0.5; source "$1"; limpar' _ "$JANGADA_PATH/bin/jangada-config" >"$registro" 2>&1 &
  fi
  exit 0
fi

limpar
