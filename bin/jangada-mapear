#!/usr/bin/env bash
# Faz um inventário da configuração atual da máquina, sem alterar nada.
#
# Gera mapeamento/<máquina>-<data>/ com cópias das configurações relevantes
# (Hyprland, Noctalia, Quickshell, terminal, shell, agentes de IA), listas de
# pacotes, estado do Hyprland visto pelo hyprctl e um resumo em MAPA.md.
# Chaves, senhas e tokens são mascarados; arquivos de credenciais são ignorados.
#
# Uso: jangada-mapear [pasta-de-saida]
#      jangada-mapear --mascarar <entrada >saida
set -uo pipefail

# Expressões do sed (ERE) que mascaram valores sensíveis. A ordem importa:
# primeiro os blocos de chave privada, que somem inteiros; depois os formatos
# conhecidos de token, que valem em qualquer lugar da linha; por fim os pares
# nome e valor, com o valor entre aspas mascarado até a aspa final.
q="[\"']"
nome_segredo='(api[_-]?key|apikey|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret|secret|token|password|passwd|senha|bearer|authorization|credentials?)'
mascara_sed=(
  # Chave privada PEM ou PGP numa linha só (como no JSON de contas de serviço)
  # e em várias linhas.
  -e 's/-----BEGIN [A-Z0-9 ]*PRIVATE KEY[A-Z ]*-----.*-----END [A-Z0-9 ]*PRIVATE KEY[A-Z ]*-----/[chave privada removida]/g'
  -e '/-----BEGIN [A-Z0-9 ]*PRIVATE KEY[A-Z ]*-----/,/-----END [A-Z0-9 ]*PRIVATE KEY[A-Z ]*-----/c\[chave privada removida]'
  # Chaves e tokens com prefixo conhecido.
  -e 's/\b(AKIA|ASIA)[A-Z0-9]{16}\b/\1***/g'
  -e 's/\b(sk-ant-|sk-proj-|sk-)[A-Za-z0-9_-]{16,}/\1***/g'
  -e 's/\b(github_pat_|gh[pousr]_)[A-Za-z0-9_]{20,}/\1***/g'
  -e 's/\b(glpat-)[A-Za-z0-9_-]{20,}/\1***/g'
  -e 's/\b(npm_|hf_)[A-Za-z0-9]{20,}/\1***/g'
  -e 's/\b(AIza)[A-Za-z0-9_-]{20,}/\1***/g'
  -e 's/\b(xox[abpr]-)[A-Za-z0-9-]+/\1***/g'
  # JWT: três partes em base64url, as duas primeiras começando por eyJ.
  -e 's/\beyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*/eyJ***/g'
  # Senha em URL (https://usuario:senha@host, postgres://usuario:senha@db).
  -e 's#(://[^/:@[:space:]]+:)[^/@[:space:]]+@#\1***@#g'
  # Cabeçalhos de autorização: Bearer e Basic.
  -e "s/\\b(bearer|basic)([[:space:]]+)[^\"'[:space:]]{8,}/\\1\\2***/Ig"
  # Pares nome e valor: entre aspas duplas, entre aspas simples e sem aspas.
  -e "s/(${nome_segredo}${q}?[[:space:]]*[:=][[:space:]]*\")([^\"\\\\]|\\\\.)+\"/\\1***\"/Ig"
  -e "s/(${nome_segredo}${q}?[[:space:]]*[:=][[:space:]]*')[^']+'/\\1***'/Ig"
  -e "s/(${nome_segredo}${q}?[[:space:]]*[:=][[:space:]]*)[^\"'[:space:],}*][^\"'[:space:],}]*/\\1***/Ig"
)

if [[ "${1:-}" == "-h" || "${1:-}" == "--ajuda" || "${1:-}" == "--help" ]]; then
  sed -n '2,10s/^# \{0,1\}//p' "$0"
  exit 0
fi

# Com --mascarar, só aplica a máscara à entrada e escreve na saída padrão:
# serve para conferir um arquivo antes de compartilhá-lo e para os testes.
if [[ "${1:-}" == "--mascarar" ]]; then
  exec sed -E "${mascara_sed[@]}"
fi

if [[ -n "${1:-}" && -f "$1" ]]; then
  echo "jangada-mapear: destino não pode ser um arquivo existente ($1)" >&2
  exit 1
fi

JANGADA_PATH="${JANGADA_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
C="${XDG_CONFIG_HOME:-$HOME/.config}"
host="$(cat /etc/hostname 2>/dev/null || uname -n)"
saida="${1:-$JANGADA_PATH/mapeamento/$host-$(date +%Y%m%d-%H%M)}"
mkdir -p "$saida"/{config,sistema,hyprland,noctalia,agentes} || exit 1
# Caminho absoluto: o restante do script roda dentro de "$saida", e a máscara
# de dados sensíveis percorre "$saida" de novo, o que falharia se fosse relativo.
saida="$(realpath "$saida")"
cd "$saida" || exit 1
trap mascarar EXIT

log() { printf '==> %s\n' "$*"; }
tem() { command -v "$1" >/dev/null 2>&1; }
# Executa um comando e grava a saída; em caso de erro, registra o erro no arquivo.
grava() { local arq="$1"; shift; "$@" >"$arq" 2>&1 || echo "(comando falhou: $*)" >>"$arq"; }

# Arquivos que nunca são copiados.
ignorar_regex='((^|/)id_(rsa|dsa|ecdsa|ed25519)(\.pub)?|\.pem|\.key|\.p12|\.env(\.[^/]*)?|\.netrc|\.pgpass|credentials|\.credentials\.json|auth\.json|oauth|cookies|\.sqlite|\.db|history|\.log)$'
limite_bytes=$((2 * 1024 * 1024))

# Copia um arquivo ou pasta de configuração, respeitando as exclusões.
copiar() {
  local origem="$1" destino="$2"
  [[ -e "$origem" ]] || return 0
  if [[ -d "$origem" ]]; then
    (cd "$origem" && find . -type f -size -"${limite_bytes}"c -print0 2>/dev/null) |
      while IFS= read -r -d '' f; do
        [[ "$f" =~ $ignorar_regex ]] && continue
        [[ "$f" == */.git/* || "$f" == */node_modules/* || "$f" == */__pycache__/* ]] && continue
        mkdir -p "$destino/$(dirname "$f")"
        cp -p "$origem/$f" "$destino/$f" 2>/dev/null
      done
  else
    [[ "$origem" =~ $ignorar_regex ]] && return 0
    mkdir -p "$(dirname "$destino")"
    cp -p "$origem" "$destino" 2>/dev/null
  fi
}

# Mascara valores sensíveis em todos os arquivos de texto da saída.
mascarar() {
  grep -rIlZ . "$saida" 2>/dev/null | while IFS= read -r -d '' f; do
    sed -i -E "${mascara_sed[@]}" "$f"
  done
}

# ---------------------------------------------------------------- sistema
log "sistema"
grava sistema/os-release.txt cat /etc/os-release
grava sistema/kernel.txt uname -a
grava sistema/discos.txt lsblk -f
grava sistema/raiz.txt findmnt -no SOURCE,FSTYPE,OPTIONS /
grava sistema/montagens-btrfs.txt findmnt -t btrfs
if [[ "$(findmnt -no FSTYPE /)" == "btrfs" ]]; then
  grava sistema/subvolumes.txt sudo -n btrfs subvolume list /
fi
{
  for f in /boot/limine.conf /boot/limine/limine.conf /boot/EFI/limine/limine.conf /boot/grub/grub.cfg; do
    [[ -f "$f" ]] && echo "encontrado: $f"
  done
  # O bootctl precisa de root para abrir a partição EFI, por isso as pastas
  # do systemd-boot são conferidas antes dele.
  for d in /boot/loader/entries /efi/loader/entries /boot/EFI/systemd /efi/EFI/systemd; do
    [[ -d "$d" ]] && echo "encontrado: $d"
  done
  tem bootctl && bootctl is-installed 2>/dev/null && echo "systemd-boot instalado"
  pacman -Q limine grub 2>/dev/null
} >sistema/boot.txt
grava sistema/gpu.txt sh -c 'lspci -k 2>/dev/null | grep -A3 -Ei "vga|3d|display"'
grava sistema/memoria.txt free -h
grava sistema/snapper.txt sh -c 'ls /etc/snapper/configs 2>/dev/null; pacman -Q snapper snap-pac 2>/dev/null'
{
  echo "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}"
  echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-}"
  echo "SHELL=$SHELL"
  echo "compositores em execução:"
  for p in Hyprland niri sway river labwc; do pgrep -x "$p" >/dev/null && echo "  $p"; done
  echo "gerenciador de login: $(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)"
  echo "sessões disponíveis:"
  ls /usr/share/wayland-sessions /usr/share/xsessions 2>/dev/null | sed 's/^/  /'
} >sistema/sessao.txt

log "pacotes"
grava sistema/pacotes-explicitos.txt pacman -Qqe
grava sistema/pacotes-aur.txt pacman -Qqm
grava sistema/versoes-interface.txt sh -c 'pacman -Q 2>/dev/null | grep -Ei "^(hypr|aquamarine|quickshell|noctalia|niri|waybar|walker|fuzzel|rofi|mako|swaync|dunst|matugen|swww|awww|swaybg|ghostty|kitty|foot|alacritty|wezterm|tmux|zellij|uwsm|sddm|greetd|gdm|ly)"'
grava sistema/servicos-sistema.txt systemctl list-unit-files --state=enabled --no-pager
grava sistema/servicos-usuario.txt systemctl --user list-unit-files --state=enabled --no-pager
grava sistema/fontes.txt sh -c 'fc-list : family | sort -u'

# ---------------------------------------------------------------- Hyprland
log "Hyprland"
copiar "$C/hypr" config/hypr
if tem hyprctl && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  grava hyprland/versao.txt hyprctl version
  grava hyprland/monitores.json hyprctl monitors -j
  grava hyprland/atalhos.json hyprctl binds -j
  grava hyprland/workspaces.json hyprctl workspaces -j
  grava hyprland/dispositivos.json hyprctl devices -j
  grava hyprland/erros-config.txt hyprctl configerrors
  # Só classes das janelas abertas; títulos podem conter informação pessoal.
  grava hyprland/classes-janelas.txt sh -c 'hyprctl clients -j | jq -r ".[].class" | sort | uniq -c | sort -rn'
  if tem jq && jq -e . hyprland/atalhos.json >/dev/null 2>&1; then
    jq -r '.[] | "\(.modmask)\t\(.key)\t\(.dispatcher)\t\(.arg)"' hyprland/atalhos.json \
      >hyprland/atalhos.tsv 2>/dev/null
  else
    hyprctl binds 2>/dev/null | awk '
      /^[a-z]+$/        { mod = ""; key = ""; disp = ""; arg = ""; next }
      /^\tmodmask:/     { mod = $2; next }
      /^\tkey:/         { key = $2; next }
      /^\tdispatcher:/  { disp = substr($0, 14); next }
      /^\targ:/         { arg = substr($0, 7); next }
      /^$/ {
        if (key != "") {
          printf "%s\t%s\t%s\t%s\n", mod, key, disp, arg
          key = ""
        }
      }
    ' >hyprland/atalhos.tsv
  fi
else
  echo "Hyprland não está em execução nesta sessão; só os arquivos foram copiados" >hyprland/LEIA.txt
fi
{
  echo "arquivos .lua: $(find "$C/hypr" -name '*.lua' 2>/dev/null | wc -l)"
  echo "arquivos .conf: $(find "$C/hypr" -name '*.conf' 2>/dev/null | wc -l)"
} >hyprland/formato-config.txt
copiar "$C/niri" config/niri

# ---------------------------------------------------------------- Noctalia
log "Noctalia e Quickshell"
copiar "$C/noctalia" config/noctalia
copiar "$C/quickshell" config/quickshell

# Resumo das configurações do Noctalia em formato chave=valor, fácil de comparar.
achatar() { jq -r 'paths(scalars) as $p | "\($p | map(tostring) | join("."))=\(getpath($p))"' "$1" 2>/dev/null | sort; }
for f in config/noctalia/*.json; do
  [[ -e "$f" ]] || continue
  achatar "$f" >"noctalia/$(basename "$f" .json).chaves.txt"
done

# Procura a instalação do Noctalia (pacote) e um arquivo de padrões para comparar.
origem_noctalia=""
for d in /etc/xdg/quickshell/noctalia-shell /usr/share/quickshell/noctalia-shell /usr/share/noctalia-shell "$C/quickshell/noctalia-shell"; do
  [[ -d "$d" ]] && { origem_noctalia="$d"; break; }
done
{
  echo "instalação encontrada: ${origem_noctalia:-nenhuma}"
  pacman -Qo "$origem_noctalia" 2>/dev/null || echo "(não pertence a pacote do pacman)"
} >noctalia/instalacao.txt

if [[ -n "$origem_noctalia" ]]; then
  padrao="$(find "$origem_noctalia" -maxdepth 3 -iname '*default*.json' -ipath '*setting*' 2>/dev/null | head -1)"
  if [[ -n "$padrao" && -f config/noctalia/settings.json ]]; then
    echo "comparado com: $padrao" >noctalia/diferencas-do-padrao.txt
    diff <(achatar "$padrao") <(achatar config/noctalia/settings.json) | grep '^>' | sed 's/^> //' \
      >>noctalia/diferencas-do-padrao.txt
  fi
  # QML alterado localmente: por git, se for um clone; senão, por comparação com o pacote.
  if git -C "$origem_noctalia" rev-parse >/dev/null 2>&1; then
    grava noctalia/qml-git-status.txt git -C "$origem_noctalia" status --short
    grava noctalia/qml-git-log.txt git -C "$origem_noctalia" log --oneline -30
    git -C "$origem_noctalia" diff >noctalia/qml-alteracoes.diff 2>/dev/null
  elif [[ -d "$C/quickshell/noctalia-shell" && "$origem_noctalia" != "$C/quickshell/noctalia-shell" ]]; then
    diff -ruN "$origem_noctalia" "$C/quickshell/noctalia-shell" >noctalia/qml-alteracoes.diff 2>/dev/null
  fi
fi
copiar "$HOME/.cache/noctalia/wallpapers.json" noctalia/cache-wallpapers.json

# ---------------------------------------------------------------- outros programas
log "terminal, shell e aplicativos"
for d in ghostty kitty foot alacritty wezterm tmux zellij waybar fuzzel walker rofi mako swaync dunst \
  matugen wlogout gtk-3.0 gtk-4.0 qt5ct qt6ct fontconfig environment.d uwsm starship.toml mise \
  systemd/user nvim/init.lua mimeapps.list user-dirs.dirs; do
  copiar "$C/$d" "config/$d"
done
for f in .bashrc .bash_profile .zshrc .zprofile .zshenv .profile .tmux.conf .gitconfig; do
  copiar "$HOME/$f" "config/home/$f"
done

# ---------------------------------------------------------------- agentes de IA
log "agentes de IA"
copiar "$HOME/.claude/settings.json" agentes/claude/settings.json
copiar "$HOME/.claude/CLAUDE.md" agentes/claude/CLAUDE.md
for d in commands agents skills; do
  [[ -d "$HOME/.claude/$d" ]] && ls -R "$HOME/.claude/$d" >"agentes/claude/$d.txt" 2>/dev/null
done
copiar "$HOME/.gemini/settings.json" agentes/gemini/settings.json
copiar "$HOME/.gemini/GEMINI.md" agentes/gemini/GEMINI.md
copiar "$HOME/.codex/config.toml" agentes/codex/config.toml
copiar "$HOME/.codex/AGENTS.md" agentes/codex/AGENTS.md
{
  for c in claude gemini codex opencode aider; do
    tem "$c" && echo "$c: $("$c" --version 2>/dev/null | head -1)"
  done
} >agentes/versoes.txt

mascarar

# ---------------------------------------------------------------- resumo
log "resumo"
n_linhas() { [[ -f "$1" ]] && wc -l <"$1" | tr -d ' ' || echo 0; }
{
  echo "# Mapa da configuração: $host"
  echo
  echo "Gerado em $(date '+%d/%m/%Y %H:%M') por jangada-mapear. Nenhum arquivo do sistema foi alterado."
  echo
  echo "## Sistema"
  echo
  echo "- Distribuição: $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}")"
  echo "- Raiz: $(cat sistema/raiz.txt)"
  echo "- Boot: $(tr '\n' ' ' <sistema/boot.txt)"
  echo "- Pacotes explícitos: $(n_linhas sistema/pacotes-explicitos.txt), do AUR: $(n_linhas sistema/pacotes-aur.txt)"
  echo
  echo "## Sessão e interface"
  echo
  echo '```'
  cat sistema/sessao.txt
  echo
  cat sistema/versoes-interface.txt
  echo '```'
  echo
  echo "## Hyprland"
  echo
  echo "- Formato da configuração: $(tr '\n' ',' <hyprland/formato-config.txt)"
  [[ -f hyprland/versao.txt ]] && echo "- Versão: $(head -1 hyprland/versao.txt)"
  [[ -f hyprland/atalhos.tsv ]] && echo "- Atalhos ativos: $(n_linhas hyprland/atalhos.tsv) (lista em hyprland/atalhos.tsv)"
  [[ -s hyprland/erros-config.txt ]] && echo "- Há erros de configuração: veja hyprland/erros-config.txt"
  echo
  echo "## Noctalia"
  echo
  cat noctalia/instalacao.txt | sed 's/^/- /'
  for f in noctalia/*.chaves.txt; do
    [[ -e "$f" ]] && echo "- $(basename "$f" .chaves.txt): $(n_linhas "$f") opções registradas"
  done
  if [[ -s noctalia/diferencas-do-padrao.txt ]]; then
    echo "- Opções diferentes do padrão: $(($(n_linhas noctalia/diferencas-do-padrao.txt) - 1))"
    echo
    echo '```'
    tail -n +2 noctalia/diferencas-do-padrao.txt | head -60
    echo '```'
  fi
  if [[ -s noctalia/qml-alteracoes.diff ]]; then
    echo
    echo "- **QML alterado localmente**: $(grep -c '^+++ ' noctalia/qml-alteracoes.diff) arquivo(s), em noctalia/qml-alteracoes.diff"
  fi
  echo
  echo "## Agentes de IA"
  echo
  sed 's/^/- /' agentes/versoes.txt
  echo
  echo "## Arquivos copiados"
  echo
  echo '```'
  (cd config && find . -type f | sort | head -300)
  echo '```'
  echo
  echo "## Próximo passo"
  echo
  echo "Abra este mapa junto com revisao/RESGATE.md e peça a um agente para preencher a"
  echo "tabela de equivalências entre as suas personalizações e os módulos do jangada."
} >MAPA.md

echo
echo "mapa gerado em: $saida"
echo "confira se nada sensível escapou da máscara antes de compartilhar a pasta"
