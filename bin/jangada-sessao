#!/usr/bin/env bash
# Inicia a sessão jangada (chamado pelo gerenciador de login).
# Usa uma configuração própria, separada de ~/.config/hypr.
JANGADA_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export JANGADA_PATH
export PATH="$JANGADA_PATH/bin:$PATH"

# shellcheck source=bin/jangada-config
source "$JANGADA_PATH/bin/jangada-config"

# Escolha da GPU antes de o compositor subir. Com duas placas, o aquamarine
# pode pegar a que não tem monitor ligado: a sessão sobe sem imagem e sem
# terminal para consertar. JANGADA_GPU no jangada.conf sobrepõe a detecção e
# recebe um dispositivo só, porque a lista do aquamarine é separada por ":" e
# o endereço PCI de /dev/dri/by-path também tem ":".
_gpus=()
if [[ -z "${AQ_DRM_DEVICES:-}" ]]; then
  if [[ -n "$JANGADA_GPU" ]]; then
    _gpus=("$JANGADA_GPU")
  else
    mapfile -t _gpus < <(gpu_das_saidas)
  fi
  # gpu_para_aquamarine resolve cada by-path para /dev/dri/cardN: entregue
  # como está, o ":" do endereço PCI parte o caminho e o aquamarine não
  # encontra GPU nenhuma.
  _aq=""
  ((${#_gpus[@]})) && _aq="$(gpu_para_aquamarine "${_gpus[@]}" || true)"
  if [[ -z "$_aq" && -n "$JANGADA_GPU" ]]; then
    # Caminho do jangada.conf que não existe mais (placa trocada, por exemplo).
    # Volta para a detecção em vez de deixar a escolha por conta do aquamarine.
    echo "jangada: JANGADA_GPU=$JANGADA_GPU não existe; detectando pela saída conectada" >&2
    mapfile -t _gpus < <(gpu_das_saidas)
    ((${#_gpus[@]})) && _aq="$(gpu_para_aquamarine "${_gpus[@]}" || true)"
  fi
  [[ -n "$_aq" ]] && export AQ_DRM_DEVICES="$_aq"
fi

# Ajustes exigidos pelo driver proprietário, aplicados só quando é ele que
# conduz a sessão. A placa que conduz é a primeira da lista. GBM_BACKEND fica
# de fora de propósito: ele quebra Firefox e aplicativos Electron, e o driver
# atual não precisa dele.
_primeira="${_gpus[0]:-${AQ_DRM_DEVICES%%:*}}"
if [[ -n "$_primeira" ]] && [[ "$(driver_da_gpu "$_primeira")" == nvidia ]]; then
  export LIBVA_DRIVER_NAME=nvidia
  export __GLX_VENDOR_LIBRARY_NAME=nvidia
  export NVD_BACKEND=direct
fi

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/jangada/hypr/hyprland.lua"
if [[ ! -f "$cfg" ]]; then
  # Sem configuração do usuário, usa o modelo do repositório para não ficar sem sessão.
  cfg="$JANGADA_PATH/config/hypr/hyprland.lua"
fi

if command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland -- --config "$cfg"
else
  exec Hyprland --config "$cfg"
fi
