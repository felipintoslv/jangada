#!/usr/bin/env bash
# Atualiza o jangada e o sistema, avisando quando o conjunto do Hyprland muda.
#
# Ordem: busca do repositório (aplicada só com a sua confirmação), lista de
# atualizações, confirmação quando houver mudança no Hyprland, pacman -Syu
# (snap-pac cria os snapshots), AUR, migrações e, por fim, recarga com
# conferência de erros. Depois confere o initramfs e o driver NVIDIA e roda os
# ganchos pos-update do usuário.
#
# A cópia instalada acompanha o ramo JANGADA_CANAL (main ou estavel).
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

# Pacotes do conjunto Hyprland. Atualizar só parte deles causa quebras
# (bibliotecas com versões incompatíveis), por isso o jangada não os fixa com
# IgnorePkg: avisa e deixa você decidir antes de atualizar tudo junto.
# O Noctalia entra no pacote noctalia-shell, e em algumas máquinas no
# noctalia-shell-git do AUR; os dois contam.
conjunto_hypr='^(hyprland|aquamarine|hyprutils|hyprlang|hyprgraphics|hyprcursor|hyprwire|hyprtoolkit|hyprland-guiutils|hyprlock|hypridle|hyprpolkitagent|xdg-desktop-portal-hyprland|quickshell(-git)?|noctalia-shell(-git)?|noctalia-qs(-git)?)$'

# O git roda fora do isolamento sobre a cópia instalada: sem fsmonitor nem
# ganchos, que viriam da configuração do repositório.
g() { jangada_git_seguro -C "$JANGADA_PATH" "$@"; }

# Mostra os commits de $1 até $2 e pede confirmação. A origem da cópia
# instalada é a cópia de trabalho, cujas refs um agente isolado pode gravar:
# nada que chega por ela roda (jangada-versao, migrações com sudo ainda
# autenticado, ganchos) sem que você veja e aceite. Os assuntos e nomes passam
# por um filtro de caracteres de controle, para que uma sequência de escape
# não apague nem disfarce a lista. Sem terminal, a resposta é não.
confirmar_novidades() {
  local de="$1" ate="$2" sensiveis r=""
  echo "commits novos na origem:"
  g log --oneline "$de..$ate" | tr -d '\000-\010\013-\037\177' | sed 's/^/   /'
  g diff --no-ext-diff --no-textconv --stat "$de..$ate" | tr -d '\000-\010\013-\037\177' | sed 's/^/   /'
  sensiveis="$(g diff --no-ext-diff --no-textconv --name-only "$de..$ate" -- migrations install bin | tr -d '\000-\010\013-\037\177')"
  if [[ -n "$sensiveis" ]]; then
    echo "!! mudam código que roda fora do isolamento (migrations/, install/, bin/):"
    printf '%s\n' "$sensiveis" | sed 's/^/   /'
  fi
  read -r -p "aplicar estas mudanças do jangada? [s/N] " r || r=""
  [[ "${r,,}" == s* ]]
}

# Opções do avanço da cópia instalada. Para exigir commits assinados, basta
# acrescentar aqui --verify-signatures.
opcoes_merge=(--ff-only --quiet)

echo "==> repositório jangada (canal $JANGADA_CANAL)"
if [[ -z "$(g status --porcelain --ignore-submodules=all)" ]]; then
  # Só busca: nada chega à cópia instalada antes da confirmação abaixo.
  g fetch --quiet origin || echo "!! não consegui buscar o repositório de origem"
  ramo_atual="$(g rev-parse --abbrev-ref HEAD)"
  if [[ "$ramo_atual" != "$JANGADA_CANAL" ]]; then
    if g show-ref --verify --quiet "refs/heads/$JANGADA_CANAL"; then
      g switch --quiet "$JANGADA_CANAL"
    elif g show-ref --verify --quiet "refs/remotes/origin/$JANGADA_CANAL"; then
      # O ramo novo nasce no ponto da origem: passa pela mesma confirmação.
      if confirmar_novidades HEAD "refs/remotes/origin/$JANGADA_CANAL"; then
        g switch --quiet --track "origin/$JANGADA_CANAL"
      else
        echo "!! troca para o canal $JANGADA_CANAL não aplicada; a cópia segue em $ramo_atual"
      fi
    else
      echo "!! o canal $JANGADA_CANAL não existe na origem; a cópia segue em $ramo_atual"
    fi
  fi
  antes="$(g rev-parse HEAD)"
  novo="$(g rev-parse --verify --quiet '@{upstream}^{commit}' 2>/dev/null || true)"
  if [[ -z "$novo" ]]; then
    echo "!! o ramo $(g rev-parse --abbrev-ref HEAD) não acompanha um ramo da origem; nada a aplicar"
  elif [[ "$novo" == "$antes" ]] || g merge-base --is-ancestor "$novo" "$antes"; then
    echo "jangada já atualizado"
  elif ! g merge-base --is-ancestor "$antes" "$novo"; then
    echo "!! a origem não avança em linha reta a partir da cópia instalada; nada aplicado (siga com o sistema)"
  elif confirmar_novidades "$antes" "$novo"; then
    g merge "${opcoes_merge[@]}" "$novo" \
      || echo "!! não foi possível atualizar o repositório (siga com o sistema)"
  else
    echo "!! mudanças do jangada não aplicadas; o sistema é atualizado com a versão atual e sem migrações novas"
  fi
  # O que chegou, nos grupos do CHANGELOG.md.
  if [[ "$(g rev-parse HEAD)" != "$antes" ]]; then
    echo "jangada agora em $("$JANGADA_PATH/bin/jangada-versao" -C "$JANGADA_PATH")"
    "$JANGADA_PATH/bin/jangada-versao" -C "$JANGADA_PATH" --novidades "$antes" HEAD \
      | tr -d '\000-\010\013-\037\177' | sed 's/^/   /' || true
  fi
else
  echo "!! há alterações locais em $JANGADA_PATH; a cópia instalada não foi atualizada"
fi

echo "==> atualizações disponíveis"
atualizacoes="$(checkupdates 2>/dev/null || true)"
if [[ -z "$atualizacoes" ]]; then
  echo "nenhuma atualização nos repositórios oficiais"
else
  printf '%s\n' "$atualizacoes"
  hypr="$(awk '{print $1}' <<<"$atualizacoes" | grep -E "$conjunto_hypr" || true)"
  if [[ -n "$hypr" ]]; then
    echo
    echo "!! esta atualização muda o conjunto do Hyprland:"
    grep -E "^($(paste -sd'|' <<<"$hypr")) " <<<"$atualizacoes" | sed 's/^/   /'
    echo "   notas de versão: https://github.com/hyprwm/Hyprland/releases"
    read -r -p "continuar com a atualização completa? [s/N] " r
    [[ "${r,,}" == s* ]] || { echo "atualização cancelada"; exit 0; }
  fi
fi

if [[ "$(findmnt -no FSTYPE /)" != "btrfs" ]] || ! pacman -Qq snap-pac >/dev/null 2>&1; then
  echo "!! sem snap-pac em btrfs: esta atualização não terá snapshot automático"
fi

# O pacman.log guarda a saída dos scriptlets (mkinitcpio, dkms): as linhas
# novas depois da atualização mostram se a imagem de boot foi gerada inteira.
log_pacman=/var/log/pacman.log
linhas_antes="$(wc -l <"$log_pacman" 2>/dev/null || echo 0)"

# Uma falha do pacman não interrompe o script: é justamente quando um hook do
# mkinitcpio ou do dkms falha que a conferência da imagem de boot, mais abaixo,
# precisa rodar. O que depende da atualização completa (AUR, migrações,
# recarga) fica para depois do conserto.
falhou=""
echo "==> pacman -Syu"
sudo pacman -Syu || falhou="pacman"

if [[ -z "$falhou" ]]; then
  for aur in paru yay; do
    if command -v "$aur" >/dev/null 2>&1; then
      echo "==> AUR ($aur)"
      "$aur" -Sua || falhou="AUR"
      break
    fi
  done
fi

if [[ -z "$falhou" ]]; then
  echo "==> migrações"
  "$JANGADA_PATH/bin/jangada-migrar"
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    echo "==> recarregando o Hyprland"
    "$JANGADA_PATH/bin/jangada-recarregar" || echo "!! há erros de configuração; veja acima"
  fi
else
  # Pacote do AUR compilado contra a versão anterior de uma biblioteca do
  # repositório oficial pode não abrir mais: recarregar agora trocaria uma
  # sessão que funciona por uma quebrada.
  echo "!! a atualização pelo $falhou falhou; migrações e recarga do Hyprland não foram feitas"
  echo "   o sistema pode estar com atualização parcial: resolva e rode jangada-update de novo"
fi

# Os módulos do kernel em execução somem de /usr/lib/modules quando o kernel é atualizado.
reiniciar=0
if [[ ! -d "/usr/lib/modules/$(uname -r)" ]]; then
  echo "!! o kernel foi atualizado; reinicie quando puder"
  reiniciar=1
fi

echo "==> imagem de boot e módulos"
erros_boot="$(tail -n +"$((linhas_antes + 1))" "$log_pacman" 2>/dev/null \
  | grep -a 'ALPM-SCRIPTLET' | grep -aE '==> ERROR|errors were encountered|dkms.*(error|failed)|Error! ' || true)"
if [[ -n "$erros_boot" ]]; then
  echo "!! a atualização registrou erros na geração da imagem de boot ou dos módulos:"
  printf '%s\n' "$erros_boot" | sed 's/^/   /'
  echo "   confira antes de reiniciar (sudo mkinitcpio -P refaz as imagens)"
else
  echo "sem erros de mkinitcpio ou dkms nesta atualização"
fi

# Driver NVIDIA: depois de atualizar o nvidia-utils sem reiniciar, o módulo
# carregado fica na versão antiga e as bibliotecas na nova. Jogos e o próprio
# Hyprland falham com erros de versão até o reboot. O lib32 fora de passo tem o
# mesmo efeito nos jogos de 32 bits.
if [[ -r /sys/module/nvidia/version ]] && pacman -Qq nvidia-utils >/dev/null 2>&1; then
  carregado="$(</sys/module/nvidia/version)"
  instalado="$(pacman -Q nvidia-utils | awk '{print $2}')"; instalado="${instalado%-*}"
  if [[ "$carregado" != "$instalado" ]]; then
    echo "!! driver NVIDIA carregado $carregado, instalado $instalado; reinicie antes de abrir jogos"
    reiniciar=1
  else
    echo "driver NVIDIA $carregado carregado e instalado"
  fi
  if pacman -Qq lib32-nvidia-utils >/dev/null 2>&1; then
    lib32="$(pacman -Q lib32-nvidia-utils | awk '{print $2}')"; lib32="${lib32%-*}"
    [[ "$lib32" == "$instalado" ]] || echo "!! lib32-nvidia-utils $lib32 diferente de nvidia-utils $instalado"
  fi
fi
((reiniciar)) && echo "!! reinicie quando puder"

"$JANGADA_PATH/bin/jangada-gancho" pos-update
[[ -z "$falhou" ]]
