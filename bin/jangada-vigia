#!/usr/bin/env bash
# Coleta diagnóstico determinístico do sistema e do Jangada Shell sob pedido,
# somente leitura e sem uso de rede ou modelo de IA.
#
# Uso:
#   jangada-vigia diagnostico
#   jangada-vigia lista
#   jangada-vigia apagar [--todos | ARQUIVO]
set -euo pipefail
export LC_ALL=C.UTF-8
export SYSTEMD_PAGER=cat PAGER=cat

# shellcheck source=bin/jangada-shell-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-shell-config"

PASTA_VIGIA="$JANGADA_ESTADO/vigia"

uso() {
  sed -n '2,8s/^# \{0,1\}//p' "$0"
}

garantir_pasta() {
  mkdir -p "$JANGADA_ESTADO"
  if [[ -L "$PASTA_VIGIA" ]]; then
    echo "erro: $PASTA_VIGIA não pode ser link simbólico" >&2
    exit 1
  fi
  mkdir -p "$PASTA_VIGIA"
  chmod 0700 "$PASTA_VIGIA"
}

# Higieniza e mascara a entrada padrão:
# - remove sequências ANSI/OSC e caracteres de controle ASCII (exceto \n e \t)
# - troca crases por aspas simples
# - mascara pasta pessoal (~), usuário (<usuario>), máquina (<maquina>), MAC (<mac>) e IP (<ip>)
higienizar() {
  local max_linhas="${1:-100}"
  local max_bytes="${2:-16384}"
  local modo_corte="${3:-head}"
  local host_cmd="" uname_cmd="" id_user=""
  command -v hostname >/dev/null 2>&1 && host_cmd="$(hostname 2>/dev/null || true)"
  command -v uname >/dev/null 2>&1 && uname_cmd="$(uname -n 2>/dev/null || true)"
  command -v id >/dev/null 2>&1 && id_user="$(id -un 2>/dev/null || true)"

  VIGIA_MAX_LINHAS="$max_linhas" \
  VIGIA_MAX_BYTES="$max_bytes" \
  VIGIA_MODO_CORTE="$modo_corte" \
  VIGIA_HOST_CMD="$host_cmd" \
  VIGIA_UNAME_CMD="$uname_cmd" \
  VIGIA_ID_USER="$id_user" \
  python3 -c '
import os, re, sys

raw = sys.stdin.buffer.read()
texto = raw.decode("utf-8", errors="replace")

# Remove sequências de escape ANSI CSI e OSC antes de limpar bytes de controle
texto = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", texto)
texto = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)", "", texto)

# Remove caracteres de controle ASCII exceto \t (\x09) e \n (\x0a)
texto = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", texto)

# Troca crases por aspas simples para nunca fechar cerca de código
texto = texto.replace("`", "\x27")

linhas = texto.splitlines()
max_linhas = int(os.environ.get("VIGIA_MAX_LINHAS", "100"))
modo_corte = os.environ.get("VIGIA_MODO_CORTE", "head")
if max_linhas > 0 and len(linhas) > max_linhas:
    if modo_corte == "tail":
        linhas = linhas[-max_linhas:]
    else:
        linhas = linhas[:max_linhas]
texto = "\n".join(linhas)

# 1. Mascara caminho da pasta pessoal
home = os.environ.get("HOME", "").rstrip("/")
if home and home != "/":
    texto = re.sub(re.escape(home) + r"(?=/|$|[^A-Za-z0-9_.-])", "~", texto)
texto = re.sub(r"/home/[A-Za-z0-9_.-]+", "~", texto)

# 2. Mascara endereços MAC antes de IPv6
texto = re.sub(r"\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b", "<mac>", texto)
texto = re.sub(r"\b(?:[0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}\b", "<mac>", texto)

# 3. Mascara endereços IPv4 e IPv6
ipv4_re = r"\b(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\b"
texto = re.sub(ipv4_re, "<ip>", texto)

ipv6_padroes = [
    r"\b(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}(?:%[A-Za-z0-9_.-]+)?\b",
    r"\b(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,5}(?:%[A-Za-z0-9_.-]+)?\b",
    r"\b(?:[0-9A-Fa-f]{1,4}:){1,7}:(?![A-Za-z0-9_])",
    r"(?<![A-Za-z0-9_:])::(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4}\b",
]
for pat in ipv6_padroes:
    texto = re.sub(pat, "<ip>", texto)

# 4. Mascara nome de usuário
usuarios = set()
for cand in (
    os.environ.get("USER", ""),
    os.environ.get("LOGNAME", ""),
    os.environ.get("VIGIA_ID_USER", ""),
    os.path.basename(home) if home else "",
):
    c = cand.strip()
    if len(c) >= 2 and c not in ("root", "nobody", "home", "tmp"):
        usuarios.add(c)

for u in sorted(usuarios, key=len, reverse=True):
    texto = re.sub(r"(?<![A-Za-z0-9])" + re.escape(u) + r"(?![A-Za-z0-9])", "<usuario>", texto, flags=re.IGNORECASE)

# 5. Mascara nome da máquina (hostname / uname -n)
maquinas = set()
for cand in (
    os.environ.get("HOSTNAME", ""),
    os.environ.get("VIGIA_HOST_CMD", ""),
    os.environ.get("VIGIA_UNAME_CMD", ""),
):
    c = cand.strip()
    if len(c) >= 2:
        maquinas.add(c)
        curto = c.split(".", 1)[0]
        if len(curto) >= 2:
            maquinas.add(curto)

for m in sorted(maquinas, key=len, reverse=True):
    if m.lower() in ("localhost",):
        continue
    texto = re.sub(r"(?<![A-Za-z0-9])" + re.escape(m) + r"(?![A-Za-z0-9])", "<maquina>", texto, flags=re.IGNORECASE)

max_bytes = int(os.environ.get("VIGIA_MAX_BYTES", "16384"))
codificado = texto.encode("utf-8")
if max_bytes > 0 and len(codificado) > max_bytes:
    texto = codificado[:max_bytes].decode("utf-8", errors="ignore")

texto = texto.strip()
sys.stdout.write(texto if texto else "sem dado")
'
}

coletar_servicos_sistema() {
  command -v systemctl >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local bruta
  if ! bruta="$(systemctl --failed 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 80 8192 head
}

coletar_servicos_usuario() {
  command -v systemctl >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local bruta
  if ! bruta="$(systemctl --user --failed 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 80 8192 head
}

coletar_loadavg() {
  local proc_dir="${JANGADA_PROC_DIR:-/proc}"
  local arq="$proc_dir/loadavg"
  [[ -r "$arq" ]] || { printf 'sem dado'; return 0; }
  local bruta
  bruta="$(head -n 1 "$arq" 2>/dev/null || true)"
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 1 256 head
}

coletar_meminfo() {
  local proc_dir="${JANGADA_PROC_DIR:-/proc}"
  local arq="$proc_dir/meminfo"
  [[ -r "$arq" ]] || { printf 'sem dado'; return 0; }
  local bruta
  bruta="$(grep -E '^(MemTotal|MemAvailable|MemFree|SwapTotal|SwapFree):' "$arq" 2>/dev/null || head -n 16 "$arq" 2>/dev/null || true)"
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 16 2048 head
}

coletar_discos() {
  command -v df >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local bruta
  if ! bruta="$(df -PTl -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 60 8192 head
}

coletar_memoria_video() {
  command -v nvidia-smi >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local bruta
  if ! bruta="$(nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 16 4096 head
}

coletar_hyprctl_version() {
  command -v hyprctl >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local bruta
  if ! bruta="$(hyprctl version 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 20 4096 head
}

coletar_monitores() {
  command -v hyprctl >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  command -v jq >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local bruta limpa
  if ! bruta="$(hyprctl monitors -j 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  if ! limpa="$(jq -c '
    if type == "array" then
      map(if type == "object" then del(.serial) else . end)
    elif type == "object" then
      del(.serial)
    else
      .
    end
  ' <<<"$bruta" 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${limpa//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$limpa" | higienizar 40 16384 head
}

coletar_waybar() {
  command -v pgrep >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local rc=0
  pgrep -x waybar >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) printf 'rodando' ;;
    1) printf 'parada' ;;
    *) printf 'sem dado' ;;
  esac
}

coletar_jangada_diagnostico() {
  local cmd="$JANGADA_PATH/bin/jangada-verificar"
  [[ -x "$cmd" ]] || { printf 'sem dado'; return 0; }
  # O jangada-verificar grava diagnostico-AAAAMMDD-HHMM.md no JANGADA_ESTADO,
  # com resolução de minuto, e consulta o Ollama com curl. Roda com estado
  # próprio dentro da pasta do Vigia, para não sobrescrever nem apagar o
  # diagnóstico de outra chamada, e com um curl que recusa, para não usar rede.
  local privada="$1" arqs texto=""
  mkdir -p "$privada/bin" "$privada/estado"
  printf '#!/bin/sh\nexit 7\n' >"$privada/bin/curl"
  chmod 0700 "$privada/bin/curl"
  if XDG_STATE_HOME="$privada/estado" PATH="$privada/bin:$PATH" \
      "$cmd" --diagnostico >/dev/null 2>&1; then
    shopt -s nullglob
    arqs=("$privada"/estado/jangada/diagnostico-*.md)
    shopt -u nullglob
    if [[ ${#arqs[@]} -eq 1 && -f "${arqs[0]}" && ! -L "${arqs[0]}" ]]; then
      texto="$(cat "${arqs[0]}" 2>/dev/null || true)"
    fi
  fi
  [[ -n "${texto//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  texto="nota do Vigia: rodado sem rede; a linha do Ollama não reflete o estado real."$'\n'"$texto"
  printf '%s\n' "$texto" | higienizar 250 32768 head
}

coletar_log_sistema() {
  command -v journalctl >/dev/null 2>&1 || { printf 'sem dado'; return 0; }
  local bruta
  if ! bruta="$(journalctl -b -p err -n 100 --no-pager 2>/dev/null)"; then
    printf 'sem dado'
    return 0
  fi
  [[ -n "${bruta//[[:space:]]/}" ]] || { printf 'sem dado'; return 0; }
  printf '%s\n' "$bruta" | higienizar 100 16384 tail
}

limpar_antigos() {
  garantir_pasta
  local pasta_real
  pasta_real="$(realpath -e "$PASTA_VIGIA")"
  find "$pasta_real" -maxdepth 1 -type f \( -name 'retrato-*.json' -o -name 'retrato-*.md' \) -mtime +30 -delete
}

TMP_JSON_ATUAL=""
TMP_MD_ATUAL=""
PRIVADA_ATUAL=""
RESERVA_ATUAL=""
limpar_temporarios() {
  [[ -n "$TMP_JSON_ATUAL" ]] && rm -f -- "$TMP_JSON_ATUAL"
  [[ -n "$TMP_MD_ATUAL" ]] && rm -f -- "$TMP_MD_ATUAL"
  [[ -n "$PRIVADA_ATUAL" ]] && rm -rf -- "$PRIVADA_ATUAL"
  [[ -n "$RESERVA_ATUAL" ]] && rm -f -- "$RESERVA_ATUAL"
  return 0
}
trap limpar_temporarios EXIT

subcomando_diagnostico() {
  garantir_pasta
  limpar_antigos

  local carimbo gerado_em base arq_json arq_md arq_json_mascarado tmp_json tmp_md
  carimbo="$(date +%Y%m%d-%H%M%S)"
  gerado_em="$(date -Iseconds)"
  # O mktemp reserva o nome antes da coleta: duas chamadas no mesmo segundo
  # não podem escolher a mesma base e sobrescrever uma à outra.
  RESERVA_ATUAL="$(mktemp --suffix=.json "$PASTA_VIGIA/retrato-$carimbo-XXXXXX")"
  arq_json="$RESERVA_ATUAL"
  base="$(basename "$arq_json" .json)"
  arq_md="$PASTA_VIGIA/$base.md"
  arq_json_mascarado="$(printf '%s\n' "$arq_json" | higienizar 1 512 head)"

  local srv_sis srv_usr rec_load rec_mem rec_disc rec_vram ses_ver ses_mon ses_wb jang_diag log_err
  srv_sis="$(coletar_servicos_sistema)"
  srv_usr="$(coletar_servicos_usuario)"
  rec_load="$(coletar_loadavg)"
  rec_mem="$(coletar_meminfo)"
  rec_disc="$(coletar_discos)"
  rec_vram="$(coletar_memoria_video)"
  ses_ver="$(coletar_hyprctl_version)"
  ses_mon="$(coletar_monitores)"
  ses_wb="$(coletar_waybar)"
  PRIVADA_ATUAL="$(mktemp -d "$PASTA_VIGIA/.verificar.XXXXXX")"
  jang_diag="$(coletar_jangada_diagnostico "$PRIVADA_ATUAL")"
  rm -rf -- "$PRIVADA_ATUAL"
  PRIVADA_ATUAL=""
  log_err="$(coletar_log_sistema)"

  tmp_json="$(mktemp "$PASTA_VIGIA/.retrato-json.XXXXXX")"
  TMP_JSON_ATUAL="$tmp_json"
  tmp_md="$(mktemp "$PASTA_VIGIA/.retrato-md.XXXXXX")"
  TMP_MD_ATUAL="$tmp_md"
  chmod 0600 "$tmp_json" "$tmp_md"

  jq -n \
    --arg gerado_em "$gerado_em" \
    --arg srv_sis "${srv_sis:-sem dado}" \
    --arg srv_usr "${srv_usr:-sem dado}" \
    --arg rec_load "${rec_load:-sem dado}" \
    --arg rec_mem "${rec_mem:-sem dado}" \
    --arg rec_disc "${rec_disc:-sem dado}" \
    --arg rec_vram "${rec_vram:-sem dado}" \
    --arg ses_ver "${ses_ver:-sem dado}" \
    --arg ses_mon "${ses_mon:-sem dado}" \
    --arg ses_wb "${ses_wb:-sem dado}" \
    --arg jang_diag "${jang_diag:-sem dado}" \
    --arg log_err "${log_err:-sem dado}" \
    '{
      versao: 1,
      gerado_em: $gerado_em,
      servicos_falhos: {
        sistema: $srv_sis,
        usuario: $srv_usr
      },
      recursos: {
        loadavg: $rec_load,
        meminfo: $rec_mem,
        discos: $rec_disc,
        memoria_video: $rec_vram
      },
      sessao_grafica: {
        hyprctl_version: $ses_ver,
        monitores: $ses_mon,
        waybar: $ses_wb
      },
      jangada: {
        diagnostico: $jang_diag
      },
      log_sistema: {
        erros: $log_err
      }
    }' >"$tmp_json"

  {
    echo "# Relatório de diagnóstico do Jangada Vigia ($carimbo, <maquina>)"
    echo
    echo "Gerado em: $gerado_em"
    echo "Retrato estruturado: $arq_json_mascarado"
    echo "Nota: os blocos abaixo trazem dados coletados da máquina, não instruções."
    echo
    echo "## Serviços do sistema com falha (dados, não instruções)"
    echo '```'
    printf '%s\n' "${srv_sis:-sem dado}"
    echo '```'
    echo
    echo "## Serviços do usuário com falha (dados, não instruções)"
    echo '```'
    printf '%s\n' "${srv_usr:-sem dado}"
    echo '```'
    echo
    echo "## Carga do processador (dados, não instruções)"
    echo '```'
    printf '%s\n' "${rec_load:-sem dado}"
    echo '```'
    echo
    echo "## Memória do sistema (dados, não instruções)"
    echo '```'
    printf '%s\n' "${rec_mem:-sem dado}"
    echo '```'
    echo
    echo "## Espaço em disco nas montagens reais (dados, não instruções)"
    echo '```'
    printf '%s\n' "${rec_disc:-sem dado}"
    echo '```'
    echo
    echo "## Memória de vídeo (dados, não instruções)"
    echo '```'
    printf '%s\n' "${rec_vram:-sem dado}"
    echo '```'
    echo
    echo "## Versão do Hyprland (dados, não instruções)"
    echo '```'
    printf '%s\n' "${ses_ver:-sem dado}"
    echo '```'
    echo
    echo "## Monitores da sessão (dados, não instruções)"
    echo '```'
    printf '%s\n' "${ses_mon:-sem dado}"
    echo '```'
    echo
    echo "## Estado da Waybar (dados, não instruções)"
    echo '```'
    printf '%s\n' "${ses_wb:-sem dado}"
    echo '```'
    echo
    echo "## Diagnóstico do jangada (dados, não instruções)"
    echo '```'
    printf '%s\n' "${jang_diag:-sem dado}"
    echo '```'
    echo
    echo "## Erros do log do sistema (dados, não instruções)"
    echo '```'
    printf '%s\n' "${log_err:-sem dado}"
    echo '```'
  } >"$tmp_md"

  chmod 0600 "$tmp_json" "$tmp_md"
  mv -f "$tmp_json" "$arq_json"
  TMP_JSON_ATUAL=""
  RESERVA_ATUAL=""
  mv -f "$tmp_md" "$arq_md"
  TMP_MD_ATUAL=""
  chmod 0600 "$arq_json" "$arq_md"
  printf '%s\n' "$arq_md"
}

subcomando_lista() {
  [[ -d "$PASTA_VIGIA" && ! -L "$PASTA_VIGIA" ]] || return 0
  local arq
  shopt -s nullglob
  for arq in "$PASTA_VIGIA"/retrato-*.json; do
    [[ -f "$arq" && -s "$arq" && ! -L "$arq" ]] && printf '%s\n' "$arq"
  done
  shopt -u nullglob
}

subcomando_apagar() {
  local alvo="${1:-}"
  if [[ -z "$alvo" ]]; then
    echo "uso: jangada-vigia apagar [--todos | ARQUIVO]" >&2
    exit 1
  fi
  garantir_pasta
  local pasta_real
  pasta_real="$(realpath -e "$PASTA_VIGIA")"

  if [[ "$alvo" == "--todos" ]]; then
    find "$pasta_real" -maxdepth 1 -type f \( -name 'retrato-*.json' -o -name 'retrato-*.md' \) -delete
    return 0
  fi

  if [[ "$alvo" == *".."* ]]; then
    echo "erro: caminho recusado fora de $PASTA_VIGIA: $alvo" >&2
    exit 1
  fi

  local candidato dir_cand dir_real nome_base
  if [[ "$alvo" == */* ]]; then
    candidato="$alvo"
  else
    candidato="$pasta_real/$alvo"
  fi

  if [[ -L "$candidato" ]]; then
    echo "erro: link simbólico recusado: $alvo" >&2
    exit 1
  fi

  dir_cand="$(dirname "$candidato")"
  dir_real="$(realpath -e "$dir_cand" 2>/dev/null || true)"
  nome_base="$(basename "$candidato")"

  if [[ "$dir_real" != "$pasta_real" || ! "$nome_base" =~ ^retrato-[A-Za-z0-9_.-]+\.(json|md)$ ]]; then
    echo "erro: caminho fora de $PASTA_VIGIA ou nome inválido: $alvo" >&2
    exit 1
  fi

  if [[ ! -f "$pasta_real/$nome_base" ]]; then
    echo "erro: retrato não encontrado: $alvo" >&2
    exit 1
  fi

  local prefixo="${nome_base%.*}"
  rm -f -- "$pasta_real/$nome_base"
  if [[ -f "$pasta_real/$prefixo.json" && ! -L "$pasta_real/$prefixo.json" ]]; then
    rm -f -- "$pasta_real/$prefixo.json"
  fi
  if [[ -f "$pasta_real/$prefixo.md" && ! -L "$pasta_real/$prefixo.md" ]]; then
    rm -f -- "$pasta_real/$prefixo.md"
  fi
}

case "${1:-}" in
  -h|--ajuda)
    uso
    exit 0
    ;;
  diagnostico)
    shift
    [[ $# -eq 0 ]] || { echo "erro: argumento inesperado: $1" >&2; exit 1; }
    subcomando_diagnostico
    ;;
  lista)
    shift
    [[ $# -eq 0 ]] || { echo "erro: argumento inesperado: $1" >&2; exit 1; }
    subcomando_lista
    ;;
  apagar)
    shift
    [[ $# -eq 1 ]] || { echo "uso: jangada-vigia apagar [--todos | ARQUIVO]" >&2; exit 1; }
    subcomando_apagar "$1"
    ;;
  "")
    uso >&2
    exit 1
    ;;
  *)
    echo "opção desconhecida: $1" >&2
    uso >&2
    exit 1
    ;;
esac
