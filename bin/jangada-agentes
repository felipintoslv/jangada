#!/usr/bin/env bash
# Lista as sessões de agentes, com estado, e permite abrir ou encerrar.
#
# Uso:
#   jangada-agentes            seletor interativo (Enter abre, Ctrl+X encerra)
#   jangada-agentes --janela   o seletor num terminal flutuante
#   jangada-agentes --painel   mostra ou esconde o painel (workspace especial "agentes")
#   jangada-agentes --monitor  tabela atualizada a cada 2 segundos (conteúdo do painel)
#   jangada-agentes --waybar   saída JSON para o módulo da barra
#   jangada-agentes --focar S  foca a janela da sessão S ou abre uma nova
#   jangada-agentes --lista    lista simples: estado, sessão, diretório
#   jangada-agentes --previa S conteúdo do painel de prévia da sessão S
#   jangada-agentes --proximo  foca o próximo agente que espera (atalho SUPER+N)
#   jangada-agentes --anterior volta ao agente focado antes do atual (SUPER+SHIFT+N)
#   jangada-agentes --restaurar [S]  reabre as sessões interrompidas (ou só S)
#
# Sessões terminadas em "concluido" ou "aguardando" continuam na lista depois de
# o processo sair: são o resultado do ciclo, não um processo vivo. Saem com
# Ctrl+X no seletor, que encerra e remove o worktree, ou sozinhas depois de
# JANGADA_AGENTES_GUARDAR horas (padrão 24).
#
# Sessão de agente cujo tmux morreu sem estado final (reboot, queda da sessão
# gráfica) fica como "interrompido" por 7 dias: Enter no seletor, ou
# --restaurar, reabre o agente na mesma pasta e, no Claude Code, na mesma
# conversa (claude --resume).
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

estado_dir="$JANGADA_ESTADO/agentes"
mkdir -p "$estado_dir"

# Horas que um estado final continua visível depois de o processo sair.
guardar_horas="${JANGADA_AGENTES_GUARDAR:-24}"
# O mesmo, para sessão interrompida: dá tempo de voltar de um fim de semana.
guardar_interrompido_horas=168

# Separador interno dos campos. A tabulação não serve para o read: ela conta
# como espaço em branco no IFS, então duas seguidas viram uma e um campo vazio
# desloca os seguintes (com "dir" vazio, a data caía em "dir" e a sessão
# sumia como vencida). A saída de listar continua em TSV, para awk e fzf.
US=$'\x1f'

# TSV de listar convertido para o separador interno, para ler com IFS="$US".
campos() { tr '\t' "$US" <<<"$1"; }

sessoes_vivas() { "${JANGADA_TMUX[@]}" list-sessions -F '#S' 2>/dev/null || true; }

# Estado de ciclo encerrado. O jangada-par não abre sessão no tmux e o processo
# dele sai assim que grava o resultado, então sem esta distinção o painel
# recolheria o "concluido" antes de alguém ver.
estado_final() {
  case "$1" in
    concluido|aguardando) return 0 ;;
    *) return 1 ;;
  esac
}

# Um estado final velho demais para continuar ocupando o painel. Sem data, ou
# com data ilegível, conta como vencido: é resto de versão antiga do arquivo.
vencido() {
  local quando="$1" horas="${2:-$guardar_horas}" marca agora
  [[ -n "$quando" ]] || return 0
  marca="$(date -d "$quando" +%s 2>/dev/null)" || return 0
  [[ -n "$marca" ]] || return 0
  agora="$(date +%s)"
  (( agora - marca > horas * 3600 ))
}

# Estado guardado de uma sessão sem processo: final (resultado do ciclo) ou
# interrompido (dá para restaurar), cada um com o seu prazo.
guardado() {
  local estado="$1" atualizado="$2"
  if estado_final "$estado"; then
    ! vencido "$atualizado"
  elif [[ "$estado" == interrompido ]]; then
    ! vencido "$atualizado" "$guardar_interrompido_horas"
  else
    return 1
  fi
}

# Uma linha por sessão: estado<TAB>sessão<TAB>diretório<TAB>atualizado<TAB>ramo<TAB>tarefa
listar() {
  local s arq vivas pid dados estado dir atualizado ramo tarefa
  vivas="$(sessoes_vivas)"
  while read -r s; do
    [[ -n "$s" ]] || continue
    arq="$estado_dir/$s.json"
    if [[ -f "$arq" ]]; then
      dados="$(jq -r '[ (.estado // "ativo"), (.dir // ""), (.atualizado // ""), (.ramo // ""), ((.tarefa // "") | split("\n") | (.[0] // "") | gsub("&";"&amp;") | gsub("<";"&lt;") | gsub(">";"&gt;") | if length > 50 then .[0:47] + "..." else . end) ] | map(tostring | gsub("[\t\n\u001f]"; " ")) | join("\u001f")' "$arq" 2>/dev/null || printf 'ativo%s%s%s%s' "$US" "$US" "$US" "$US")"
    else
      dados="$(printf 'ativo%s%s%s%s' "$US" "$US" "$US" "$US")"
    fi
    IFS="$US" read -r estado dir atualizado ramo tarefa <<<"$dados"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$estado" "$s" "$dir" "$atualizado" "$ramo" "$tarefa"
  done <<<"$vivas"

  for arq in "$estado_dir"/*.json; do
    [[ -e "$arq" ]] || continue
    s="$(basename "$arq" .json)"
    grep -qxF "$s" <<<"$vivas" && continue
    pid="$(jq -r '.pid // empty' "$arq" 2>/dev/null || true)"
    dados="$(jq -r '[ (.estado // "ativo"), (.dir // ""), (.atualizado // ""), (.ramo // ""), ((.tarefa // "") | split("\n") | (.[0] // "") | gsub("&";"&amp;") | gsub("<";"&lt;") | gsub(">";"&gt;") | if length > 50 then .[0:47] + "..." else . end) ] | map(tostring | gsub("[\t\n\u001f]"; " ")) | join("\u001f")' "$arq" 2>/dev/null || printf 'ativo%s%s%s%s' "$US" "$US" "$US" "$US")"
    IFS="$US" read -r estado dir atualizado ramo tarefa <<<"$dados"
    # Ou o processo ainda responde, ou o ciclo terminou e o resultado fica à
    # vista até alguém encerrar a sessão.
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$estado" "$s" "$dir" "$atualizado" "$ramo" "$tarefa"
    elif guardado "$estado" "$atualizado"; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$estado" "$s" "$dir" "$atualizado" "$ramo" "$tarefa"
    fi
  done
}

# Remove arquivos de estado de sessões que já não existem. Um ciclo que terminou
# em "concluido" ou "aguardando" não é órfão: é resultado, e fica até alguém
# encerrar a sessão no seletor ou até vencer o prazo.
limpar_orfaos() {
  local arq s vivas pid estado atualizado
  vivas="$(sessoes_vivas)"
  for arq in "$estado_dir"/*.json; do
    [[ -e "$arq" ]] || continue
    s="$(basename "$arq" .json)"
    if grep -qxF "$s" <<<"$vivas"; then
      continue
    fi
    pid="$(jq -r '.pid // empty' "$arq" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    estado="$(jq -r '.estado // ""' "$arq" 2>/dev/null || true)"
    atualizado="$(jq -r '.atualizado // ""' "$arq" 2>/dev/null || true)"
    if guardado "$estado" "$atualizado"; then
      continue
    fi
    # Sessão de agente (sem pid; o do par tem) que estava em andamento quando o
    # tmux morreu: vira interrompida em vez de sumir, para o --restaurar.
    if [[ -z "$pid" ]] && [[ "$estado" != interrompido ]] && restauravel "$arq"; then
      marcar "$arq" interrompido "tmux encerrado com o agente em $estado"
      continue
    fi
    rm -f "$arq"
  done
}

# Sessão que dá para reabrir: agente de terminal (o par não tem sessão no
# tmux) com a pasta ainda no disco.
restauravel() {
  local arq="$1" agente dir
  agente="$(jq -r '.agente // ""' "$arq" 2>/dev/null || true)"
  dir="$(jq -r '.dir // ""' "$arq" 2>/dev/null || true)"
  [[ -n "$agente" && "$agente" != par && -n "$dir" && -d "$dir" ]]
}

marcar() {
  local arq="$1" tmp
  tmp="$(mktemp "$arq.XXXXXX")" || return 0
  if jq --arg e "$2" --arg m "$3" --arg a "$(date -Is)" \
       '.estado = $e | .mensagem = $m | .atualizado = $a' "$arq" >"$tmp" 2>/dev/null; then
    mv "$tmp" "$arq"
  else
    rm -f "$tmp"
  fi
}

# Reabre a sessão S no tmux: na mesma pasta, com o mesmo agente e, no Claude
# Code, na mesma conversa. Sem o id (instalação sem o hook novo) usa
# --continue, que retoma a conversa mais recente daquela pasta.
restaurar() {
  local s="$1" arq agente dir conversa cmd
  arq="$estado_dir/$s.json"
  if "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
    return 0
  fi
  [[ -f "$arq" ]] || { echo "sem estado para $s" >&2; return 1; }
  restauravel "$arq" || { echo "$s não pode ser restaurada (ciclo em par, ou pasta ausente)" >&2; return 1; }
  agente="$(jq -r '.agente' "$arq")"
  dir="$(jq -r '.dir' "$arq")"
  conversa="$(jq -r '.conversa // ""' "$arq")"
  cmd="$(jq -r '.comando // ""' "$arq")"
  [[ -n "$cmd" ]] || { cmd="$agente"; [[ -n "$JANGADA_AGENTE_ARGS" ]] && cmd+=" $JANGADA_AGENTE_ARGS"; }
  if [[ "$(basename "${agente%% *}")" == claude ]]; then
    if [[ -n "$conversa" ]]; then
      cmd+=" --resume $(printf '%q' "$conversa")"
    else
      cmd+=" --continue"
    fi
  fi
  # O ambiente do perfil é relido do arquivo, e não guardado no estado: pode
  # trazer chave de API.
  local -a amb=(-e "JANGADA_SESSAO=$s")
  local perfil v
  perfil="$(jq -r '.perfil // ""' "$arq")"
  if [[ -n "$perfil" ]] && jangada_perfil "$perfil"; then
    for v in "${PERFIL_AMBIENTE[@]}"; do amb+=(-e "$v"); done
  fi
  "${JANGADA_TMUX[@]}" new-session -d -s "$s" -c "$dir" "${amb[@]}"
  marcar "$arq" iniciado "restaurada"
  "${JANGADA_TMUX[@]}" send-keys -t "=$s:" "$cmd" Enter
  echo "restaurada: $s"
}

# Histórico de foco, para o --anterior: uma sessão por linha, a mais recente
# no fim, sem repetição seguida.
historico="$estado_dir/foco.historico"
registrar_foco() {
  local ultimo=""
  [[ -f "$historico" ]] && ultimo="$(tail -n1 "$historico")"
  [[ "$ultimo" == "$1" ]] && return 0
  { [[ -f "$historico" ]] && tail -n 19 "$historico"; printf '%s\n' "$1"; } >"$historico.tmp" \
    && mv "$historico.tmp" "$historico"
}

anterior() {
  local atual="" s
  [[ -f "$historico" ]] || { echo "nenhum agente focado ainda"; return 0; }
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    atual="$(hyprctl activewindow -j 2>/dev/null | jq -r '.title // empty' 2>/dev/null || true)"
  fi
  # Da mais recente para a mais antiga: a primeira que ainda existe e não é a
  # janela em foco. Assim, repetir o atalho alterna entre os dois últimos.
  while read -r s; do
    [[ -n "$s" && "$s" != "$atual" ]] || continue
    "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null || continue
    focar "$s"
    return 0
  done < <(tac "$historico")
  notify-send -a jangada "Agentes" "nenhum agente anterior" 2>/dev/null || echo "nenhum agente anterior"
}

focar() {
  local s="$1" endereco=""
  if [[ -f "$estado_dir/$s.json" ]] && ! "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null \
     && restauravel "$estado_dir/$s.json"; then
    restaurar "$s" >/dev/null || true
  fi
  "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null && registrar_foco "$s"
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    endereco="$(hyprctl clients -j 2>/dev/null | jq -r --arg s "$s" 'map(select(.title == $s or (.title | test($s)))) | .[0].address // empty' 2>/dev/null || true)"
  fi
  if [[ -n "$endereco" ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$endereco\" })" >/dev/null
  elif "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
    setsid -f "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.agente \
      -e "${JANGADA_TMUX[@]}" attach -t "=$s" >/dev/null 2>&1
  fi
}

# Próximo agente que pede atenção. Ordem: quem espera resposta, do mais antigo
# para o mais novo, e depois quem terminou, do mais recente para o mais velho.
# Sem estado guardado entre chamadas: se a janela em foco já é uma das
# candidatas, vai para a seguinte, então apertar de novo percorre a fila.
proximo() {
  local linhas atual i n alvo=""
  local -a fila=()
  limpar_orfaos
  linhas="$(listar)"
  # "atualizado" vem de date -Is, que ordena como texto.
  mapfile -t fila < <(
    awk -F'\t' '$1=="aguardando" {print $4 "\t" $2}' <<<"$linhas" | sort | cut -f2
    awk -F'\t' '$1=="concluido" {print $4 "\t" $2}' <<<"$linhas" | sort -r | cut -f2
  )
  n="${#fila[@]}"
  if ((n == 0)) || [[ -z "${fila[0]}" ]]; then
    notify-send -a jangada "Agentes" "nenhum agente esperando" 2>/dev/null || echo "nenhum agente esperando"
    return 0
  fi

  atual=""
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    atual="$(hyprctl activewindow -j 2>/dev/null | jq -r '.title // empty' 2>/dev/null || true)"
  fi
  alvo="${fila[0]}"
  for ((i = 0; i < n; i++)); do
    if [[ "${fila[i]}" == "$atual" ]]; then
      alvo="${fila[(i + 1) % n]}"
      break
    fi
  done

  # Ciclo em par, ou agente cujo processo saiu: não há terminal para focar.
  # O seletor mostra o resultado na prévia e oferece o Ctrl+X.
  if "${JANGADA_TMUX[@]}" has-session -t "=$alvo" 2>/dev/null; then
    focar "$alvo"
  else
    "$0" --janela
  fi
}

# Conteúdo do painel de prévia do seletor. Existe como ação própria porque o
# fzf roda a prévia com o $SHELL do usuário: no zsh, uma palavra começando com
# "=" (como o "-t =sessao:" do tmux) dispara a expansão de igual e o comando
# morre antes de rodar, com "zsh:1: <nome da sessao>".
previa() {
  local s="$1" arq estado msg
  arq="$estado_dir/$s.json"

  # Sessão viva: o que está na tela do agente.
  if "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
    "${JANGADA_TMUX[@]}" capture-pane -p -t "=$s:" 2>/dev/null | tail -40
    return 0
  fi

  if [[ ! -f "$arq" ]]; then
    echo "sem informação sobre $s"
    return 0
  fi

  estado="$(jq -r '.estado // "?"' "$arq" 2>/dev/null || echo "?")"
  msg="$(jq -r '.mensagem // ""' "$arq" 2>/dev/null || true)"
  echo "estado:   $estado"
  [[ -n "$msg" ]] && echo "mensagem: $msg"
  # Só a primeira linha da tarefa: o prompt de um ciclo em par tem dezenas de
  # linhas e encheria o painel inteiro.
  jq -r '
    (if .ramo     then "ramo:     " + .ramo     else empty end),
    (if .worktree then "worktree: " + .worktree else empty end),
    (if .tarefa   then "tarefa:   " + ((.tarefa | split("\n") | .[0])[0:120]) else empty end)
  ' "$arq" 2>/dev/null || true
  if restauravel "$arq"; then
    echo "(sem processo; Enter restaura, Alt+I integra, Ctrl+X remove o worktree)"
  else
    echo "(sessão encerrada; Alt+I integra, Ctrl+X remove o worktree e mantém o ramo)"
  fi

  # Ciclo em par: o que resta de útil é o parecer da última rodada e a
  # avaliação que o Claude fez dele, quando houver.
  local parecer avaliacao
  parecer="$(mais_recente "$estado_dir/parecer-$s-r")"
  avaliacao="$(mais_recente "$estado_dir/avaliacao-$s-r")"
  if [[ -n "$parecer" ]]; then
    echo ""
    echo "--- $(basename "$parecer") ---"
    head -60 "$parecer"
  fi
  if [[ -n "$avaliacao" ]]; then
    echo ""
    echo "--- $(basename "$avaliacao") ---"
    head -60 "$avaliacao"
  fi
}

# Arquivo PREFIXO<n>.md de maior n. Glob em vez de ls: sem correspondência o
# padrão volta literal, e o teste de existência descarta esse caso. A ordenação
# por versão mantém r10 depois de r2, que a ordem de texto do glob inverteria.
mais_recente() {
  local -a achados=()
  local a
  for a in "$1"*.md; do
    [[ -e "$a" ]] && achados+=("$a")
  done
  ((${#achados[@]})) || return 0
  printf '%s\n' "${achados[@]}" | sort -V | tail -1
}

icone() {
  case "$1" in
    aguardando) printf '󰂞' ;;
    trabalhando) printf '󰑮' ;;
    concluido) printf '󰄬' ;;
    interrompido) printf '󰜺' ;;
    *) printf '󰚩' ;;
  esac
}

case "${1:-}" in
  --lista)
    listar
    ;;
  --waybar)
    limpar_orfaos
    linhas="$(listar)"
    if [[ -z "$linhas" ]]; then
      jq -cn '{text:"󰚩 0", tooltip:"nenhum agente ativo\n\nSUPER+A: novo agente\nSUPER+P: tarefa em par\nSUPER+SHIFT+A: lista de agentes", class:"vazio"}'
      exit 0
    fi
    total="$(wc -l <<<"$linhas")"
    aguardando="$(awk -F'\t' '$1=="aguardando"' <<<"$linhas" | wc -l)"
    trabalhando="$(awk -F'\t' '$1=="trabalhando"' <<<"$linhas" | wc -l)"
    concluido="$(awk -F'\t' '$1=="concluido"' <<<"$linhas" | wc -l)"
    interrompido="$(awk -F'\t' '$1=="interrompido"' <<<"$linhas" | wc -l)"
    # Precedência do que pede atenção: quem espera resposta vem antes de quem
    # está rodando, e o que já terminou bem fica por último.
    classe="ativo"
    ((concluido > 0)) && classe="concluido"
    ((trabalhando > 0)) && classe="trabalhando"
    ((aguardando > 0)) && classe="aguardando"
    texto="󰚩 $total"
    ((trabalhando > 0)) && texto+="  󰑮 $trabalhando"
    ((aguardando > 0)) && texto+="  󰂞 $aguardando"
    ((concluido > 0)) && texto+="  󰄬 $concluido"
    ((interrompido > 0)) && texto+="  󰜺 $interrompido"
    dica="󰚩 Sessões de agentes ($total):"
    cont=0
    while IFS="$US" read -r est s _dir _atz ramo tarefa; do
      [[ -n "$s" ]] || continue
      cont=$((cont + 1))
      if ((cont > 10)); then
        continue
      fi
      case "$est" in
        aguardando) simb="󰂞" ;;
        trabalhando) simb="󰑮" ;;
        concluido) simb="󰄬" ;;
        interrompido) simb="󰜺" ;;
        *) simb="●" ;;
      esac
      dica+=$'\n\n'"$simb $s [$est]"
      [[ -n "$ramo" ]] && dica+=$'\n   ramo: '"$ramo"
      [[ -n "$tarefa" ]] && dica+=$'\n   tarefa: '"$tarefa"
    done < <(campos "$linhas")
    if ((total > 10)); then
      dica+=$'\n\n... e mais '"$((total - 10))"' sessões'
    fi
    dica+=$'\n\nClique: lista de agentes · Clique direito: painel'
    jq -cn --arg t "$texto" --arg d "$dica" --arg c "$classe" '{text:$t, tooltip:$d, class:$c}'
    ;;
  --focar)
    focar "${2:?informe a sessão}"
    ;;
  --previa)
    previa "${2:?informe a sessão}"
    ;;
  --proximo)
    proximo
    ;;
  --anterior)
    anterior
    ;;
  --restaurar)
    limpar_orfaos
    if [[ -n "${2:-}" ]]; then
      restaurar "$2"
    else
      n=0
      while IFS=$'\t' read -r est s _resto; do
        [[ "$est" == interrompido ]] || continue
        restaurar "$s" && n=$((n + 1))
      done < <(listar)
      echo "sessões restauradas: $n"
    fi
    ;;
  --janela)
    # Solto do processo que chamou, como no --painel. A waybar espera o fim do
    # on-click antes de rodar o exec do módulo de novo, então um terminal em
    # primeiro plano congelava o contador da barra onde houve o clique
    # enquanto a lista ficasse aberta.
    setsid -f "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.lista -e "$0" >/dev/null 2>&1
    ;;
  --painel)
    if ! hyprctl clients -j | jq -e 'any(.class == "org.jangada.painel")' >/dev/null; then
      setsid -f "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.painel -e "$0" --monitor >/dev/null 2>&1
      sleep 0.4
    fi
    hyprctl dispatch 'hl.dsp.workspace.toggle_special("agentes")' >/dev/null
    ;;
  --monitor)
    while true; do
      clear
      printf 'AGENTES  (%s)\n\n' "$(date +%H:%M:%S)"
      limpar_orfaos
      linhas="$(listar)"
      if [[ -z "$linhas" ]]; then
        echo "nenhum agente ativo. SUPER+A inicia um."
      else
        while IFS="$US" read -r estado s dir atualizado _resto; do
          printf '%s  %-12s %-32s %s\n' "$(icone "$estado")" "$estado" "$s" "${atualizado:11:8}"
        done < <(campos "$linhas")
        # O estado é o primeiro campo da linha.
        if grep -qE '^(concluido|aguardando)' <<<"$linhas"; then
          printf '\nciclo encerrado fica na lista. Ctrl+X no seletor encerra a\n'
          printf 'sessão e remove o worktree; sozinho, sai em %sh.\n' "$guardar_horas"
        fi
      fi
      sleep 2
    done
    ;;
  "")
    limpar_orfaos
    escolha="$(listar | awk -F'\t' '{printf "%s\t%s\t%s\n", $1, $2, $3}' | fzf \
      --delimiter '\t' --with-nth 1,2 --prompt 'agente > ' --reverse \
      --header 'Enter: abrir (ou restaurar)   Alt+I: integrar e encerrar   Ctrl+X: encerrar' \
      --expect ctrl-x,alt-i \
      --preview "'$0' --previa {2}")" || exit 0
    tecla="$(head -1 <<<"$escolha")"
    s="$(sed -n 2p <<<"$escolha" | cut -f2)"
    [[ -n "$s" ]] || exit 0
    case "$tecla" in
      ctrl-x) exec "$JANGADA_PATH/bin/jangada-agente-fim" "$s" ;;
      alt-i) exec "$JANGADA_PATH/bin/jangada-agente-fim" --integrar "$s" ;;
    esac
    focar "$s"
    ;;
  -h|--ajuda)
    sed -n '2,25s/^# \{0,1\}//p' "$0"
    ;;
  *)
    echo "opção desconhecida: $1" >&2; exit 1
    ;;
esac
