#!/usr/bin/env bash
# Menu central do jangada (fuzzel no modo "componentes").
# Uso: jangada-menu [area-transferencia]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

menu() {
  jangada_fuzzel --prompt "${1:-jangada} > "
}
b="$JANGADA_PATH/bin"
term() { setsid -f "$b/jangada-terminal" -e bash -c "$1; echo; read -r -p 'Enter para fechar'" >/dev/null 2>&1; }

if [[ "${1:-}" == "area-transferencia" ]]; then
  cliphist list | menu "copiar" | cliphist decode | wl-copy
  exit 0
fi

opcao="$(printf '%s\n' \
  "Jangada Shell (Console de agentes)" \
  "Novo agente" \
  "Tarefa em par (Claude + Antigravity)" \
  "Lista de agentes" \
  "Painel de agentes" \
  "Monitor do sistema" \
  "Energia e bateria" \
  "Dispositivos de áudio" \
  "Bluetooth" \
  "Rede e conexões" \
  "Calendário" \
  "Atualizar sistema" \
  "Verificar sistema" \
  "Snapshot manual" \
  "Trocar papel de parede" \
  "Configurar tela de login (SDDM)" \
  "Recarregar configuração" \
  "Área de transferência" \
  "Atalhos do teclado" \
  "Bloquear tela" \
  "Suspender" \
  "Reiniciar" \
  "Desligar" \
  "Sair da sessão" | menu)" || exit 0

case "$opcao" in
  "Jangada Shell (Console de agentes)") exec "$b/jangada-shell" --janela ;;
  "Novo agente") exec "$b/jangada-agente" --janela ;;
  "Tarefa em par (Claude + Antigravity)") exec "$b/jangada-par" --janela ;;
  "Lista de agentes") exec "$b/jangada-agentes" --janela ;;
  "Painel de agentes") exec "$b/jangada-agentes" --painel ;;
  "Monitor do sistema") exec "$b/jangada-monitor" ;;
  "Energia e bateria") exec "$b/jangada-energia" ;;
  "Dispositivos de áudio") exec "$b/jangada-audio" ;;
  "Bluetooth") exec "$b/jangada-bluetooth" ;;
  "Rede e conexões") exec "$b/jangada-rede" ;;
  "Calendário") exec "$b/jangada-calendario" ;;
  "Atualizar sistema") term "$b/jangada-update" ;;
  "Verificar sistema") term "$b/jangada-verificar" ;;
  "Snapshot manual") term "read -r -p 'descrição: ' d; $b/jangada-snapshot \"\$d\"" ;;
  "Trocar papel de parede") exec "$b/jangada-tema" --escolher ;;
  "Configurar tela de login (SDDM)") term "$b/jangada-sddm aplicar" ;;
  "Recarregar configuração") exec "$b/jangada-recarregar" ;;
  "Área de transferência") exec "$0" area-transferencia ;;
  "Atalhos do teclado") exec "$b/jangada-atalhos" ;;
  "Bloquear tela"|"Bloquear") exec "$b/jangada-bloquear" ;;
  "Suspender") systemctl suspend ;;
  "Reiniciar")
    if printf '%s\n' "Não" "Sim, reiniciar" | menu "confirmar" | grep -q "Sim"; then
      systemctl reboot
    fi
    ;;
  "Desligar")
    if printf '%s\n' "Não" "Sim, desligar" | menu "confirmar" | grep -q "Sim"; then
      systemctl poweroff
    fi
    ;;
  "Sair da sessão")
    if printf '%s\n' "Não" "Sim, sair da sessão" | menu "confirmar" | grep -q "Sim"; then
      hyprctl dispatch 'hl.dsp.exit()'
    fi
    ;;
esac
