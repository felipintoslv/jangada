#!/usr/bin/env bash
# Carrega as preferências do jangada. Uso em outros scripts:
#   source "$(dirname "$0")/jangada-config"
# Executado diretamente, mostra os valores efetivos.

JANGADA_PATH="${JANGADA_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
JANGADA_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/jangada"
JANGADA_ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/jangada"

# Valores padrão, substituídos pelo arquivo do usuário se ele existir.
JANGADA_INTERFACE=componentes
JANGADA_CENTRAL="${JANGADA_CENTRAL:-tarefas}"
JANGADA_TERMINAL=
JANGADA_AGENTE=claude
JANGADA_AGENTE_ARGS=
JANGADA_VALIDAR_REVISOR="${JANGADA_VALIDAR_REVISOR:-}"
# Agente dentro do bubblewrap (jangada-isolar): 1 liga, 0 desliga. Pastas a
# mais que o agente pode gravar, separadas por ":". O JANGADA_ISOLAR_OCULTAR
# fica sem valor padrão de propósito: ausente, o jangada-isolar usa a lista
# dele; definido, mesmo vazio, substitui a lista.
JANGADA_AGENTE_ISOLAR="${JANGADA_AGENTE_ISOLAR:-1}"
JANGADA_ISOLAR_ESCRITA="${JANGADA_ISOLAR_ESCRITA:-}"
JANGADA_DELEGAR="${JANGADA_DELEGAR:-}"
JANGADA_PROJETOS="$HOME/Projetos"
JANGADA_WORKTREES="$HOME/.local/share/jangada-worktrees"
JANGADA_PAPEL=
# Como o papel de parede ocupa uma tela de proporção diferente da imagem:
# espelho (completa as laterais com o reflexo da borda), desfoque (com a
# própria imagem ampliada e desfocada), cor (com a cor de fundo do tema) ou
# cobrir (amplia até cobrir a tela e corta o que sobra).
JANGADA_PAPEL_AJUSTE=espelho
# Esquema do matugen usado pelo jangada-tema. O fidelity mantém a cor da
# imagem; o tonal-spot, padrão do matugen, satura as cores de imagens quase
# monocromáticas até virarem outra cor.
JANGADA_TEMA_ESQUEMA=scheme-fidelity
# Borda em que a barra fica: topo, base, esquerda ou direita. Gravado pelo
# jangada-barra --posicao.
JANGADA_BARRA_POSICAO=topo
# Dispositivo DRM que conduz a sessão. Vazio = detectar pela saída conectada.
JANGADA_GPU=
# Cópia de trabalho do jangada (onde se edita e faz commit), usada pelo
# jangada-verificar --agente. Vazio = $JANGADA_PROJETOS/jangada, se existir,
# ou o origin da cópia instalada, se for uma pasta local.
JANGADA_REPO=
# Ramo que o jangada-update acompanha na cópia instalada: main (tudo o que
# entrou) ou estavel (só o que foi marcado como testado).
JANGADA_CANAL=main
# Chave SSH com que o jangada-assinar assina os commits (a pública ao lado,
# com .pub).
JANGADA_ASSINATURA_CHAVE="$HOME/.ssh/id_ed25519"
# Porta local do painel de indicadores (jangada-painel), ouvida só em 127.0.0.1.
JANGADA_PAINEL_PORTA="${JANGADA_PAINEL_PORTA:-8765}"
# Executor econômico Codex, desabilitado sem modelo explicitamente escolhido.
JANGADA_CODEX_ECONOMICO_MODELO="${JANGADA_CODEX_ECONOMICO_MODELO:-}"
JANGADA_CODEX_PRINCIPAL_MODELO="${JANGADA_CODEX_PRINCIPAL_MODELO:-}"
JANGADA_CODEX_COTA_MIN="${JANGADA_CODEX_COTA_MIN:-25}"
# Modelos do agy na delegação, em ordem de tentativa: o seguinte entra quando
# a cota do anterior acaba. Os gemini-* dividem uma cota; os demais, outra.
JANGADA_DELEGAR_MODELOS="${JANGADA_DELEGAR_MODELOS:-gemini-3.8-flash-high claude-sonnet-5-5-high gpt-oss-120b-medium}"
# Delegação local (modelo no Ollama) para leitor e redator.
JANGADA_LOCAL_MODELO="${JANGADA_LOCAL_MODELO:-qwen3:4b}"
JANGADA_LOCAL_CTX="${JANGADA_LOCAL_CTX:-8192}"
JANGADA_LOCAL_VRAM_MIN="${JANGADA_LOCAL_VRAM_MIN:-4000}"
JANGADA_LOCAL_KEEP_ALIVE="${JANGADA_LOCAL_KEEP_ALIVE:-2m}"
JANGADA_LOCAL_ESPERA="${JANGADA_LOCAL_ESPERA:-30}"
JANGADA_OLLAMA_URL="${JANGADA_OLLAMA_URL:-http://localhost:11434}"
JANGADA_LOCAL_FATIAS_MAX="${JANGADA_LOCAL_FATIAS_MAX:-5}"

if [[ -f "$JANGADA_CONFIG/jangada.conf" ]]; then
  # Lê só linhas CHAVE=valor com chaves JANGADA_*, sem executar o arquivo.
  while IFS='=' read -r _chave _valor; do
    [[ "$_chave" =~ ^JANGADA_[A-Z_]+$ ]] || continue
    _valor="${_valor/#\$HOME/$HOME}"
    _valor="${_valor/#\~/$HOME}"
    printf -v "$_chave" '%s' "$_valor"
  done < <(sed -e 's/^[[:space:]]*#.*//' -e 's/[[:space:]]*$//' "$JANGADA_CONFIG/jangada.conf")
  unset _chave _valor
fi
case "$JANGADA_CENTRAL" in
  tarefas|agentes) ;;
  *) printf 'jangada: JANGADA_CENTRAL inválido (%s); usando tarefas.\n' "$JANGADA_CENTRAL" >&2
     JANGADA_CENTRAL=tarefas ;;
esac
if [[ -z "$JANGADA_REPO" && -d "$JANGADA_PROJETOS/jangada/.git" ]]; then
  JANGADA_REPO="$JANGADA_PROJETOS/jangada"
fi
# Máquina com os projetos em outra pasta: a cópia instalada foi clonada da de
# trabalho, então o origin dela, quando é uma pasta local, é a cópia de trabalho.
if [[ -z "$JANGADA_REPO" && -f "$JANGADA_PATH/.git/config" ]]; then
  _origem="$(git config -f "$JANGADA_PATH/.git/config" remote.origin.url 2>/dev/null || true)"
  [[ "$_origem" == /* && -d "$_origem/.git" ]] && JANGADA_REPO="$_origem"
  unset _origem
fi

export JANGADA_CODEX_ECONOMICO_MODELO JANGADA_CODEX_PRINCIPAL_MODELO JANGADA_CODEX_COTA_MIN JANGADA_DELEGAR_MODELOS
export JANGADA_PATH JANGADA_CONFIG JANGADA_ESTADO JANGADA_INTERFACE JANGADA_CENTRAL JANGADA_TERMINAL \
  JANGADA_AGENTE JANGADA_AGENTE_ARGS JANGADA_VALIDAR_REVISOR JANGADA_PROJETOS JANGADA_WORKTREES JANGADA_PAPEL \
  JANGADA_PAPEL_AJUSTE JANGADA_TEMA_ESQUEMA JANGADA_BARRA_POSICAO JANGADA_GPU \
  JANGADA_REPO JANGADA_CANAL JANGADA_AGENTE_ISOLAR JANGADA_ISOLAR_ESCRITA JANGADA_DELEGAR JANGADA_PAINEL_PORTA \
  JANGADA_ASSINATURA_CHAVE JANGADA_LOCAL_MODELO JANGADA_LOCAL_CTX JANGADA_LOCAL_VRAM_MIN \
  JANGADA_LOCAL_KEEP_ALIVE JANGADA_LOCAL_ESPERA JANGADA_OLLAMA_URL JANGADA_LOCAL_FATIAS_MAX
# Só quando definido: ausente e vazio têm sentidos diferentes no jangada-isolar.
if [[ -n "${JANGADA_ISOLAR_OCULTAR+x}" ]]; then export JANGADA_ISOLAR_OCULTAR; fi

# Dispositivos DRM com saída de vídeo conectada, um por linha, em caminho
# estável (/dev/dri/by-path, porque a numeração de /dev/dri/cardN muda entre
# partidas). Numa máquina com duas GPUs, o aquamarine pode escolher a que não
# tem monitor ligado; a sessão sobe sem imagem e sem terminal para consertar.
gpu_das_saidas() {
  local _st _card _pci _dev
  local -a _achados=()
  for _st in /sys/class/drm/card*-*/status; do
    [[ -r "$_st" ]] || continue
    [[ "$(<"$_st")" == connected ]] || continue
    _card="${_st#/sys/class/drm/}"; _card="${_card%%-*}"
    _pci="$(readlink -f "/sys/class/drm/$_card/device" 2>/dev/null)" || continue
    _pci="${_pci##*/}"
    _dev="/dev/dri/by-path/pci-$_pci-card"
    [[ -e "$_dev" ]] || continue
    [[ " ${_achados[*]:-} " == *" $_dev "* ]] || _achados+=("$_dev")
  done
  ((${#_achados[@]})) || return 1
  printf '%s\n' "${_achados[@]}"
}

# Valor de AQ_DRM_DEVICES para os dispositivos recebidos. O aquamarine separa
# essa lista por ":", e o nome em /dev/dri/by-path traz ":" no endereço PCI:
# entregue como está, um caminho vira três caminhos inválidos, o aquamarine não
# encontra GPU nenhuma e o Hyprland aborta antes de abrir a tela. Por isso cada
# dispositivo é resolvido para o /dev/dri/cardN correspondente, que não tem ":".
gpu_para_aquamarine() {
  local _dev _real
  local -a _reais=()
  for _dev in "$@"; do
    [[ -n "$_dev" ]] || continue
    _real="$(readlink -f "$_dev" 2>/dev/null)" || continue
    [[ -e "$_real" ]] || continue
    [[ "$_real" == *:* ]] && continue
    [[ " ${_reais[*]:-} " == *" $_real "* ]] || _reais+=("$_real")
  done
  ((${#_reais[@]})) || return 1
  local IFS=:
  printf '%s\n' "${_reais[*]}"
}

# Driver do kernel em uso por um dispositivo DRM, dado em /dev/dri/by-path ou
# já resolvido em /dev/dri/cardN.
driver_da_gpu() {
  local _real _drv
  _real="$(readlink -f "${1:-}" 2>/dev/null)" || return 1
  [[ -e "$_real" ]] || return 1
  _drv="$(readlink -f "/sys/class/drm/${_real##*/}/device/driver" 2>/dev/null)" || return 1
  printf '%s\n' "${_drv##*/}"
}

# Abre o fuzzel no modo dmenu com o tema do jangada, repassando os argumentos
# recebidos. O "--config" só entra quando o arquivo existe. Cobrir a ausência
# dele com "fuzzel --config ... || fuzzel" reabre o menu quando o usuário
# cancela, porque o fuzzel sai com 1 nos dois casos: erro de configuração e
# nenhuma seleção. Quem chama continua distinguindo cancelamento pelo código
# de saída 1.
jangada_fuzzel() {
  local _cfg="$JANGADA_CONFIG/fuzzel/fuzzel.ini"
  if [[ -r "$_cfg" ]]; then
    fuzzel --dmenu --config "$_cfg" "$@"
  else
    fuzzel --dmenu "$@"
  fi
}

# Perfil de agente: ~/.config/jangada/agentes/NOME.conf, com linhas CHAVE=valor.
# COMANDO e ARGS montam o comando; qualquer outra chave em maiúsculas vira
# variável de ambiente da sessão (por exemplo ANTHROPIC_MODEL). O arquivo é
# lido, não executado. Preenche PERFIL_COMANDO, PERFIL_ARGS e PERFIL_AMBIENTE
# (lista de CHAVE=valor); falha se o perfil não existir.
# shellcheck disable=SC2034  # PERFIL_* são lidas por quem carrega este arquivo
jangada_perfil() {
  local _arq="$JANGADA_CONFIG/agentes/$1.conf" _chave _valor
  PERFIL_COMANDO=""; PERFIL_ARGS=""; PERFIL_DESCRICAO=""; PERFIL_AMBIENTE=()
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
  # O perfil do usuário tem precedência; sem ele, vale o do repositório
  # (default/agentes), como o agy.conf.
  [[ -r "$_arq" ]] || _arq="$JANGADA_PATH/default/agentes/$1.conf"
  [[ -r "$_arq" && "$1" != exemplo ]] || return 1
  while IFS='=' read -r _chave _valor; do
    [[ "$_chave" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
    _valor="${_valor/#\$HOME/$HOME}"
    _valor="${_valor/#\~/$HOME}"
    case "$_chave" in
      COMANDO) PERFIL_COMANDO="$_valor" ;;
      ARGS) PERFIL_ARGS="$_valor" ;;
      DESCRICAO) PERFIL_DESCRICAO="$_valor" ;;
      *) PERFIL_AMBIENTE+=("$_chave=$_valor") ;;
    esac
  done < <(sed -e 's/^[[:space:]]*#.*//' -e 's/[[:space:]]*$//' "$_arq")
  [[ -n "$PERFIL_COMANDO" ]] || PERFIL_COMANDO="$JANGADA_AGENTE"
}

# Destino dos subagentes de uma sessão: agy (jangada-delegar manda ao agy),
# claude (subagentes do Claude) ou local (leitor e redator no Ollama, demais
# papéis na própria sessão).
# Uso: jangada_delegacao COMANDO [JANGADA_DELEGAR]. Sem valor, vale agy para o
# Claude e local para o Codex, que só aceita agy ou local. Sem o agy
# instalado, agy vira claude, para o protocolo não mandar a um comando que só
# recusaria. O agy não abre mais sessão principal: nativo (subagentes do
# próprio agy) só aparece ao restaurar uma sessão antiga, e no Claude vira
# claude.
jangada_delegacao() {
  local _base _valor="${2:-}"
  _base="$(basename "${1%% *}")"
  if [[ "$_base" == agy ]]; then
    echo nativo
    return 0
  fi
  if [[ "$_base" == codex ]]; then
    [[ "$_valor" == agy ]] && { echo agy; return 0; }
    echo local
    return 0
  fi
  case "$_valor" in
    agy|claude|local) ;;
    nativo) _valor=claude ;;
    *) _valor=agy ;;
  esac
  [[ "$_valor" == agy ]] && ! command -v agy >/dev/null 2>&1 && _valor=claude
  echo "$_valor"
}

jangada_candidatos() {
  local politica="$JANGADA_CONFIG/delegacao.json"
  [[ -f "$politica" ]] || politica="$JANGADA_PATH/default/delegacao/roteamento.json"
  jq -er --arg capacidade "$1" '
    if type == "object"
      and (keys - ["leitura_documental", "resumo_curto", "analise_documental"] | length == 0)
      and all(.[]; type == "array" and length > 0
        and length == (unique | length) and all(.[]; . == "local" or . == "agy" or . == "codex-economico"))
      and has($capacidade)
    then .[$capacidade][]
    else error("política de delegação inválida ou capacidade ausente") end
  ' "$politica"
}

jangada_revisor() {
  local base
  base="$(basename "${1%% *}")"
  case "${2:-}" in
    mesmo) echo "$base" ;;
    oposto|"")
      [[ "$base" == agy || "$base" == codex || -z "$base" ]] && echo claude || echo codex
      ;;
    *) echo "$2" ;;
  esac
}

jangada_perfis() {
  local _a
  for _a in "$JANGADA_CONFIG"/agentes/*.conf "$JANGADA_PATH"/default/agentes/*.conf; do
    [[ -e "$_a" ]] && basename "$_a" .conf
  done | grep -vx exemplo | sort -u
  return 0
}

# Gera carimbo de data ISO 8601 consistente e universal.
jangada_data_iso() {
  if date -Is >/dev/null 2>&1; then
    date -Is
  else
    local d z
    d="$(date +"%Y-%m-%dT%H:%M:%S")"
    z="$(date +"%z")"
    if [[ "$z" =~ ^([+-][0-9]{2})([0-9]{2})$ ]]; then
      echo "${d}${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
    else
      echo "${d}Z"
    fi
  fi
}

# Acrescenta uma linha ao histórico de estados dos agentes
# ($JANGADA_ESTADO/eventos-agentes.jsonl), lido pelo jangada-painel.
# Uso: jangada_registrar_evento SESSAO PROJETO AGENTE ESTADO [EXTRA]. EXTRA é
# um objeto JSON com campos a mais, acrescentados depois dos cinco de sempre.
# Nunca falha: é chamado de dentro dos hooks. Uma linha curta com >> é gravada
# inteira mesmo com dois hooks ao mesmo tempo.
jangada_registrar_evento() {
  local linha
  linha="$(jq -cn --arg d "$(jangada_data_iso)" --arg s "$1" --arg p "$2" --arg a "$3" --arg e "$4" \
    --arg x "${5:-}" '{data: $d, sessao: $s, projeto: $p, agente: $a, estado: $e}
      + (($x | fromjson? | objects) // {})' 2>/dev/null)" || return 0
  [[ -n "$linha" ]] || return 0
  printf '%s\n' "$linha" 2>/dev/null >>"$JANGADA_ESTADO/eventos-agentes.jsonl" || true
  return 0
}

# git para rodar fora do isolamento sobre pastas que um agente pode gravar:
# desliga o fsmonitor e os hooks que uma configuração plantada definiria.
# É defesa a mais: a principal é o jangada-isolar manter somente leitura
# o que o git lê como configuração (config, commondir, gitdir).
_jangada_git_blindagem=(core.fsmonitor=false core.hooksPath=/dev/null core.sshCommand=ssh
  core.pager=cat safe.bareRepository=explicit)
jangada_git_seguro() {
  local c args=()
  for c in "${_jangada_git_blindagem[@]}"; do args+=(-c "$c"); done
  git "${args[@]}" "$@"
}

# O mesmo para todo git que o script e os filhos rodarem, pelas variáveis
# GIT_CONFIG_KEY_N/GIT_CONFIG_VALUE_N (valem como -c).
jangada_git_blindar() {
  local c n="${GIT_CONFIG_COUNT:-0}"
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  for c in "${_jangada_git_blindagem[@]}"; do
    export "GIT_CONFIG_KEY_$n=${c%%=*}" "GIT_CONFIG_VALUE_$n=${c#*=}"
    n=$((n + 1))
  done
  export GIT_CONFIG_COUNT="$n"
}

# Obtém trava baseada em diretório com verificação de bloqueio abandonado.
_jangada_trava_obter() {
  local trava_dir="$1" i=0
  while (( i < 50 )); do
    if mkdir "$trava_dir" 2>/dev/null; then
      return 0
    fi
    if [[ -d "$trava_dir" ]]; then
      local mtime agora
      mtime="$(stat -c %Y "$trava_dir" 2>/dev/null || stat -f %m "$trava_dir" 2>/dev/null || echo 0)"
      agora="$(date +%s)"
      if (( mtime > 0 && agora - mtime > 15 )); then
        rmdir "$trava_dir" 2>/dev/null || true
      fi
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

# O settings.json é do agy e do usuário: a primeira alteração do jangada
# guarda o original, que nunca é sobrescrito. Roda sob a trava, para não
# copiar o arquivo no meio de outra regravação.
_jangada_agy_guardar_original() {
  [[ -e "$1.jangada-orig" ]] || cp -a "$1" "$1.jangada-orig" 2>/dev/null || true
}

# Diz se o agy confia na pasta. O agy pode ter gravado o caminho com o link
# simbólico por onde a pasta foi aberta, então vale o caminho resolvido ou o
# original.
jangada_agy_confia() {
  local conf_agy="${JANGADA_AGY_SETTINGS:-$HOME/.gemini/antigravity-cli/settings.json}"
  jq -e --arg w "$(realpath "$1" 2>/dev/null || echo "$1")" --arg o "$1" \
    '(.trustedWorkspaces // []) as $t | ($t | index($w)) or ($t | index($o))' "$conf_agy" >/dev/null 2>&1
}

# Adiciona ou remove caminho de trustedWorkspaces no settings.json do Antigravity.
# Mantém travas e arquivos de trabalho isolados em JANGADA_ESTADO e preserva permissões.
jangada_agy_ajustar_confianca() {
  local modo="$1" caminho="$2"
  local conf_agy="${JANGADA_AGY_SETTINGS:-$HOME/.gemini/antigravity-cli/settings.json}"
  [[ -f "$conf_agy" && -w "$conf_agy" && -n "$caminho" ]] || return 0

  mkdir -p "$JANGADA_ESTADO"
  local caminho_real
  caminho_real="$(realpath "$caminho" 2>/dev/null || echo "$caminho")"

  local trava="$JANGADA_ESTADO/.trava-agy"
  local tmp
  tmp="$(mktemp "$JANGADA_ESTADO/settings.agy.XXXXXX" 2>/dev/null)" || return 0

  local filtro
  if [[ "$modo" == "adicionar" ]]; then
    filtro='if (.trustedWorkspaces | type == "array") then (if (.trustedWorkspaces | index($w)) then . else .trustedWorkspaces += [$w] end) else .trustedWorkspaces = [$w] end'
  else
    filtro='if (.trustedWorkspaces | type == "array") then .trustedWorkspaces |= map(select(. != $w and . != $w_orig)) else . end'
  fi

  if command -v flock >/dev/null 2>&1; then
    (
      flock -w 5 9 2>/dev/null || exit 1
      _jangada_agy_guardar_original "$conf_agy"
      if jq --arg w "$caminho_real" --arg w_orig "$caminho" "$filtro" "$conf_agy" >"$tmp" 2>/dev/null; then
        cat "$tmp" > "$conf_agy"
      fi
      rm -f "$tmp"
    ) 9>"$trava" 2>/dev/null || rm -f "$tmp"
  else
    local trava_d="$JANGADA_ESTADO/.trava-agy.d"
    if _jangada_trava_obter "$trava_d"; then
      _jangada_agy_guardar_original "$conf_agy"
      if jq --arg w "$caminho_real" --arg w_orig "$caminho" "$filtro" "$conf_agy" >"$tmp" 2>/dev/null; then
        cat "$tmp" > "$conf_agy"
      fi
      rm -f "$tmp"
      rmdir "$trava_d" 2>/dev/null || true
    else
      rm -f "$tmp"
      return 0
    fi
  fi
  return 0
}

# Executa comando ou função sob trava da pasta. A trava é a própria pasta
# aberta só para leitura: um arquivo de trava aberto para escrita seguiria um
# link simbólico posto pelo agente isolado e truncaria o alvo fora do isolamento.
# Uso: jangada_com_trava_dir DIR COMANDO [ARGUMENTOS...]
jangada_com_trava_dir() {
  local dir="$1"
  shift
  local rc=0
  if command -v flock >/dev/null 2>&1; then
    (
      flock -w 5 9 || exit 1
      "$@"
    ) 9<"$dir" || rc=$?
  else
    local trava_dir="$dir/.trava.d"
    if ! _jangada_trava_obter "$trava_dir"; then
      return 1
    fi
    "$@" || rc=$?
    rmdir "$trava_dir" 2>/dev/null || true
  fi
  return $rc
}

# Altera um arquivo de estado JSON com jq de forma atômica e segura: regrava
# com mv, sob uma trava da pasta. O hook do Claude Code roda em paralelo quando
# há ferramentas em paralelo, e o painel marca sessões interrompidas: sem a
# trava, quem lê antes e grava depois apaga o campo que o outro gravou.
# Uso: jangada_alterar_estado ARQ TMP ARGUMENTOS_DO_JQ...
jangada_alterar_estado() {
  local arq="$1" tmp="$2"
  [[ -n "$arq" && -n "$tmp" ]] || return 1
  shift 2
  local rc=0
  _aplicar_jq() {
    jq "$@" "$arq" >"$tmp" 2>/dev/null && mv "$tmp" "$arq"
  }
  jangada_com_trava_dir "$(dirname "$arq")" _aplicar_jq "$@" || rc=$?
  if ((rc == 0)); then
    pkill -RTMIN+10 -x waybar 2>/dev/null || true
  fi
  return $rc
}

# Notificação do sistema via notify-send.
jangada_notificar() {
  local titulo="$1" msg="$2"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a jangada "$titulo" "$msg" 2>/dev/null || true
  fi
}

# Foca a primeira janela da classe CLASSE e devolve 0; devolve 1 se não houver
# nenhuma (ou se não houver Hyprland). Serve para "abrir ou focar".
jangada_focar_classe() {
  local _end
  _end="$(hyprctl clients -j 2>/dev/null \
    | jq -r --arg c "$1" 'first(.[] | select(.class == $c) | .address) // empty' 2>/dev/null)"
  [[ -n "$_end" ]] || return 1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$_end\" })" >/dev/null
}

# Socket próprio do tmux para as sessões de agentes, separado do tmux pessoal.
# shellcheck disable=SC2034  # usado pelos scripts que carregam este arquivo
JANGADA_TMUX=(tmux -L jangada -f "$JANGADA_PATH/default/tmux/agentes.conf")

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  for _v in JANGADA_PATH JANGADA_CONFIG JANGADA_ESTADO JANGADA_INTERFACE JANGADA_TERMINAL \
    JANGADA_AGENTE JANGADA_AGENTE_ARGS JANGADA_VALIDAR_REVISOR JANGADA_PROJETOS JANGADA_WORKTREES JANGADA_PAPEL \
    JANGADA_PAPEL_AJUSTE JANGADA_TEMA_ESQUEMA JANGADA_BARRA_POSICAO JANGADA_GPU \
    JANGADA_REPO JANGADA_CANAL JANGADA_AGENTE_ISOLAR JANGADA_ISOLAR_ESCRITA JANGADA_DELEGAR JANGADA_PAINEL_PORTA \
    JANGADA_ASSINATURA_CHAVE; do
    printf '%s=%s\n' "$_v" "${!_v}"
  done
fi
