#!/usr/bin/env bash
# Protocolo de trabalho em par: Claude implementa, Antigravity revisa e Claude corrige.
#
# Uso: jangada-par [opções] ["tarefa a executar"]
#   --janela          abre num terminal novo (usado pelo atalho SUPER+P)
#   --projeto DIR     pula o seletor e usa este diretório
#   --nome NOME       nome curto da tarefa (ramo e pasta do worktree)
#   --direto          trabalha direto no repositório, sem criar worktree
#   --limite N        máximo de rodadas de revisão (padrão: 2)
#   --modelo MODELO   modelo do agy para a revisão
#   --esforco NÍVEL   esforço de raciocínio do agy: low, medium, high (padrão: high)
#   --snapshot        cria um snapshot do sistema antes de iniciar
# Defina NO_COLOR para desligar as cores.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

# Cores da saída. Os códigos são os mesmos de install/lib.sh, repetidos aqui
# porque o jangada-config não carrega aquele arquivo. Fora de um terminal, ou
# com NO_COLOR definido, ficam vazias e a saída vai limpa para o log.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  c_forte=$'\e[1m'; c_fraco=$'\e[2m'; c_info=$'\e[36m'
  c_ok=$'\e[32m';  c_aviso=$'\e[33m'; c_erro=$'\e[31m'; c_fim=$'\e[0m'
else
  c_forte=""; c_fraco=""; c_info=""; c_ok=""; c_aviso=""; c_erro=""; c_fim=""
fi

_linha="======================================================="
_meia="-------------------------------------------------------"

regua()  { printf '%s%s%s\n' "${1:-$c_fraco}" "$_linha" "$c_fim"; }
traco()  { printf '%s%s%s\n' "$c_fraco" "$_meia" "$c_fim"; }
titulo() { printf ' %s%s%s\n' "$c_forte" "$*" "$c_fim"; }
campo()  { printf ' %s%-12s%s %s\n' "$c_forte" "$1" "$c_fim" "$2"; }
info()   { printf '%s==>%s %s\n' "$c_info" "$c_fim" "$*"; }
bom()    { printf '%s%s==>%s %s\n' "$c_forte" "$c_ok" "$c_fim" "$*"; }
alerta() { printf '%s%s==>%s %s\n' "$c_forte" "$c_erro" "$c_fim" "$*"; }
aviso()  { printf '%s%s !!%s %s\n' "$c_forte" "$c_aviso" "$c_fim" "$*" >&2; }
erro()   { printf '%s%s !!%s %s\n' "$c_forte" "$c_erro" "$c_fim" "$*" >&2; }

janela=0; projeto=""; nome=""; direto=0; snapshot=0; limite=2
modelo=""; esforco="high"; tarefa=""

while (($#)); do
  case "$1" in
    --janela) janela=1; shift ;;
    --projeto) projeto="$2"; shift 2 ;;
    --nome) nome="$2"; shift 2 ;;
    --direto) direto=1; shift ;;
    --snapshot) snapshot=1; shift ;;
    --limite) limite="$2"; shift 2 ;;
    --modelo) modelo="$2"; shift 2 ;;
    --esforco) esforco="$2"; shift 2 ;;
    -h|--ajuda) sed -n '2,13s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --) shift; tarefa="$*"; break ;;
    *)
      if [[ -z "$tarefa" ]]; then
        tarefa="$1"; shift
      else
        tarefa+=" $1"; shift
      fi
      ;;
  esac
done

# Vindo de atalho gráfico, abre dentro de uma janela de terminal.
if ((janela)); then
  args=()
  [[ -n "$projeto" ]] && args+=(--projeto "$projeto")
  [[ -n "$nome" ]] && args+=(--nome "$nome")
  ((direto)) && args+=(--direto)
  ((snapshot)) && args+=(--snapshot)
  args+=(--limite "$limite")
  [[ -n "$modelo" ]] && args+=(--modelo "$modelo")
  args+=(--esforco "$esforco")
  [[ -n "$tarefa" ]] && args+=(-- "$tarefa")
  exec "$JANGADA_PATH/bin/jangada-terminal" --classe org.jangada.agente --titulo "Jangada Par" -e "$0" "${args[@]}"
fi

slug() { tr '[:upper:]' '[:lower:]' <<<"$1" | sed -e 's/[^a-z0-9_-]\+/-/g' -e 's/^-\+//' -e 's/-\+$//'; }

listar_projetos() {
  {
    command -v zoxide >/dev/null 2>&1 && zoxide query -l 2>/dev/null || true
    if [[ -d "$JANGADA_PROJETOS" ]]; then
      find "$JANGADA_PROJETOS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true
      find "$JANGADA_PROJETOS" -maxdepth 3 -type d -name .git -prune -printf '%h\n' 2>/dev/null || true
    fi
  } | awk '!visto[$0]++' | while read -r d; do [[ -d "$d" ]] && printf '%s\n' "$d"; done || true
}

if [[ -z "$projeto" ]]; then
  projeto="$(listar_projetos | fzf --prompt 'projeto > ' --height 60% --reverse \
    --preview 'git -C {} log --oneline -8 2>/dev/null; echo; ls {}' )" || true
  [[ -n "$projeto" ]] || exit 0
fi
projeto="$(realpath "$projeto")"
[[ -d "$projeto" ]] || { erro "diretório não encontrado: $projeto"; exit 1; }

eh_git=0
raiz="$projeto"
if git -C "$projeto" rev-parse --show-toplevel >/dev/null 2>&1; then
  eh_git=1
  raiz="$(git -C "$projeto" rev-parse --show-toplevel)"
fi
repo="$(slug "$(basename "$raiz")")"

if [[ -z "$tarefa" ]]; then
  echo ""
  campo "PROJETO:" "$raiz"
  titulo "Digite o pedido ou tarefa que deseja realizar:"
  read -r -p "tarefa > " tarefa
  [[ -n "$tarefa" ]] || { erro "tarefa vazia; encerrando"; exit 1; }
fi

if ((eh_git)) && ((!direto)) && [[ -z "$nome" ]]; then
  sugestao="$(slug "$(printf '%.30s' "$tarefa")")"
  read -r -p "nome do ramo [padrão: $sugestao]: " nome
  [[ -z "$nome" ]] && nome="$sugestao"
fi
nome="$(slug "$nome")"

sessao="$repo"
[[ -n "$nome" ]] && sessao="$repo--$nome"

estado_dir="$JANGADA_ESTADO/agentes"
mkdir -p "$estado_dir"

# Duas execuções com o mesmo nome de sessão disputam o mesmo arquivo de estado
# e apagam os arquivos uma da outra. A conferência vem antes de mexer no
# worktree, no trap e na primeira gravação: assim a segunda execução sai sem
# tocar em nada da primeira.
if [[ -f "$estado_dir/$sessao.json" ]]; then
  pid_antigo="$(jq -r '.pid // empty' "$estado_dir/$sessao.json" 2>/dev/null || true)"
  if [[ -n "$pid_antigo" ]] && kill -0 "$pid_antigo" 2>/dev/null; then
    erro "já existe um ciclo em par na sessão $sessao (pid $pid_antigo); encerre-o antes"
    exit 1
  fi
fi

dir="$raiz"; worktree=""; ramo=""; base=""
if ((eh_git)) && [[ -n "$nome" ]]; then
  worktree="$JANGADA_WORKTREES/$repo/$nome"
  ramo="agente/$nome"
  base="$(git -C "$raiz" rev-parse --abbrev-ref HEAD)"
  git -C "$raiz" worktree prune
  if [[ -d "$worktree" ]]; then
    info "reaproveitando worktree existente: $worktree"
  elif git -C "$raiz" show-ref --verify --quiet "refs/heads/$ramo"; then
    git -C "$raiz" worktree add "$worktree" "$ramo"
  else
    git -C "$raiz" worktree add -b "$ramo" "$worktree" HEAD
  fi
  dir="$worktree"
fi

# Restos de execuções anteriores com o mesmo nome de sessão. Só o que é
# descartável: o JSON bruto do agy e os logs sem conteúdo. Os pareceres ficam,
# são o que o revisor escreveu, e o resumo final aponta para o desta vez.
rm -f "$estado_dir/revisao-$sessao-r"*.json 2>/dev/null || true
for _log in "$estado_dir/revisao-$sessao-r"*.log; do
  [[ -s "$_log" ]] || rm -f "$_log"
done

agora="$(date -Is)"
jq -n --arg sessao "$sessao" --arg dir "$dir" --arg raiz "$raiz" --arg worktree "$worktree" \
  --arg ramo "$ramo" --arg base "$base" --arg agente "par" --arg tarefa "$tarefa" \
  --arg pid "$$" --arg agora "$agora" \
  '{sessao:$sessao, dir:$dir, raiz:$raiz, worktree:$worktree, ramo:$ramo, base:$base,
    agente:$agente, tarefa:$tarefa, pid:($pid|tonumber), estado:"trabalhando", mensagem:"iniciando ciclo em par",
    desde:$agora, atualizado:$agora}' \
  >"$estado_dir/$sessao.json"

# O estado só é descartado quando o ciclo termina mal: interrompido, ou morto
# antes de gravar o resultado. Terminando normalmente o arquivo fica com
# "concluido" ou "aguardando", que é o que acende o ícone no jangada-agentes.
# O painel ainda recolhe o arquivo quando vê que o pid morreu, mas não faz
# sentido o próprio script apagar o que acabou de escrever.
#
# Só EXIT, de propósito. Um trap em INT ou TERM não encerra nada: o bash roda
# o handler e segue na linha seguinte, então o Ctrl+C apagaria o estado e
# deixaria o ciclo rodando. Sem trap próprio, o sinal encerra o script pelo
# comportamento padrão e o EXIT dispara em seguida.
concluiu=0
limpar_saida() {
  # Os temporários do atualizar_estado somem sempre; o arquivo de estado, só
  # quando o ciclo não chegou a gravar um resultado.
  rm -f "$estado_dir/$sessao.json."?????? 2>/dev/null || true
  if ((concluiu)); then return 0; fi
  rm -f "$estado_dir/$sessao.json" 2>/dev/null || true
}
trap limpar_saida EXIT

atualizar_estado() {
  local est="$1" msg="$2"
  local arq="$estado_dir/$sessao.json"
  local tmp
  # Escreve no temporário e troca com mv, nos dois ramos: o painel nunca lê um
  # arquivo pela metade. O temporário fica ao lado do alvo porque o mv só é
  # atômico dentro do mesmo sistema de arquivos, e porque um resto de processo
  # morto cai onde o trap de saída olha.
  tmp="$(mktemp "$arq.XXXXXX" 2>/dev/null)" || {
    aviso "não consegui criar o temporário do estado em $estado_dir"
    return 0
  }
  if [[ -f "$arq" ]]; then
    jq --arg e "$est" --arg m "$msg" --arg a "$(date -Is)" \
      '.estado = $e | .mensagem = $m | .atualizado = $a' "$arq" >"$tmp" 2>/dev/null
  else
    jq -n --arg sessao "$sessao" --arg dir "$dir" --arg raiz "$raiz" --arg worktree "$worktree" \
      --arg ramo "$ramo" --arg base "$base" --arg agente "par" --arg tarefa "$tarefa" \
      --arg pid "$$" --arg agora "$(date -Is)" --arg e "$est" --arg m "$msg" \
      '{sessao:$sessao, dir:$dir, raiz:$raiz, worktree:$worktree, ramo:$ramo, base:$base,
        agente:$agente, tarefa:$tarefa, pid:($pid|tonumber), estado:$e, mensagem:$m,
        desde:$agora, atualizado:$agora}' >"$tmp" 2>/dev/null
  fi || {
    rm -f "$tmp"
    aviso "não consegui gravar o estado da sessão $sessao"
    return 0
  }
  mv "$tmp" "$arq" 2>/dev/null || {
    rm -f "$tmp"
    aviso "não consegui trocar o arquivo de estado $arq"
  }
}

# O jq já é obrigatório acima, na gravação do estado, então não há alternativa
# a manter aqui.
extrair_campo() {
  jq -r "$2 // empty" "$1" 2>/dev/null || true
}

echo ""
regua "$c_info"
titulo "Jangada: Protocolo em Par (Claude + Antigravity)"
campo "Projeto:" "$dir"
campo "Tarefa:" "$tarefa"
regua "$c_info"
echo ""

((snapshot)) && "$JANGADA_PATH/bin/jangada-snapshot" "antes do par $sessao" || true

rodada=1
aprovado=0
parecer=""
ultimo_parecer=""

while ((rodada <= limite)); do
  echo ""
  traco
  titulo "[Rodada $rodada de $limite] Fase do Claude Code"
  traco
  atualizar_estado "trabalhando" "Rodada $rodada: Claude implementando"

  if ((rodada == 1)); then
    prompt_claude="Você está trabalhando no projeto em: $dir
Tarefa a executar:
$tarefa

Diretrizes:
1. Implemente a solução de forma limpa, direta e completa.
2. Crie ou atualize testes e documentação correspondentes se necessário.
3. Verifique a execução antes de concluir.
4. Faça commit das alterações no git ao terminar."
  else
    prompt_claude="Você está refinando o trabalho anterior para a tarefa:
$tarefa

O revisor Antigravity analisou seu commit anterior e apontou as seguintes correções:
$parecer

Diretrizes para esta rodada:
1. Analise cada um dos apontamentos da revisão e aplique as correções necessárias.
2. Certifique-se de não quebrar outros pontos do projeto.
3. Teste o código alterado.
4. Faça commit das correções no git ao terminar."
  fi

  info "Executando Claude Code..."
  if ! (cd "$dir" && claude -p "$prompt_claude" --dangerously-skip-permissions); then
    aviso "Claude encerrou com aviso ou limite atingido"
  fi

  # Verifica se foram criadas alterações
  diff_conteudo=""
  if git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    eh_git=1
    ponto_base="${base:-HEAD~1}"
    diff_conteudo="$(git -C "$dir" diff "$ponto_base..HEAD" 2>/dev/null || git -C "$dir" diff HEAD~1..HEAD 2>/dev/null || git -C "$dir" status -s 2>/dev/null || true)"
  fi

  if [[ -z "$diff_conteudo" ]]; then
    aviso "nenhuma alteração encontrada no repositório; mantendo verificação dos arquivos"
  fi

  echo ""
  traco
  titulo "[Rodada $rodada de $limite] Fase do Antigravity (Revisão)"
  traco
  atualizar_estado "trabalhando" "Rodada $rodada: Antigravity revisando"

  prompt_agy="Você é o revisor técnico no protocolo de trabalho em par do Jangada.
O agente Claude implementou a seguinte tarefa no projeto:
$tarefa

Ramo de trabalho: ${ramo:-direto no repositório}

Diferenças e arquivos modificados:
$diff_conteudo

Como trabalhar nesta execução:
1. Não altere, crie nem apague arquivos, e não execute comandos. No modo não
   interativo o agy não tem como pedir permissão, o pedido é recusado e a
   resposta volta vazia. Leia os arquivos com a sua ferramenta de leitura, a
   partir de $dir.
2. Responda apenas com o texto da revisão, no formato pedido abaixo.

Avalie com rigor:
1. A tarefa foi atendida de maneira completa e correta?
2. Existem bugs, problemas de sintaxe, contratos quebrados ou regressões?
3. O código segue as convenções do repositório?

Formato obrigatório da sua resposta:
- Se o código estiver aprovado e pronto para uso, inicie sua resposta exatamente com:
STATUS: APROVADO
seguido de um resumo objetivo do que foi verificado e aprovado.

- Se forem necessárias correções, inicie sua resposta exatamente com:
STATUS: REVISAR
seguido de uma lista numerada e clara com cada item que o Claude deve corrigir:
1. [Arquivo e contexto]: [o que está incorreto e a instrução precisa de correção]
2. ..."

  json_revisao="$estado_dir/revisao-$sessao-r$rodada.json"
  log_revisao="$estado_dir/revisao-$sessao-r$rodada.log"
  args_agy=(-p "$prompt_agy" --output-format json --effort "$esforco" --add-dir "$dir")
  [[ -n "$modelo" ]] && args_agy+=(--model "$modelo")

  info "Executando Antigravity CLI..."
  if ! agy "${args_agy[@]}" </dev/null >"$json_revisao" 2>"$log_revisao"; then
    erro "falha na execução do agy; consulte $log_revisao"
    break
  fi

  status_agy="$(extrair_campo "$json_revisao" .status)"
  if [[ "$status_agy" != "SUCCESS" ]]; then
    erro "o agy não concluiu (status: ${status_agy:-desconhecido}); consulte $log_revisao"
    break
  fi

  parecer="$(extrair_campo "$json_revisao" .response)"
  if [[ -z "$parecer" ]]; then
    erro "o agy concluiu, mas a resposta veio vazia; consulte $log_revisao"
    break
  fi

  ultimo_parecer="$estado_dir/parecer-$sessao-r$rodada.md"
  printf '%s\n' "$parecer" >"$ultimo_parecer"

  # O JSON bruto já foi lido por inteiro, e a resposta virou o parecer acima:
  # manter os dois é guardar a mesma coisa duas vezes. O log só interessa
  # quando tem conteúdo, e nas falhas acima ele fica preservado pelo break.
  rm -f "$json_revisao"
  [[ -s "$log_revisao" ]] || rm -f "$log_revisao"

  aprovado_nesta=0
  grep -qi "^STATUS:[[:space:]]*APROVADO" <<<"$parecer" && aprovado_nesta=1

  echo ""
  titulo "Resultado da revisão"
  # A primeira linha é o veredito. Pinta só ela, verde ou vermelho, e deixa o
  # corpo do parecer sem cor, que é onde estão os caminhos e trechos de código.
  if ((aprovado_nesta)); then
    printf '%s%s%s%s\n' "$c_forte" "$c_ok" "$(head -n1 <<<"$parecer")" "$c_fim"
  else
    printf '%s%s%s%s\n' "$c_forte" "$c_erro" "$(head -n1 <<<"$parecer")" "$c_fim"
  fi
  tail -n +2 <<<"$parecer"
  echo ""

  if ((aprovado_nesta)); then
    aprovado=1
    bom "Aprovado pelo Antigravity na rodada $rodada!"
    break
  else
    alerta "Antigravity solicitou correções para a próxima rodada."
    ((rodada++))
  fi
done

# Onde o trabalho ficou. Sem isto o worktree some de vista: os commits estão
# num ramo agente/<nome>, fora da árvore principal, e nada dizia como integrar.
resumo_local() {
  campo "Repositório:" "$raiz"
  if [[ -n "$worktree" ]]; then
    campo "Worktree:" "$worktree"
    campo "Ramo:" "$ramo"
    campo "Integrar:" "git -C '$raiz' merge $ramo"
    campo "Remover:" "git -C '$raiz' worktree remove '$worktree'"
  else
    campo "Ramo:" "${ramo:-trabalho direto no repositório}"
  fi
  if [[ -n "$ultimo_parecer" ]]; then
    campo "Parecer:" "$ultimo_parecer"
  else
    campo "Parecer:" "${c_aviso}nenhum; a revisão não chegou a ser gravada${c_fim}"
  fi
}

if ((aprovado)); then
  atualizar_estado "concluido" "Aprovado pelo Antigravity"
  concluiu=1
  echo ""
  regua "$c_ok"
  titulo "${c_ok}✓ Sucesso! Tarefa concluída e aprovada.${c_fim}"
  resumo_local
  regua "$c_ok"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "jangada-par" -u normal "Tarefa concluída e aprovada" "$sessao finalizada com sucesso."
  fi
else
  atualizar_estado "aguardando" "Ciclo encerrado com pendências"
  concluiu=1
  echo ""
  regua "$c_erro"
  titulo "${c_erro}✗ Ciclo finalizado com pendências ou limite atingido.${c_fim}"
  resumo_local
  regua "$c_erro"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "jangada-par" -u critical "Tarefa requer conferência" "$sessao possui itens pendentes."
  fi
fi
