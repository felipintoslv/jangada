#!/usr/bin/env bash
# Botão do Catamarã na barra (módulo custom/catamara).
#
# Uso: jangada-barra-catamara --waybar|--web|--terminal|--iniciar
#   --waybar     JSON para a barra: só o estado e a dica; sem o Catamarã, nada
#   --web        abre a Central do Catamarã no navegador
#   --terminal   abre a Central do Catamarã no terminal
#   --iniciar    inicia uma sessão do Catamarã num terminal
set -euo pipefail
# shellcheck source=bin/jangada-shell-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-shell-config"

ajuda() { sed -n '2,8s/^# \{0,1\}//p' "$0"; }

# O Catamarã é outro projeto: no PATH, ao lado do comando catamara instalado
# por link ou só clonado na pasta de projetos.
achar() {
  local nome="$1" caminho
  if caminho="$(command -v "$nome" 2>/dev/null)"; then
    printf '%s\n' "$caminho"
    return 0
  fi
  if caminho="$(command -v catamara 2>/dev/null)"; then
    caminho="$(dirname "$(readlink -f "$caminho")")/$nome"
    [[ -x "$caminho" ]] && { printf '%s\n' "$caminho"; return 0; }
  fi
  caminho="$JANGADA_PROJETOS/catamara/bin/$nome"
  [[ -x "$caminho" ]] || return 1
  printf '%s\n' "$caminho"
}

# Erro, demora ou aviso do Catamarã (o aviso de dados de demonstração sai na
# saída de erro) deixam a saída vazia, e a waybar esconde o módulo. O texto é
# um espaço porque texto vazio também esconde; a logo vem do base.css. A dica
# é marcação Pango na waybar, por isso o escape.
saida_waybar() {
  local tarefas saida
  tarefas="$(achar catamara-tarefas)" || return 0
  saida="$(timeout -k 1 3 "$tarefas" --waybar 2>&1)" || return 0
  jq -cs '
    def pango: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
    select(length == 1) | .[0]
    | select(type == "object" and (.text | type) == "string"
        and (.tooltip | type) == "string" and (.class | type) == "string")
    | ((.tooltip | capture("Sessoes: (?<n>[0-9]+)").n // "0") | tonumber) as $sessoes
    | (.class == "erro" or (.text | test("portao reprovado"))) as $reprovado
    | (if $reprovado then "erro"
       elif .class == "aviso" then "pendente"
       elif $sessoes > 0 then "ativo"
       else "repouso" end) as $estado
    | {text: " ", class: $estado,
       tooltip: ([.tooltip | split("\n")[] | select(startswith("Clique:") | not)]
         + (if $reprovado then ["Portão reprovado"] else [] end)
         + ["Clique: Central no navegador",
            "Botão direito: Central no terminal",
            "Botão do meio: iniciar sessão"]
         | join("\n") | pango)}
  ' <<<"$saida" 2>/dev/null || true
}

no_terminal() {
  exec "$JANGADA_PATH/bin/jangada-terminal" --titulo "Catamarã" \
    -e bash -c '"$@"; echo; read -r -p "Enter para fechar"' _ "$@"
}

sem_catamara() {
  printf 'jangada-barra-catamara: Catamarã não encontrado no PATH nem em %s\n' \
    "$JANGADA_PROJETOS/catamara/bin" >&2
  exit 1
}

case "${1:-}" in
  --waybar) saida_waybar ;;
  --web)
    catamara="$(achar catamara)" || sem_catamara
    exec "$catamara" tarefas --web
    ;;
  --terminal)
    tarefas="$(achar catamara-tarefas)" || sem_catamara
    no_terminal "$tarefas"
    ;;
  --iniciar)
    catamara="$(achar catamara)" || sem_catamara
    no_terminal "$catamara" iniciar
    ;;
  -h | --ajuda) ajuda ;;
  *)
    ajuda >&2
    exit 1
    ;;
esac
