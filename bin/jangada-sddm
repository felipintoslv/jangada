#!/usr/bin/env bash
# Deixa o jangada como única sessão no SDDM e aplica o tema de login do
# jangada, com as cores geradas pelo jangada-tema e o papel de parede atual.
#
# Uso:
#   jangada-sddm aplicar     instala o tema e mostra só a sessão jangada
#   jangada-sddm restaurar   volta a mostrar todas as sessões e o tema anterior
#   jangada-sddm status      mostra o estado atual
#   jangada-sddm testar      abre o tema numa janela, sem alterar o sistema
#
# Nenhum arquivo de sessão de outro pacote é movido ou apagado: o SDDM passa
# a ler as sessões de um diretório próprio, que só contém o jangada.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"
# shellcheck source=install/lib.sh
source "$JANGADA_PATH/install/lib.sh"

TEMA_ORIGEM="$JANGADA_PATH/default/sddm/jangada"
TEMA_DESTINO="/usr/share/sddm/themes/jangada"
SESSOES="/usr/local/share/jangada/sessoes"
SESSOES_X11="/usr/local/share/jangada/sessoes-x11"
# Os arquivos de /etc/sddm.conf.d são lidos em ordem alfabética e o último
# vence. O prefixo garante que este venha depois do kde_settings.conf, que o
# Plasma grava com o tema escolhido nas configurações dele.
CONF="/etc/sddm.conf.d/zz-jangada.conf"
# Cores da tela de login, geradas pelo matugen a partir do modelo
# default/matugen/modelos/sddm.conf a cada jangada-tema.
CORES="$JANGADA_CONFIG/sddm/theme.conf.user"

conteudo_sessao() {
  printf '%s\n' \
    "[Desktop Entry]" \
    "Name=jangada" \
    "Comment=Hyprland com a configuração jangada" \
    "Exec=$JANGADA_PATH/bin/jangada-sessao" \
    "Type=Application" \
    "DesktopNames=Hyprland"
}

conteudo_conf() {
  printf '%s\n' \
    "# Gravado pelo jangada-sddm. Para desfazer: jangada-sddm restaurar" \
    "[Theme]" \
    "Current=jangada" \
    "" \
    "[Wayland]" \
    "SessionDir=$SESSOES" \
    "" \
    "[X11]" \
    "SessionDir=$SESSOES_X11"
}

# Monta o tema em um diretório: arquivos do repositório, papel de parede e
# theme.conf.user com as cores do tema atual e o ajuste do papel de parede.
preparar_tema() {
  local destino="$1" ext=""
  cp "$TEMA_ORIGEM"/* "$destino/"
  if [[ -n "$JANGADA_PAPEL" && -f "$JANGADA_PAPEL" ]]; then
    ext="${JANGADA_PAPEL##*.}"
    cp "$JANGADA_PAPEL" "$destino/fundo.${ext,,}"
  fi
  {
    if [[ -r "$CORES" ]]; then
      cat "$CORES"
    else
      echo "[General]"
    fi
    echo ""
    echo "# Acrescentado pelo jangada-sddm."
    [[ -n "$ext" ]] && echo "fundo=fundo.${ext,,}"
    # A origem não é lida pelo tema; o jangada-tema compara com ela para
    # avisar quando o login ficou com o papel de parede anterior.
    echo "papel_origem=$JANGADA_PAPEL"
    echo "ajuste=$JANGADA_PAPEL_AJUSTE"
  } >"$destino/theme.conf.user"
  chmod -R a+rX "$destino"
}

# Grava a entrada padrão num arquivo de sistema, com cópia de segurança
# quando o arquivo já existe com outro conteúdo.
gravar_root() {
  local arquivo="$1" conteudo
  conteudo="$(cat)"
  if [[ -f "$arquivo" ]] && [[ "$(cat "$arquivo")" == "$conteudo" ]]; then
    ok "sem mudança: $arquivo"
    return 0
  fi
  copia_seguranca "$arquivo"
  if simulando; then
    info "[simulação] gravaria $arquivo"
  else
    printf '%s\n' "$conteudo" | como_root tee "$arquivo" >/dev/null
  fi
  ok "gravado: $arquivo"
}

aplicar() {
  [[ $EUID -ne 0 ]] || morrer "execute como usuário comum; o comando pede sudo quando precisa"
  tem_comando sddm || morrer "sddm não está instalado"
  [[ -r "$CORES" ]] || aviso "sem $CORES; o tema usa as cores padrão (rode jangada-tema)"

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  preparar_tema "$tmp"
  info "tema de login em $TEMA_DESTINO"
  como_root rm -rf "$TEMA_DESTINO"
  como_root cp -r "$tmp" "$TEMA_DESTINO"
  como_root chmod 755 "$TEMA_DESTINO"

  info "sessões visíveis no SDDM: só o jangada"
  como_root mkdir -p "$SESSOES" "$SESSOES_X11" "$(dirname "$CONF")"
  conteudo_sessao | gravar_root "$SESSOES/jangada.desktop"
  conteudo_conf | gravar_root "$CONF"

  ok "o SDDM mostra só o jangada na próxima tela de login"
  info "para desfazer: jangada-sddm restaurar"
}

restaurar() {
  [[ $EUID -ne 0 ]] || morrer "execute como usuário comum; o comando pede sudo quando precisa"
  if [[ -f "$CONF" ]]; then
    como_root rm -f "$CONF"
    ok "removido: $CONF"
  fi
  if [[ -d "$SESSOES" || -d "$SESSOES_X11" ]]; then
    como_root rm -f "$SESSOES/jangada.desktop"
    como_root rmdir --ignore-fail-on-non-empty "$SESSOES" "$SESSOES_X11" "$(dirname "$SESSOES")"
    ok "removido: $(dirname "$SESSOES")"
  fi
  ok "o SDDM volta a mostrar todas as sessões e o tema configurado antes"
  info "o tema continua instalado em $TEMA_DESTINO e pode ser escolhido de novo"
}

status() {
  local f
  if [[ -f "$CONF" ]]; then
    ok "exclusividade ativa ($CONF)"
    echo "   sessões visíveis:"
    for f in "$SESSOES"/*.desktop; do
      [[ -f "$f" ]] && echo "     $(sed -n 's/^Name=//p' "$f" | head -n1) ($f)"
    done
  else
    info "exclusividade inativa: o SDDM mostra todas as sessões instaladas"
  fi
  if [[ -f "$TEMA_DESTINO/Main.qml" ]]; then
    ok "tema instalado em $TEMA_DESTINO"
  else
    info "tema não instalado"
  fi
}

testar() {
  local greeter
  greeter="$(command -v sddm-greeter-qt6 || command -v sddm-greeter || true)"
  [[ -n "$greeter" ]] || morrer "sddm-greeter não encontrado"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  preparar_tema "$tmp"
  info "abrindo o tema em modo de teste; os botões de energia não agem nesse modo"
  "$greeter" --test-mode --theme "$tmp"
}

case "${1:-}" in
  aplicar) aplicar ;;
  restaurar) restaurar ;;
  status) status ;;
  testar) testar ;;
  "" | -h | --ajuda) sed -n '2,12s/^# \{0,1\}//p' "$0" ;;
  *)
    echo "uso: jangada-sddm aplicar|restaurar|status|testar" >&2
    exit 1
    ;;
esac
