#!/usr/bin/env bash
# Abre a central de tarefas ou emite seus contadores para a Waybar.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"
case "${1:-}" in
  --anterior) shift ;;
  --simular) shift; exec python3 "$JANGADA_PATH/default/tarefas/central.py" "$@" ;;
  ""|--nova|--waybar) ;;
  *) printf 'Uso: jangada-tarefas [--nova|--waybar|--simular]\n' >&2; exit 1 ;;
esac
args=(--real --jangada "$JANGADA_PATH" --estado "$JANGADA_ESTADO/agentes")
if [[ "${1:-}" == --waybar ]]; then
  "$JANGADA_PATH/bin/jangada-agentes" --limpar-orfaos
  args+=(--waybar)
else
  args+=(--mostrar)
  [[ "${1:-}" != --nova ]] || args+=(--nova)
fi
exec python3 "$JANGADA_PATH/default/tarefas/central.py" "${args[@]}"
