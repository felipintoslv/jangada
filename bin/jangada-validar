#!/usr/bin/env bash
# Manda o trabalho do agente para o outro modelo revisar: o Claude revisa o
# agy, e o agy revisa o Claude. O revisor não implementa nada: recebe o diff,
# lê o que precisar e devolve um parecer. O agente chama antes de entregar
# (default/agentes/protocolo.md).
#
# Uso: jangada-validar [opções] [PASTA]
#   --revisor NOME    claude ou agy, ou mesmo para o modelo da sessão (padrão:
#                     o revisor da sessão; sem ele, JANGADA_VALIDAR_REVISOR;
#                     sem ele, o oposto do agente da sessão, e claude fora de sessão)
#   --base REF        compara a partir de REF (padrão: base gravada no estado
#                     da sessão; sem ela, main ou master; sem eles, HEAD)
#   --modelo MODELO   modelo do revisor (padrão: JANGADA_VALIDAR_MODELO; sem
#                     ele, sonnet no Claude e o padrão do agy)
#   --resposta TEXTO  o que o agente fez com o parecer anterior (corrigido,
#                     rejeitado e por quê); entra no pedido da rodada seguinte
#   --forcar          passa do limite de rodadas (JANGADA_VALIDAR_RODADAS, 3)
#
# A revisão pelo agy leva alguns minutos. Quem chama por uma ferramenta com
# tempo limite deve dar pelo menos 10 minutos.
#
# Saída: o parecer, que começa por "STATUS: APROVADO" ou "STATUS: REVISAR", e
# fica gravado em ~/.local/state/jangada/agentes/validacao-SESSAO-rN.md.
# Código de saída: 0 aprovado, 3 revisar, 4 limite de rodadas, 1 erro.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

base=""; modelo="${JANGADA_VALIDAR_MODELO:-}"; resposta=""; forcar=0
revisor=""; revisor_dado=0
while (($#)); do
  case "$1" in
    --revisor) revisor="$2"; revisor_dado=1; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    --modelo) modelo="$2"; shift 2 ;;
    --resposta) resposta="$2"; shift 2 ;;
    --forcar) forcar=1; shift ;;
    -h|--ajuda) sed -n '2,24s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

dir="$(realpath "${1:-$PWD}")"
git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 \
  || { echo "jangada-validar: $dir não é um repositório git" >&2; exit 1; }
dir="$(git -C "$dir" rev-parse --show-toplevel)"

rodadas_max="${JANGADA_VALIDAR_RODADAS:-3}"
[[ "$rodadas_max" =~ ^[0-9]+$ ]] || rodadas_max=3
# Teto do diff no pedido, em bytes. O pedido vai pela entrada padrão, sem o
# limite de argumento, mas um diff de arquivo gerado gastaria tokens à toa.
diff_max="${JANGADA_VALIDAR_DIFF_MAX:-150000}"
[[ "$diff_max" =~ ^[0-9]+$ ]] || diff_max=150000

estado_dir="$JANGADA_ESTADO/agentes"
mkdir -p "$estado_dir"
sessao="${JANGADA_SESSAO:-}"
arq_estado=""
[[ -n "$sessao" && -f "$estado_dir/$sessao.json" ]] && arq_estado="$estado_dir/$sessao.json"
# Fora de uma sessão, os pareceres ficam com o nome da pasta.
rotulo="${sessao:-$(basename "$dir")}"
rotulo="${rotulo//[^A-Za-z0-9_.-]/-}"

tarefa=""; inicio=""; autor=""
if [[ -n "$arq_estado" ]]; then
  [[ -n "$base" ]] || base="$(jq -r '.base // ""' "$arq_estado")"
  tarefa="$(jq -r '.tarefa // ""' "$arq_estado")"
  inicio="$(jq -r '.inicio // ""' "$arq_estado")"
  autor="$(jq -r '.agente // ""' "$arq_estado")"
  autor="$(basename "${autor%% *}")"
  if ((!revisor_dado)); then
    revisor="$(jq -r '.revisor // ""' "$arq_estado")"
  fi
fi
[[ -n "$revisor" ]] || revisor="${JANGADA_VALIDAR_REVISOR:-}"

auto_revisao=0
if [[ "$revisor" == "mesmo" ]]; then
  auto_revisao=1
  revisor="${autor:-claude}"
elif [[ "$revisor" == "oposto" ]]; then
  case "$autor" in
    agy|"") revisor=claude ;;
    *) revisor=agy ;;
  esac
fi

# Quem revisa é o outro modelo por padrão: um modelo revisando o próprio
# trabalho tende a concordar com ele.
if [[ -z "$revisor" ]]; then
  case "$autor" in
    agy|"") revisor=claude ;;
    *) revisor=agy ;;
  esac
fi
case "$revisor" in
  claude) nome_revisor="Claude"; modelo="${modelo:-sonnet}" ;;
  agy) nome_revisor="Antigravity" ;;
  *) echo "jangada-validar: revisor desconhecido: $revisor (use claude, agy ou mesmo)" >&2; exit 1 ;;
esac

if [[ -n "$autor" && "$revisor" == "$autor" ]]; then
  auto_revisao=1
fi

case "$autor" in
  claude) nome_autor="Claude" ;;
  agy) nome_autor="Antigravity (agy)" ;;
  *)
    if ((auto_revisao)); then
      [[ "$revisor" == claude ]] && nome_autor="Claude" || nome_autor="Antigravity (agy)"
    else
      case "$revisor" in
        claude) nome_autor="Antigravity (agy)" ;;
        agy) nome_autor="Claude" ;;
      esac
    fi
    ;;
esac
command -v "$revisor" >/dev/null 2>&1 || { echo "jangada-validar: $revisor não encontrado" >&2; exit 1; }
if [[ -z "$base" ]]; then
  for r in main master; do
    git -C "$dir" rev-parse --verify --quiet "$r" >/dev/null && { base="$r"; break; }
  done
fi
ponto=""
[[ -n "$base" ]] && ponto="$(git -C "$dir" merge-base "$base" HEAD 2>/dev/null || true)"
# No próprio ramo base (trabalho direto no repositório, --direto), o merge-base
# é o HEAD. Aí vale o commit em que a sessão começou, gravado pelo
# jangada-agente, para os commits do agente entrarem na revisão; sem ele, só o
# que está sem commit.
cabeca="$(git -C "$dir" rev-parse HEAD)"
if [[ -z "$ponto" || "$ponto" == "$cabeca" ]] && [[ -n "$inicio" ]] \
   && git -C "$dir" merge-base --is-ancestor "$inicio" HEAD 2>/dev/null; then
  ponto="$inicio"
fi
[[ -n "$ponto" ]] || ponto="$cabeca"

diff_conteudo="$(git -C "$dir" diff "$ponto" 2>/dev/null || true)"
arquivos="$(git -C "$dir" diff --name-status "$ponto" 2>/dev/null || true)"
novos="$(git -C "$dir" ls-files --others --exclude-standard 2>/dev/null || true)"
[[ -n "$novos" ]] && arquivos+="${arquivos:+$'\n'}$(sed 's/^/??\t/' <<<"$novos")"
commits="$(git -C "$dir" log --oneline "$ponto..HEAD" 2>/dev/null | head -30 || true)"

if [[ -z "$diff_conteudo" && -z "$novos" ]]; then
  echo "jangada-validar: nada a revisar desde $(git -C "$dir" rev-parse --short "$ponto")" >&2
  exit 1
fi

# Rodada atual e parecer anterior.
anteriores=()
for f in "$estado_dir/validacao-$rotulo-r"*.md; do [[ -e "$f" ]] && anteriores+=("$f"); done
rodada=$((${#anteriores[@]} + 1))
if ((rodada > rodadas_max && !forcar)); then
  echo "jangada-validar: limite de $rodadas_max rodadas atingido para $rotulo." >&2
  echo "Pare e descreva o que ficou pendente; o usuário decide se roda de novo com --forcar." >&2
  exit 4
fi
ultimo=""
((${#anteriores[@]})) && ultimo="$(printf '%s\n' "${anteriores[@]}" | sort -V | tail -n1)"

if (( ${#diff_conteudo} > diff_max )); then
  echo "jangada-validar: diff de ${#diff_conteudo} bytes; vão os primeiros $diff_max" >&2
  diff_conteudo="${diff_conteudo:0:diff_max}
[... diff cortado pelo jangada-validar; leia os arquivos para ver o resto ...]"
fi

pedido="$(
  cat <<EOF
Você é o revisor técnico de um agente ($nome_autor) que trabalha neste
repositório, em $dir. Não altere, crie nem apague arquivos e não execute
comandos: só leia. Use a ferramenta de leitura quando o diff não bastar, só em
arquivos de texto (nada de PDF, planilha, imagem, parquet ou zip, que estouram
o contexto), e siga as regras do AGENTS.md ou CLAUDE.md do projeto.
EOF
  if ((auto_revisao)); then
    printf '\nEsta é uma revisão pelo mesmo modelo. Seja criterioso na conferência do código.\n'
  fi
  cat <<EOF

Tarefa do agente:
${tarefa:-(não informada; deduza pelo diff e pelos commits)}

Commits desde a base:
${commits:-(nenhum; só alterações sem commit)}

Arquivos (A novo, M alterado, D apagado, ?? novo sem commit):
$arquivos

Diff desde $(git -C "$dir" rev-parse --short "$ponto"):
$diff_conteudo
EOF
  if [[ -n "$ultimo" ]]; then
    printf '\nParecer da rodada anterior:\n---\n%s\n---\n' "$(head -c 20000 "$ultimo")"
    printf 'Resposta do agente a esse parecer:\n---\n%s\n---\n' "${resposta:-(não informada)}"
    printf 'Não repita um apontamento rejeitado com justificativa razoável, a menos que\n'
    printf 'tenha evidência nova. Confira se o que foi corrigido ficou certo.\n'
  fi
  cat <<'EOF'

Procure erros de lógica, casos que quebram, regras do projeto violadas, arquivo
que não deveria estar no diff (lixo, gerado, segredo) e teste que falta. Não
aponte gosto pessoal nem reescrita sem defeito concreto.

Responda em português, neste formato e nada mais:
STATUS: APROVADO
ou
STATUS: REVISAR
seguido de apontamentos numerados, cada um com arquivo:linha, o problema e a
correção sugerida, do mais grave para o menos grave.
EOF
)"

saida="$estado_dir/validacao-$rotulo-r$rodada.md"
echo "jangada-validar: rodada $rodada de $rodadas_max, $nome_revisor${modelo:+ ($modelo)} revisando $(wc -l <<<"$arquivos") arquivo(s)..." >&2

# O hook do revisor fica desligado: ele não é o agente da sessão, e o Stop
# dele marcaria a sessão como concluída.
revisar_claude() {
  (cd "$dir" && env -u JANGADA_SESSAO JANGADA_HOOK_DESLIGADO=1 claude -p \
    --model "$modelo" \
    --allowedTools "Read,Grep,Glob" \
    --disallowedTools "Bash,Edit,Write,NotebookEdit,WebFetch,WebSearch" \
    <<<"$pedido") >"$saida.tmp"
}

# O agy recebe o pedido como argumento, e o Linux limita cada argumento a
# 131.072 bytes (MAX_ARG_STRLEN). Acima do teto, o diff sai do pedido e vai
# para um arquivo que o agy lê.
revisar_agy() {
  local LC_ALL=C args saida_agy status_agy tentativa log="$saida.log"
  if (( ${#pedido} > 126000 )); then
    printf '%s\n' "$diff_conteudo" >"$saida.diff"
    pedido="${pedido/"$diff_conteudo"/"[diff grande demais para o pedido; leia o arquivo $saida.diff]"}"
    echo "jangada-validar: pedido acima do limite de argumento; o diff vai em $saida.diff" >&2
  fi
  args=(-p "$pedido" --output-format json --add-dir "$dir" --add-dir "$estado_dir")
  [[ -n "$modelo" ]] && args+=(--model "$modelo")
  [[ -n "${JANGADA_VALIDAR_ESFORCO:-high}" ]] && args+=(--effort "${JANGADA_VALIDAR_ESFORCO:-high}")
  # A saída vem por cano: o agy reabre o próprio descritor de saída, e com
  # redirecionamento para arquivo o JSON já chegou a ser escrito num arquivo
  # sem nome. A segunda tentativa cobre as respostas vazias com código 0.
  for tentativa in 1 2; do
    if saida_agy="$(cd "$dir" && env -u JANGADA_SESSAO JANGADA_HOOK_DESLIGADO=1 agy "${args[@]}" </dev/null 2>"$log")"; then
      status_agy="$(jq -r '.status // ""' <<<"$saida_agy" 2>/dev/null || true)"
      if [[ "$status_agy" == SUCCESS ]] && jq -r '.response // ""' <<<"$saida_agy" >"$saida.tmp" 2>/dev/null \
         && [[ -n "$(tr -d '[:space:]' <"$saida.tmp")" ]]; then
        rm -f "$log" "$saida.diff"
        return 0
      fi
    fi
    ((tentativa < 2)) && { echo "jangada-validar: o agy não respondeu; tentando de novo em 5s" >&2; sleep 5; }
  done
  echo "jangada-validar: saída do agy: ${saida_agy:0:300}" >&2
  echo "jangada-validar: erro em $log e em ~/.gemini/antigravity-cli/log/" >&2
  return 1
}

if ! "revisar_$revisor"; then
  rm -f "$saida.tmp"
  echo "jangada-validar: a chamada ao $nome_revisor falhou" >&2
  exit 1
fi
mv "$saida.tmp" "$saida"
cat "$saida"

status="REVISAR"
# Aceita a linha com marcação de Markdown (## STATUS: APROVADO, **STATUS:**).
grep -qEi '^[#[:space:]*]*STATUS:[[:space:]*]*APROVADO' "$saida" && status="APROVADO"
if [[ -n "$arq_estado" ]]; then
  tmp="$(mktemp "$arq_estado.XXXXXX")"
  jangada_alterar_estado "$arq_estado" "$tmp" --arg v "r$rodada: $status ($revisor)" '.validacao = $v'
  rm -f "$tmp"
fi
echo >&2
echo "jangada-validar: $status (parecer em $saida)" >&2
"$JANGADA_PATH/bin/jangada-gancho" pos-validar "$rotulo" "$status" || true
[[ "$status" == APROVADO ]] && exit 0
exit 3
