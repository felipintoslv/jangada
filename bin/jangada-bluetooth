#!/usr/bin/env bash
# Gerencia dispositivos Bluetooth (fones, mouses, caixas de som) via bluetoothctl e fuzzel.
#
# Uso:
#   jangada-bluetooth [menu|conectar|desconectar|scan|toggle]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

menu_fuzzel() {
  jangada_fuzzel --prompt "${1:-bluetooth} > "
}

esta_ligado() {
  bluetoothctl show 2>/dev/null | grep -qi "Powered: yes"
}

icone_dispositivo() {
  local nome="${1,,}"
  if [[ "$nome" =~ (mouse|anywhere|mx) ]]; then
    printf '󰍽'
  elif [[ "$nome" =~ (teclado|keyboard|pebble|k380) ]]; then
    printf '󰌌'
  elif [[ "$nome" =~ (fone|headphone|headset|earbud|buds|airpod|pk3|sound|audio|speaker|caixa) ]]; then
    printf '󰋋'
  else
    printf '󰂯'
  fi
}

listar_dispositivos() {
  local mac nome info conectado icone
  bluetoothctl devices Paired 2>/dev/null | while read -r _ mac nome; do
    [[ -n "$mac" ]] || continue
    info="$(bluetoothctl info "$mac" 2>/dev/null || true)"
    conectado=0
    grep -qi "Connected: yes" <<<"$info" && conectado=1
    icone="$(icone_dispositivo "$nome")"

    if ((conectado)); then
      printf '✔ [%s] %s  %s (conectado; clique para desconectar)\n' "$mac" "$icone" "$nome"
    else
      printf '  [%s] %s  %s (desconectado; clique para conectar)\n' "$mac" "$icone" "$nome"
    fi
  done
}

conectar_ou_desconectar() {
  local mac="$1" nome="$2"
  local info
  info="$(bluetoothctl info "$mac" 2>/dev/null || true)"
  if grep -qi "Connected: yes" <<<"$info"; then
    notify-send -a jangada -u low "Bluetooth" "Desconectando de $nome..." 2>/dev/null || true
    if bluetoothctl disconnect "$mac" >/dev/null 2>&1; then
      notify-send -a jangada -u low "Bluetooth" "Desconectado de $nome" 2>/dev/null || true
    else
      notify-send -a jangada -u normal "Bluetooth" "Falha ao desconectar de $nome" 2>/dev/null || true
    fi
  else
    notify-send -a jangada -u low "Bluetooth" "Conectando a $nome..." 2>/dev/null || true
    if bluetoothctl connect "$mac" >/dev/null 2>&1; then
      notify-send -a jangada -u low "Bluetooth" "Conectado com sucesso a $nome" 2>/dev/null || true
    else
      notify-send -a jangada -u normal "Bluetooth" "Não foi possível conectar a $nome" 2>/dev/null || true
    fi
  fi
}

escanear() {
  notify-send -a jangada -u low "Bluetooth" "Procurando novos dispositivos (5 segundos)..." 2>/dev/null || true
  bluetoothctl --timeout 5 scan on >/dev/null 2>&1 || true
  
  local lista escolha mac nome
  lista="$(bluetoothctl devices 2>/dev/null | while read -r _ m n; do
    printf '[%s] %s\n' "$m" "$n"
  done)"

  if [[ -z "$lista" ]]; then
    notify-send -a jangada -u normal "Bluetooth" "Nenhum novo dispositivo encontrado." 2>/dev/null || true
    return 0
  fi

  escolha="$(menu_fuzzel "parear dispositivo" <<<"$lista")" || return 0
  [[ -n "$escolha" ]] || return 0

  mac="$(grep -oP '\[\K[0-9A-Fa-f:]{17}(?=\])' <<<"$escolha")"
  nome="$(sed -E 's/^\[[^]]+\] //' <<<"$escolha")"

  if [[ -n "$mac" ]]; then
    notify-send -a jangada -u low "Bluetooth" "Pareando com $nome..." 2>/dev/null || true
    bluetoothctl pair "$mac" >/dev/null 2>&1 || true
    bluetoothctl trust "$mac" >/dev/null 2>&1 || true
    bluetoothctl connect "$mac" >/dev/null 2>&1 || true
  fi
}

menu_bluetooth() {
  if ! esta_ligado; then
    local op
    op="$(printf '%s\n' \
      "󰂴  Ligar Bluetooth" \
      "󰂲  Bluetooth desligado" | menu_fuzzel "bluetooth")" || return 0
    if [[ "$op" =~ "Ligar" ]]; then
      bluetoothctl power on >/dev/null 2>&1
      notify-send -a jangada -u low "Bluetooth" "Bluetooth ativado" 2>/dev/null || true
    fi
    return 0
  fi

  local dispositivos opcoes escolha mac nome
  dispositivos="$(listar_dispositivos)"

  opcoes=""
  [[ -n "$dispositivos" ]] && opcoes+="$dispositivos"$'\n'
  opcoes+="󰂰  Buscar novos dispositivos (Scan)"$'\n'
  opcoes+="󰂲  Desligar Bluetooth"

  if command -v blueman-manager >/dev/null 2>&1; then
    opcoes+=$'\n'"󰒓  Gerenciador gráfico (Blueman)"
  fi

  escolha="$(menu_fuzzel "bluetooth" <<<"$opcoes")" || return 0
  [[ -n "$escolha" ]] || return 0

  case "$escolha" in
    *"Desligar Bluetooth"*)
      bluetoothctl power off >/dev/null 2>&1
      notify-send -a jangada -u low "Bluetooth" "Bluetooth desativado" 2>/dev/null || true
      ;;
    *"Buscar novos dispositivos"*)
      escanear
      ;;
    *"Blueman"*)
      setsid -f blueman-manager >/dev/null 2>&1
      ;;
    *)
      mac="$(grep -oP '\[\K[0-9A-Fa-f:]{17}(?=\])' <<<"$escolha" || true)"
      if [[ -n "$mac" ]]; then
        nome="$(sed -E 's/^[✔ ]* \[[^]]+\] [^ ]+  //; s/ \(.*//' <<<"$escolha")"
        conectar_ou_desconectar "$mac" "$nome"
      fi
      ;;
  esac
}

case "${1:-menu}" in
  -h|--ajuda)
    sed -n '2,6s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  ligar)
    bluetoothctl power on >/dev/null 2>&1
    notify-send -a jangada -u low "Bluetooth" "Bluetooth ativado" 2>/dev/null || true
    ;;
  desligar)
    bluetoothctl power off >/dev/null 2>&1
    notify-send -a jangada -u low "Bluetooth" "Bluetooth desativado" 2>/dev/null || true
    ;;
  toggle)
    if esta_ligado; then
      bluetoothctl power off >/dev/null 2>&1
      notify-send -a jangada -u low "Bluetooth" "Bluetooth desativado" 2>/dev/null || true
    else
      command -v rfkill >/dev/null 2>&1 && rfkill unblock bluetooth 2>/dev/null || true
      bluetoothctl power on >/dev/null 2>&1
      notify-send -a jangada -u low "Bluetooth" "Bluetooth ativado" 2>/dev/null || true
    fi
    ;;
  scan)
    escanear
    ;;
  menu|*)
    menu_bluetooth
    ;;
esac
