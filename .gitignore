# Inventários gerados por jangada-mapear contêm dados pessoais da máquina.
# Para versionar um mapa de propósito, use: git add -f mapeamento/<pasta>
mapeamento/

# Registros e tentativas da revisão com o Gemini.
revisao/*.log
revisao/*.parcial
revisao/antigas/

# Resposta completa em JSON das revisões pelo agy.
revisao/*.json

# Clones de referência para comparações (não entram no commit).
referencia/

# Bytecode dos módulos Python do Shell.
__pycache__/
*.pyc

# Estudos visuais ficam disponíveis na tarefa sem integrar os padrões instalados.
output/identidade/
