# Configuração do snapper para a raiz, instalada pelo jangada.
# Guarda poucos snapshots, só os criados antes e depois do pacman (snap-pac)
# e os manuais (jangada-snapshot). Sem linha do tempo. Os do agente
# (jangada-snapshot --agente) ficam fora desta limpeza e têm a própria.
SUBVOLUME="/"
FSTYPE="btrfs"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"

NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="0"
NUMBER_LIMIT="10"
NUMBER_LIMIT_IMPORTANT="5"

TIMELINE_CREATE="no"
TIMELINE_CLEANUP="yes"

EMPTY_PRE_POST_CLEANUP="yes"
