// Barra do jangada (modo "componentes").
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "custom/agentes", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "mpris",
    "tray",
    "custom/atualizacoes",
    "idle_inhibitor",
    "cpu",
    "memory",
    "temperature",
    "network",
    "bluetooth",
    "pulseaudio",
    "pulseaudio#microfone",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "show-special": true,
    "special-visible-only": true
  },

  "custom/agentes": {
    "exec": "$JANGADA_PATH/bin/jangada-agentes --waybar",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "on-click": "$JANGADA_PATH/bin/jangada-agentes --janela",
    "on-click-right": "$JANGADA_PATH/bin/jangada-agentes --painel",
    "tooltip": true
  },

  // Título da janela em foco, entre os agentes e o relógio do centro. O
  // max-length limita a largura tomada do centro; o título inteiro continua
  // na dica. Sem janela em foco o texto fica vazio e a waybar recolhe o
  // módulo. Com separate-outputs, cada monitor mostra a janela dele.
  "hyprland/window": {
    "format": "{title}",
    "max-length": 35,
    "separate-outputs": true,
    "tooltip": true
  },

  // Vazio quando não há atualização: a waybar recolhe o módulo sozinha, e
  // assim o espaço só é ocupado quando há o que fazer.
  "custom/atualizacoes": {
    "exec": "$JANGADA_PATH/bin/jangada-atualizacoes --waybar",
    "return-type": "json",
    "interval": 3600,
    "format": "{}",
    "on-click": "$JANGADA_PATH/bin/jangada-terminal --titulo 'jangada update' -e $JANGADA_PATH/bin/jangada-update",
    "tooltip": true
  },

  // Segura o repouso enquanto estiver ligado. Convive com o hypridle: o que
  // este módulo faz é pedir a inibição pelo protocolo do Wayland.
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰛊" },
    "tooltip-format-activated": "repouso inibido",
    "tooltip-format-deactivated": "repouso automático"
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "player-icons": { "default": "󰐊" },
    "status-icons": { "paused": "󰏤" },
    "max-length": 40,
    "tooltip-format": "{title}\n{artist}\n{album}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "clock": {
    "format": "{:L%A %d/%m  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "locale": "pt_BR.UTF-8",
    "on-click": "$JANGADA_PATH/bin/jangada-calendario"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true,
    "on-click": "$JANGADA_PATH/bin/jangada-monitor"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB",
    "on-click": "$JANGADA_PATH/bin/jangada-monitor"
  },

  "temperature": {
    "interval": 2,
    // A numeração de /sys/class/hwmon/hwmonN sai na ordem em que os módulos
    // do kernel registram os sensores e muda entre partidas, então caminho
    // fixo podia acabar lendo a placa de vídeo, um disco NVMe ou a placa de
    // rede. O hwmon-path-abs aponta o diretório do dispositivo, que vem da
    // topologia do barramento e não muda, e a waybar resolve o hwmonN de
    // dentro dele. Vence o primeiro da lista que existir: sensor de pacote
    // da Intel, do AMD e o do ThinkPad. Sem nenhum deles, cai no
    // thermal-zone 0, que é /sys/class/thermal/thermal_zone0/temp.
    "hwmon-path-abs": [
      "/sys/devices/platform/coretemp.0/hwmon",
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
      "/sys/devices/platform/thinkpad_hwmon/hwmon"
    ],
    "input-filename": "temp1_input",
    "thermal-zone": 0,
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": "󰈸 {temperatureC}°C",
    "tooltip": true,
    "on-click": "$JANGADA_PATH/bin/jangada-monitor"
  },

  "network": {
    "interval": 2,
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {bandwidthDownBits}",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} · IP: {ipaddr}\n⬇ {bandwidthDownBytes}  ⬆ {bandwidthUpBytes}",
    "on-click": "$JANGADA_PATH/bin/jangada-rede",
    "on-click-right": "$JANGADA_PATH/bin/jangada-rede tui"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} conectado(s)",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} conectado(s)\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "$JANGADA_PATH/bin/jangada-bluetooth",
    "on-click-right": "$JANGADA_PATH/bin/jangada-bluetooth menu"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "$JANGADA_PATH/bin/jangada-audio saida",
    "tooltip-format": "{desc} · {volume}%"
  },

  "pulseaudio#microfone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "$JANGADA_PATH/bin/jangada-audio entrada",
    "scroll-step": 5,
    "tooltip-format": "{source_desc} · {volume}%"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "states": { "aviso": 25, "critico": 10 },
    "tooltip-format": "{capacity}% · {timeTo}",
    "on-click": "$JANGADA_PATH/bin/jangada-energia"
  },

  // show-passive-items mostra também o que está em repouso, que é o caso de
  // vários aplicativos em bandeja logo depois de abrir.
  "tray": { "spacing": 8, "icon-size": 16, "show-passive-items": true }
}
