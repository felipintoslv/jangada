// Barra do jangada (modo "componentes").
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 6,
  "modules-left": ["hyprland/workspaces", "custom/agentes"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "temperature",
    "network",
    "pulseaudio",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "show-special": true,
    "special-visible-only": true
  },

  "custom/agentes": {
    "exec": "$JANGADA_PATH/bin/jangada-agentes --waybar",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "on-click": "$JANGADA_PATH/bin/jangada-agentes --janela",
    "on-click-right": "$JANGADA_PATH/bin/jangada-agentes --painel",
    "tooltip": true
  },

  "clock": {
    "format": "{:%a %d/%m  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "locale": "pt_BR.UTF-8"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true,
    "on-click": "$JANGADA_PATH/bin/jangada-monitor"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB",
    "on-click": "$JANGADA_PATH/bin/jangada-monitor"
  },

  "temperature": {
    "interval": 2,
    "hwmon-path": [
      "/sys/class/hwmon/hwmon3/temp1_input",
      "/sys/class/hwmon/hwmon2/temp1_input",
      "/sys/class/hwmon/hwmon4/temp1_input",
      "/sys/class/hwmon/hwmon5/temp1_input",
      "/sys/class/hwmon/hwmon6/temp1_input",
      "/sys/class/thermal/thermal_zone0/temp"
    ],
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": "󰈸 {temperatureC}°C",
    "tooltip": true,
    "on-click": "$JANGADA_PATH/bin/jangada-monitor"
  },

  "network": {
    "interval": 2,
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {bandwidthDownBits}",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} · IP: {ipaddr}\n⬇ {bandwidthDownBytes}  ⬆ {bandwidthUpBytes}",
    "on-click": "$JANGADA_PATH/bin/jangada-monitor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "states": { "aviso": 25, "critico": 10 }
  },

  "tray": { "spacing": 8 }
}
