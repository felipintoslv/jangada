/* Gerado pelo jangada na instalação. Pode ser editado à vontade.
   cores.css é recriado pelo jangada-tema a cada troca de papel de parede. */
@import url("cores.css");
@import url("@JANGADA_PATH@/default/waybar/base.css");

/* Ajuste por monitor: cada barra recebe a classe com o nome da saída (veja
   com hyprctl monitors). Num monitor de escala maior, uma fonte menor iguala o
   tamanho físico ao das outras telas. Exemplo:
window#waybar.DP-3 {
  font-size: 11px;
}
*/
