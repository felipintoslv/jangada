#!/usr/bin/env bash
# Recarrega o Hyprland e mostra os erros de configuração, se houver.
hyprctl reload >/dev/null
sleep 0.5
erros="$(hyprctl configerrors 2>/dev/null | sed '/^[[:space:]]*$/d')"
if [[ -n "$erros" ]]; then
  notify-send -u critical -a jangada "Erros na configuração" "$erros"
  printf '%s\n' "$erros"
  exit 1
fi
notify-send -a jangada "Configuração recarregada" "sem erros"
