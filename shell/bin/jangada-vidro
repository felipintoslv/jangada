#!/usr/bin/env bash
# Aplica JANGADA_VIDRO e JANGADA_VIDRO_ALPHA sem regenerar cores ou papel de parede.
# --arquivos: altera apenas os fundos, sem recarregar processos ou compositor.
# --tema: preserva folhas pessoais da barra ao regenerar cores.
# --migrar: adapta apenas arquivos que correspondem aos modelos antigos gerados.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"
# shellcheck source=install/lib.sh
source "$JANGADA_PATH/install/lib.sh"
# shellcheck source=bin/jangada-interface-processos
source "$(dirname "${BASH_SOURCE[0]}")/jangada-interface-processos"
modo="${1:-}"
case "$modo" in
  ''|--arquivos|--migrar|--tema) ;;
  -h|--ajuda) sed -n '2,5s/^# //p' "$0"; exit 0 ;;
  *) echo "jangada-vidro: opção desconhecida" >&2; exit 1 ;;
esac
[[ $# -le 1 ]] || { echo "jangada-vidro: argumentos em excesso" >&2; exit 1; }
[[ "$JANGADA_VIDRO" == 0 || "$JANGADA_VIDRO" == 1 ]] \
  || { echo "jangada-vidro: JANGADA_VIDRO deve ser 0 ou 1" >&2; exit 1; }
[[ "$JANGADA_VIDRO_ALPHA" =~ ^(0([.][0-9]+)?|1([.]0+)?)$ ]] \
  || { echo "jangada-vidro: JANGADA_VIDRO_ALPHA deve estar entre 0 e 1" >&2; exit 1; }
if simulando; then
  info "[simulação] adaptaria fundos em $JANGADA_CONFIG ($modo), vidro=$JANGADA_VIDRO, alpha=$JANGADA_VIDRO_ALPHA"
  exit 0
fi
if [[ "$JANGADA_INTERFACE" != componentes ]]; then
  if [[ -z "$modo" && -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload
    hyprctl configerrors
  fi
  exit 0
fi
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
if [[ ! -e "$JANGADA_CONFIG/waybar/style.css" ]]; then
  caminho="${JANGADA_PATH//\\/\\\\}"; caminho="${caminho//|/\\|}"; caminho="${caminho//&/\\&}"
  sed "s|@JANGADA_PATH@|$caminho|g" "$JANGADA_PATH/shell/waybar/style.css.modelo" >"$tmp/estilo"
  copiar_se_ausente "$tmp/estilo" "$JANGADA_CONFIG/waybar/style.css"
fi
python3 - "$JANGADA_CONFIG" "$JANGADA_PATH" "$tmp" "$modo" "$JANGADA_VIDRO" "$JANGADA_VIDRO_ALPHA" <<'PY'
import pathlib
import re
import sys

config, repo, tmp = map(pathlib.Path, sys.argv[1:4])
modo, ligado, valor = sys.argv[4:]
alpha = float(valor) if ligado == '1' else 1.0
hex_alpha = f'{round(alpha * 255):02x}'
modelos = repo / 'shell/temas/matugen/modelos'
for indice, (relativo, modelo) in enumerate([
    ('waybar/style.css', 'style.css.modelo'),
    ('fuzzel/fuzzel.ini', 'fuzzel.ini'),
    ('mako/config', 'mako'),
]):
    arquivo = config / relativo
    if not arquivo.is_file():
        continue
    texto = arquivo.read_text()
    if modo == '--tema' and modelo == 'style.css.modelo':
        padrao = (repo / 'shell/waybar' / modelo).read_text().replace('@JANGADA_PATH@', str(repo))
        sem_bloco = re.sub(r'/\* jangada-vidro: início \*/.*?/\* jangada-vidro: fim \*/\n?',
                           '', texto, flags=re.S)
        if sem_bloco.strip() != padrao.strip():
            print(f'aviso: mantido fundo pessoal de {relativo}; use jangada-vidro para ajustá-lo explicitamente')
            continue
    if modo == '--migrar':
        if modelo == 'style.css.modelo':
            antigo = (repo / 'shell/waybar' / modelo).read_text().replace('@JANGADA_PATH@', str(repo))
        else:
            antigo = (modelos / modelo).read_text()
        if modelo == 'fuzzel.ini':
            antigo = antigo.replace('hex_stripped}}e0', 'hex_stripped}}f2')
        else:
            antigo = antigo.replace('hex}}e0', 'hex}}')
        partes = re.split(r'(\{\{.*?\}\})', antigo)
        # .hex inclui o #; ele não aparece no texto literal do modelo.
        padrao = ''.join(('[0-9a-fA-F]{6}' if 'hex_stripped' in parte else '#[0-9a-fA-F]{6}')
                         if parte.startswith('{{') else re.escape(parte) for parte in partes)
        if not re.fullmatch(padrao, texto):
            print(f'mantido: {relativo} (personalizado ou já adaptado)')
            continue
    if modelo == 'style.css.modelo':
        inicio = '/* jangada-vidro: início */'
        fim = '/* jangada-vidro: fim */'
        novo = re.sub(re.escape(inicio) + r'.*?' + re.escape(fim) + r'\n?', '', texto, flags=re.S)
        novo = novo.rstrip() + f'\n\n{inicio}\n.modules-left, .modules-center, .modules-right {{\n  background: alpha(@superficie, {alpha:g});\n}}\n{fim}\n'
    else:
        chave = 'background' if modelo == 'fuzzel.ini' else 'background-color'
        padrao = rf'(?m)^({chave}=#?)([0-9a-fA-F]{{6}})(?:[0-9a-fA-F]{{2}})?$'
        novo, n = re.subn(padrao, lambda m: m[1] + m[2] + hex_alpha, texto)
        if not n:
            raise SystemExit(f'jangada-vidro: fundo não reconhecido em {relativo}; use cor hexadecimal')
    if novo != texto:
        (tmp / str(indice)).write_text(novo)
PY
arquivos=(waybar/style.css fuzzel/fuzzel.ini mako/config)
for i in "${!arquivos[@]}"; do
  [[ -f "$tmp/$i" ]] || continue
  destino="$JANGADA_CONFIG/${arquivos[$i]}"
  # A geração do tema pode ter criado a cópia no mesmo segundo.
  reserva="$destino.jangada-$(date +%Y%m%d-%H%M%S).bak"
  if [[ -e "$reserva" ]]; then
    extra="$(mktemp "${reserva%.bak}-XXXXXX.bak")"
    cp -a "$reserva" "$extra"
  fi
  copia_seguranca "$destino"
  gravar_atomico "$tmp/$i" "$destino"
done
if [[ -z "$modo" ]]; then
  jangada_interface_sinalizar waybar USR2
  jangada_interface_recarregar_mako
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload
    hyprctl configerrors
  fi
fi
