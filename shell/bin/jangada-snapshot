#!/usr/bin/env bash
# Cria um snapshot manual da raiz com o snapper.
#
# Uso:
#   jangada-snapshot "descrição"            snapshot manual
#   jangada-snapshot --agente "descrição"   snapshot antes de um agente
#
# O manual entra na limpeza por número do snapper, junto com os pares do
# snap-pac. O do agente fica fora dela, marcado com jangada=agente, e tem
# limpeza própria: ficam só os JANGADA_SNAPSHOTS_AGENTE mais recentes (padrão
# 5). Assim o jangada-agente --snapshot, que pode rodar várias vezes por dia,
# não empurra para fora os snapshots das atualizações.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

agente=0
if [[ "${1:-}" == --agente ]]; then agente=1; shift; fi
command -v snapper >/dev/null 2>&1 || { echo "snapper não instalado" >&2; exit 1; }
[[ -f "${JANGADA_SNAPPER_CONF:-/etc/snapper/configs/root}" ]] || { echo "snapper sem configuração para /" >&2; exit 1; }
desc="${1:-manual (jangada)}"

if ((!agente)); then
  sudo snapper -c root create --type single --cleanup-algorithm number --description "$desc" --print-number
  exit 0
fi

limite="${JANGADA_SNAPSHOTS_AGENTE:-5}"
if [[ ! "$limite" =~ ^[1-9][0-9]*$ ]]; then
  echo "jangada-snapshot: JANGADA_SNAPSHOTS_AGENTE=$limite não é um número positivo; usando 5" >&2
  limite=5
fi
sudo snapper -c root create --type single --userdata jangada=agente --description "$desc" --print-number

# Apaga os snapshots do agente além do limite, dos mais antigos para os mais
# novos. Só entram os marcados com jangada=agente e sem limpeza do snapper, o
# que deixa de fora os manuais, os do snap-pac e os que o usuário remarcou.
mapfile -t antigos < <(sudo snapper -c root --jsonout list --disable-used-space 2>/dev/null |
  jq -r --argjson n "$limite" '[.root[]
    | select((.userdata // {}).jangada == "agente" and (.cleanup // "") == "")
    | .number] | sort | .[:-$n][]' 2>/dev/null)
if ((${#antigos[@]})); then
  sudo snapper -c root delete "${antigos[@]}" ||
    echo "jangada-snapshot: não consegui apagar os snapshots antigos do agente: ${antigos[*]}" >&2
fi
