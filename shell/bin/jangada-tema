#!/usr/bin/env bash
# Gera as cores a partir de um papel de parede (ou de uma cor) e recarrega a interface.
#
# Uso:
#   jangada-tema imagem.jpg     usa a imagem como papel de parede e fonte das cores
#   jangada-tema --cor "#hex"   gera as cores a partir de uma cor
#   jangada-tema --escolher     escolhe uma imagem em ~/Imagens/Papeis (ou ~/Pictures/Wallpapers)
#   jangada-tema --aplicar-papel  só aplica o papel de parede salvo (usado no início da sessão)
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"
# shellcheck source=bin/jangada-interface-processos
source "$(dirname "${BASH_SOURCE[0]}")/jangada-interface-processos"
# shellcheck source=install/lib.sh
source "$JANGADA_PATH/install/lib.sh"

if simulando; then
  executar "$0" "$@"
  exit 0
fi

matugen_cfg="$JANGADA_PATH/default/matugen/config.toml"
conf_usuario="$JANGADA_CONFIG/jangada.conf"

cache_papel="$JANGADA_ESTADO/papel"
papeis_hyprlock="$JANGADA_CONFIG/hyprlock/papeis.conf"

# Cor de fundo do tema atual, para o ajuste "cor". Vem do modelo do SDDM, que
# guarda a cor de superfície do matugen em cor_tela.
cor_fundo() {
  local cor
  cor="$(sed -n 's/^cor_tela=#\{0,1\}\([0-9a-fA-F]\{6\}\)$/#\1/p' "$JANGADA_CONFIG/sddm/theme.conf.user" 2>/dev/null | head -n1)"
  printf '%s\n' "${cor:-#000000}"
}

# Imprime o caminho de uma versão da imagem com as medidas da tela (em pixels
# físicos), completada conforme JANGADA_PAPEL_AJUSTE. Quando a proporção já é
# a mesma, ou o ajuste é "cobrir", imprime a própria imagem. As versões ficam
# em cache, com o nome derivado do caminho e da data da imagem.
papel_para_tela() {
  local img="$1" lt="$2" at="$3" modo="$JANGADA_PAPEL_AJUSTE" li ai med chave saida
  local larg alt lado resto
  read -r li ai < <(magick identify -format '%w %h\n' "${img}[0]" 2>/dev/null | head -n1) || true
  # Diferença de proporção abaixo de 1%: a tela já mostra a figura inteira.
  if [[ -z "${li:-}" || "$modo" == cobrir ]] \
    || (( 100 * (lt * ai - at * li) / (at * li) == 0 )); then
    printf '%s\n' "$img"
    return 0
  fi
  # Tela mais larga que a imagem: a figura ocupa a altura toda e as laterais
  # são completadas. Mais alta: ocupa a largura e completa em cima e embaixo.
  if (( lt * ai > at * li )); then
    larg=$(( (li * at + ai / 2) / ai )); alt=$at
    lado=$(( (lt - larg) / 2 )); resto=$(( lt - larg - lado ))
  else
    larg=$lt; alt=$(( (ai * lt + li / 2) / li ))
    lado=$(( (at - alt) / 2 )); resto=$(( at - alt - lado ))
  fi
  # O espelho só funciona enquanto a faixa a refletir cabe na figura: nas
  # laterais a faixa se mede pela largura da figura, em cima e embaixo pela
  # altura.
  if [[ "$modo" == espelho ]] && (( resto > (larg < lt ? larg : alt) )); then
    modo=desfoque
  fi
  chave="$(printf '%s %s' "$img" "$(stat -c %Y "$img")" | sha1sum | cut -c1-12)"
  saida="$cache_papel/$chave-${lt}x$at-$modo.png"
  if [[ -f "$saida" ]]; then
    printf '%s\n' "$saida"
    return 0
  fi
  mkdir -p "$cache_papel"
  med="${larg}x$alt"
  case "$modo" in
    espelho)
      if (( larg < lt )); then
        magick "${img}[0]" -resize "$med!" -write mpr:f +delete \
          \( mpr:f -crop "${lado}x$alt+0+0" +repage -flop \) mpr:f \
          \( mpr:f -gravity east -crop "${resto}x$alt+0+0" +repage -flop \) \
          +append "$saida"
      else
        magick "${img}[0]" -resize "$med!" -write mpr:f +delete \
          \( mpr:f -crop "${larg}x$lado+0+0" +repage -flip \) mpr:f \
          \( mpr:f -gravity south -crop "${larg}x$resto+0+0" +repage -flip \) \
          -append "$saida"
      fi
      ;;
    cor)
      magick "${img}[0]" -resize "$med!" -background "$(cor_fundo)" -gravity center \
        -extent "${lt}x$at" "$saida"
      ;;
    *)
      # desfoque: reduzir antes de desfocar sai muito mais rápido que desfocar
      # a 4K e dá o mesmo resultado.
      magick \( "${img}[0]" -resize "${lt}x$at^" -gravity center -extent "${lt}x$at" \
        -scale 5% -blur 0x4 -resize "${lt}x$at!" -modulate 60 \) \
        \( "${img}[0]" -resize "$med!" \) -gravity center -composite "$saida"
      ;;
  esac
  printf '%s\n' "$saida"
}

# Telas ligadas, uma por linha: nome, largura e altura em pixels físicos, já
# com a rotação aplicada.
telas() {
  command -v hyprctl >/dev/null && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.disabled | not)
    | if (.transform % 2) == 1 then [.name, .height, .width] else [.name, .width, .height] end
    | @tsv'
}

# Blocos de fundo do hyprlock, um por tela, com a versão sem corte ou com a
# própria imagem. O jangada-bloquear junta este arquivo ao hyprlock.conf gerado
# pelo matugen e tira a imagem do fundo geral, para que cada tela desenhe e
# desfoque uma imagem só.
gravar_papeis_hyprlock() {
  local nome caminho
  mkdir -p "$(dirname "$papeis_hyprlock")"
  {
    echo "# Gerado pelo jangada-tema: fundo de cada tela, sem corte. Não edite."
    while IFS=$'\t' read -r nome caminho; do
      printf 'background {\n    monitor = %s\n    path = %s\n    blur_passes = 1\n    blur_size = 3\n}\n' \
        "$nome" "$caminho"
    done
  } >"$papeis_hyprlock"
}

aplicar_papel() {
  local img="${1:-$JANGADA_PAPEL}" nome lt at caminho linha
  local -a args=()
  [[ -n "$img" && -f "$img" ]] || return 0
  # No Noctalia o papel de parede é dele; um swaybg disputaria o fundo.
  [[ "$JANGADA_INTERFACE" == noctalia ]] && return 0
  args=(-o '*' -i "$img" -m fill)
  if command -v magick >/dev/null; then
    while IFS=$'\t' read -r nome lt at; do
      [[ -n "$nome" ]] || continue
      caminho="$(papel_para_tela "$img" "$lt" "$at")" || caminho="$img"
      printf '%s\t%s\n' "$nome" "$caminho"
    done < <(telas) | gravar_papeis_hyprlock
    # O laço acima roda num subshell por causa do pipe, então os argumentos do
    # swaybg são lidos de volta do arquivo que ele gravou.
    while IFS= read -r linha; do
      [[ "$linha" =~ ^[[:space:]]+monitor\ =\ (.*)$ ]] && nome="${BASH_REMATCH[1]}"
      [[ "$linha" =~ ^[[:space:]]+path\ =\ (.*)$ ]] && args+=(-o "$nome" -i "${BASH_REMATCH[1]}" -m fill)
    done <"$papeis_hyprlock"
  else
    # Sem o ImageMagick não há versões por tela; um arquivo antigo faria o
    # bloqueio mostrar o papel de parede anterior.
    : >"$papeis_hyprlock" 2>/dev/null || true
  fi
  jangada_interface_sinalizar swaybg TERM
  JANGADA_INTERFACE_PROCESSO=papel setsid -f swaybg "${args[@]}" >/dev/null 2>&1
}

salvar_papel() {
  local img="$1" seguro
  [[ -f "$conf_usuario" ]] || return 0
  # Barra invertida, "|" e "&" teriam sentido especial na substituição do sed.
  seguro="${img//\\/\\\\}"; seguro="${seguro//|/\\|}"; seguro="${seguro//&/\\&}"
  if grep -q '^JANGADA_PAPEL=' "$conf_usuario"; then
    sed -i --follow-symlinks "s|^JANGADA_PAPEL=.*|JANGADA_PAPEL=$seguro|" "$conf_usuario"
  else
    printf 'JANGADA_PAPEL=%s\n' "$img" >>"$conf_usuario"
  fi
}

recarregar() {
  jangada_interface_sinalizar waybar USR2
  jangada_interface_recarregar_mako
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl reload >/dev/null || true
}

# A tela de login fica numa pasta do sistema e só muda com sudo. Avisa quando o
# tema instalado ficou com cores, papel de parede ou ajuste diferentes dos
# atuais. O argumento é o papel de parede em uso (vazio no modo --cor).
aviso_sddm() {
  local papel="${1:-}" instalado=/usr/share/sddm/themes/jangada/theme.conf.user
  local gerado="$JANGADA_CONFIG/sddm/theme.conf.user"
  [[ -f "$instalado" && -f "$gerado" ]] || return 0
  # As linhas de cor são comparadas uma a uma: "[General]" existe nos dois
  # arquivos, e procurar qualquer linha em comum sempre acharia essa.
  if [[ "$(grep '^cor_' "$gerado")" != "$(grep '^cor_' "$instalado")" ]] \
    || ! grep -qxF "papel_origem=$papel" "$instalado" \
    || ! grep -qxF "ajuste=$JANGADA_PAPEL_AJUSTE" "$instalado"; then
    echo "a tela de login ainda usa o tema anterior; para atualizá-la: jangada-sddm aplicar"
  fi
}

escolher() {
  local pasta
  for pasta in "$HOME/Imagens/Papeis" "$HOME/Pictures/Wallpapers" "$HOME/Imagens" "$HOME/Pictures"; do
    [[ -d "$pasta" ]] && break
  done
  if [[ ! -d "$pasta" ]]; then
    notify-send -a jangada "Papel de parede" "nenhuma pasta de imagens encontrada (crie ~/Imagens/Papeis)" 2>/dev/null || true
    return 1
  fi
  find "$pasta" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    | sort | jangada_fuzzel --prompt "papel de parede: "
}

command -v matugen >/dev/null 2>&1 || { echo "matugen não instalado" >&2; exit 1; }

# O config.toml grava em ~/.config/jangada. Com XDG_CONFIG_HOME em outro lugar
# (dotfiles, testes), uma cópia temporária troca o destino; os modelos, que são
# relativos ao arquivo original, viram caminhos absolutos na cópia.
if [[ "$JANGADA_CONFIG" != "$HOME/.config/jangada" ]]; then
  cfg_tmp="$(mktemp --suffix .toml)"
  trap 'rm -f "$cfg_tmp"' EXIT
  local_cfg_esc="${JANGADA_CONFIG//\\/\\\\}"; local_cfg_esc="${local_cfg_esc//|/\\|}"; local_cfg_esc="${local_cfg_esc//&/\\&}"
  local_path_esc="${JANGADA_PATH//\\/\\\\}"; local_path_esc="${local_path_esc//|/\\|}"; local_path_esc="${local_path_esc//&/\\&}"
  sed -e "s|\"~/.config/jangada/|\"$local_cfg_esc/|" \
      -e "s|\"\./modelos/|\"$local_path_esc/default/matugen/modelos/|" "$matugen_cfg" >"$cfg_tmp"
  matugen_cfg="$cfg_tmp"
fi

case "${1:-}" in
  --aplicar-papel)
    aplicar_papel
    ;;
  --cor)
    # A regra 3 preserva também ajustes manuais antes de regenerar o arquivo.
    copia_seguranca "$JANGADA_CONFIG/fichas.json"
    matugen color hex "${2:?informe a cor, ex.: #4f8fba}" -c "$matugen_cfg" -m dark -t "$JANGADA_TEMA_ESQUEMA"
    python3 "$JANGADA_PATH/default/visual/fichas.py" "$JANGADA_CONFIG/fichas.json"
    # Sem imagem, o matugen escreve "path = Null" no hyprlock.conf; o hyprlock
    # tentaria abrir um arquivo chamado Null. Sem a linha, ele usa a cor.
    sed -i '/^[[:space:]]*path = Null$/d' "$JANGADA_CONFIG/hyprlock/hyprlock.conf" 2>/dev/null || true
    : >"$papeis_hyprlock" 2>/dev/null || true
    recarregar
    aviso_sddm ""
    ;;
  --escolher)
    img="$(escolher)" || exit 0
    [[ -n "$img" ]] && exec "$0" "$img"
    ;;
  "" | -h | --ajuda)
    sed -n '2,9s/^# \{0,1\}//p' "$0"
    ;;
  *)
    img="$(realpath -- "$1")"
    [[ -f "$img" ]] || { echo "arquivo não encontrado: $1" >&2; exit 1; }
    [[ "$img" != *[[:cntrl:]#]* ]] || { echo "jangada-tema: o caminho não pode conter quebras de linha nem '#'" >&2; exit 1; }
    # Sem --source-color-index, quem escolhe a cor-fonte entre as candidatas é
    # o "prefer" do config.toml. O índice 0 é só a primeira da lista do
    # matugen: no cordel era o preto azulado do fundo, e as bordas saíam num
    # azul que não existe na imagem.
    copia_seguranca "$JANGADA_CONFIG/fichas.json"
    matugen image "$img" -c "$matugen_cfg" -m dark -t "$JANGADA_TEMA_ESQUEMA"
    python3 "$JANGADA_PATH/default/visual/fichas.py" "$JANGADA_CONFIG/fichas.json"
    salvar_papel "$img"
    aplicar_papel "$img"
    recarregar
    aviso_sddm "$img"
    "$JANGADA_PATH/bin/jangada-gancho" pos-tema "$img"
    ;;
esac
