#!/usr/bin/env bash
# Converte a configuração do niri em ajustes do jangada, sem sobrescrever nada.
#
# Uso: jangada-importar [--saida PASTA] [ORIGEM]
#   ORIGEM   uma pasta gerada por jangada-mapear (usa config/niri/config.kdl)
#            ou um config.kdl. Sem ORIGEM: ~/.config/niri/config.kdl, se
#            existir; senão, o mapeamento mais recente em $JANGADA_PATH/mapeamento.
#   --saida  onde gravar (padrão: ~/.config/jangada)
#
# Gera três arquivos com a extensão .importado, para você comparar com os
# atuais e copiar o que quiser:
#   hypr/usuario.lua.importado    teclado, ambiente, programas ao iniciar e
#                                 atalhos que abrem programas
#   hypr/monitores.lua.importado  posição, escala, modo e rotação das telas
#   jangada.conf.importado        o terminal do atalho Mod+Return
#
# Atalhos que batem com um padrão do jangada saem comentados, com o nome do
# padrão. Ações do niri sem equivalente direto (colunas, overview) e comandos
# do Noctalia saem listados como comentário no fim do usuario.lua.importado.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

saida="${XDG_CONFIG_HOME:-$HOME/.config}/jangada"
origem=""
while (($#)); do
  case "$1" in
    --saida) saida="${2:?falta a pasta}"; shift 2 ;;
    -h|--ajuda) sed -n '2,19s/^# \{0,1\}//p' "$0"; exit 0 ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) origem="$1"; shift ;;
  esac
done

if [[ -z "$origem" ]]; then
  if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" ]]; then
    origem="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
  else
    mapas=("$JANGADA_PATH"/mapeamento/*/)
    [[ -d "${mapas[-1]}" ]] && origem="${mapas[-1]}"
  fi
fi
[[ -d "$origem" ]] && origem="${origem%/}/config/niri/config.kdl"
if [[ ! -f "$origem" ]]; then
  echo "não achei a configuração do niri${origem:+ em $origem}" >&2
  echo "passe uma pasta de jangada-mapear ou um config.kdl" >&2
  exit 1
fi

mkdir -p "$saida/hypr"
python3 - "$origem" "$JANGADA_PATH/default/hypr/atalhos.lua" "$saida" "$HOME" <<'PY'
import os, re, shlex, sys
from datetime import date

origem, atalhos_padrao, saida, home = sys.argv[1:5]

# --- Leitura do KDL -----------------------------------------------------------
# Não é um leitor completo de KDL: basta para a configuração do niri, que usa
# nós de uma linha e blocos entre chaves. Comentários de linha saem antes.
def sem_comentario(linha):
    dentro, i = False, 0
    while i < len(linha):
        c = linha[i]
        if c == "\\" and dentro:
            i += 2
            continue
        if c == '"':
            dentro = not dentro
        elif not dentro and linha.startswith("//", i):
            return linha[:i]
        i += 1
    return linha

texto = open(origem, encoding="utf-8").read()
texto = re.sub(r"/\*.*?\*/", "", texto, flags=re.S)
linhas = [sem_comentario(l) for l in texto.splitlines()]
# Nós desligados com "/-" somem, junto com o bloco que abrem.
limpo, pular = [], 0
for l in linhas:
    if pular:
        pular += l.count("{") - l.count("}")
        continue
    if l.strip().startswith("/-"):
        pular = l.count("{") - l.count("}")
        continue
    limpo.append(l)
texto = "\n".join(limpo)

def blocos(nome, t=texto):
    """Conteúdo de cada bloco `nome ... { ... }` no nível em que aparecer."""
    for m in re.finditer(r'(?m)^\s*' + nome + r'\b([^{\n]*)\{', t):
        nivel, i = 1, m.end()
        while i < len(t) and nivel:
            nivel += {"{": 1, "}": -1}.get(t[i], 0)
            i += 1
        yield m.group(1).strip(), t[m.end():i - 1]

def decodificar_escape(m):
    g = m.group(1)
    if g == 'n': return '\n'
    if g == 'r': return '\r'
    if g == 't': return '\t'
    if g == '"': return '"'
    if g == '\\': return '\\'
    if g.startswith('u{') and g.endswith('}'):
        try:
            return chr(int(g[2:-1], 16))
        except (ValueError, OverflowError):
            return m.group(0)
    return g

def decodificar_str(s):
    return re.sub(r'\\(u\{[0-9a-fA-F]+\}|["\\nrt])', decodificar_escape, s)

def textos(s):
    return [decodificar_str(x) for x in re.findall(r'"((?:[^"\\]|\\.)*)"', s)]

def valor(bloco, chave):
    m = re.search(r'(?m)^\s*' + re.escape(chave) + r'\s+("?)([^"\n;]*)\1', bloco)
    return m.group(2).strip() if m else None

avisos = []
if re.search(r'(?m)^\s*include\s', texto):
    avisos.append("o config.kdl usa include; os arquivos incluídos não foram lidos")

# --- Atalhos do jangada --------------------------------------------------------
# Lê as teclas de default/hypr/atalhos.lua. Os laços do arquivo (setas e
# números) registram SUPER + tecla e SUPER + SHIFT + tecla.
MODS = ["SUPER", "CTRL", "ALT", "SHIFT"]
def normalizar(teclas):
    """Modificadores em ordem fixa e em maiúsculas; teclas XF86 mantêm a caixa."""
    partes = [p.strip() for p in teclas.split("+") if p.strip()]
    mods = sorted({p.upper() for p in partes if p.upper() in MODS}, key=MODS.index)
    resto = [p if p.upper().startswith("XF86") else p.upper()
             for p in partes if p.upper() not in MODS]
    return " + ".join(mods + resto)

def chave(teclas):
    return normalizar(teclas).upper()

padrao = {}
if os.path.exists(atalhos_padrao):
    lua = open(atalhos_padrao, encoding="utf-8").read()
    for m in re.finditer(r'j\.atalho\((SUPER \.\. )?"([^"]+)",\s*"([^"]*)"', lua):
        teclas = ("SUPER" if m.group(1) else "") + m.group(2)
        padrao[chave(teclas)] = m.group(3)
    for tecla in re.findall(r'tecla = "(\w+)"', lua):
        padrao.setdefault(chave("SUPER + " + tecla), "foco")
        padrao.setdefault(chave("SUPER + SHIFT + " + tecla), "trocar janela")
    if "i % 10" in lua:
        for n in range(10):
            padrao.setdefault(chave(f"SUPER + {n}"), f"workspace {n or 10}")
            padrao.setdefault(chave(f"SUPER + SHIFT + {n}"), f"mover para workspace {n or 10}")

NIRI_MOD = {"MOD": "SUPER", "SUPER": "SUPER", "WIN": "SUPER", "CTRL": "CTRL",
            "CONTROL": "CTRL", "ALT": "ALT", "SHIFT": "SHIFT"}
def teclas_niri(t):
    partes = t.split("+")
    mods = [NIRI_MOD.get(p.upper(), p.upper()) for p in partes[:-1]]
    tecla = partes[-1]
    return normalizar(" + ".join(mods + [tecla]))

def lua_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r") + '"'

def coment(s):
    return re.sub(r"[\r\n]+", " ", str(s))

def lua_teclas(t):
    if t.startswith("SUPER + "):
        return "SUPER .. " + lua_str(t[len("SUPER"):])
    return lua_str(t)

def lua_cmd(cmd):
    """Texto Lua do comando, com $HOME trocado por j.home."""
    if home and home + "/" in cmd:
        pedacos = cmd.split(home)
        return " .. ".join(
            ([lua_str(pedacos[0])] if pedacos[0] else [])
            + [x for p in pedacos[1:] for x in ("j.home", lua_str(p))])
    return lua_str(cmd)

# --- Terminal -------------------------------------------------------------------
TERMINAIS = {"ghostty", "kitty", "foot", "alacritty"}
terminal = ""

def rotulo_de(cmd):
    """O comando, sem a pasta do programa e com no máximo 60 caracteres."""
    partes = cmd.split(None, 1)
    r = " ".join([os.path.basename(partes[0])] + partes[1:])
    return r if len(r) <= 60 else r[:59] + "…"

def comando(args):
    """Lista de argumentos do spawn virando (comando Lua, rótulo)."""
    if len(args) >= 3 and args[0] in ("sh", "bash") and args[1] == "-c":
        args = [args[2]] if len(args) == 3 else args
        if len(args) == 1:
            cmd = args[0]
            return lua_cmd(cmd), rotulo_de(cmd)
    base = os.path.basename(args[0])
    if base in TERMINAIS and len(args) > 1:
        titulo, resto, i = "", [], 1
        while i < len(args):
            a = args[i]
            if a in ("--title", "-T", "--titulo") and i + 1 < len(args):
                titulo = args[i + 1]; i += 2; continue
            if a.startswith("--title="):
                titulo = a.split("=", 1)[1]; i += 1; continue
            if a == "-e":
                resto = args[i + 1:]; break
            resto = None; break
        if resto is not None:
            if resto[:2] in (["sh", "-c"], ["bash", "-c"]) and len(resto) == 3:
                resto = [resto[2]]
            opc = (["--titulo", titulo] if titulo else []) + (["-e"] + resto if resto else [])
            texto_opc = " ".join(shlex.quote(x) if " " in x else x for x in opc)
            rotulo = titulo or (os.path.basename(resto[0].split()[0]) if resto else "Terminal")
            return 'j.cmd("jangada-terminal", ' + lua_cmd(texto_opc) + ")", rotulo
    cmd = " ".join(shlex.quote(a) for a in args)
    return lua_cmd(cmd), rotulo_de(cmd)

# --- Equivalentes das ações do niri ---------------------------------------------
DIRECAO = {"left": "l", "right": "r", "up": "u", "down": "d"}
NOME_DIR = {"left": "à esquerda", "right": "à direita", "up": "acima", "down": "abaixo"}
def acao_niri(acao, arg):
    m = re.fullmatch(r"focus-(?:column|window)-(left|right|up|down)", acao)
    if m:
        return f'hl.dsp.focus({{ direction = "{DIRECAO[m.group(1)]}" }})', "Foco " + NOME_DIR[m.group(1)]
    m = re.fullmatch(r"move-(?:column|window)-(left|right|up|down)", acao)
    if m:
        return f'hl.dsp.window.swap({{ direction = "{DIRECAO[m.group(1)]}" }})', "Trocar janela " + NOME_DIR[m.group(1)]
    if acao == "close-window":
        return "hl.dsp.window.close()", "Fechar janela"
    if acao == "fullscreen-window":
        return 'hl.dsp.window.fullscreen({ mode = "fullscreen" })', "Tela cheia"
    if acao == "maximize-column":
        return 'hl.dsp.window.fullscreen({ mode = "maximized" })', "Preencher a tela"
    if acao == "toggle-window-floating":
        return 'hl.dsp.window.float({ action = "toggle" })', "Alternar flutuante"
    if acao == "focus-workspace" and arg:
        return f'hl.dsp.focus({{ workspace = {lua_str(arg)} }})', "Workspace " + coment(arg)
    if acao in ("move-column-to-workspace", "move-window-to-workspace") and arg:
        return f'hl.dsp.window.move({{ workspace = {lua_str(arg)} }})', "Mover para workspace " + coment(arg)
    if acao in ("focus-workspace-down", "focus-workspace-up"):
        d = "+1" if acao.endswith("down") else "-1"
        return f'hl.dsp.focus({{ workspace = "e{d}" }})', "Workspace " + ("seguinte" if d == "+1" else "anterior")
    m = re.fullmatch(r'set-column-width', acao)
    if m and re.fullmatch(r'"?[-+]\d+%?"?', arg or ""):
        passo = -100 if "-" in arg else 100
        return (f"hl.dsp.window.resize({{ x = {passo}, y = 0 }})",
                "Estreitar" if passo < 0 else "Alargar")
    if acao in ("screenshot", "screenshot-window"):
        return 'j.cmd("jangada-captura", "regiao")', "Capturar região"
    if acao == "screenshot-screen":
        return 'j.cmd("jangada-captura", "tela")', "Capturar tela inteira"
    if acao == "quit":
        return "hl.dsp.exit()", "Encerrar a sessão"
    return None

# Chamadas ao Noctalia que o jangada faz por conta própria, em qualquer interface.
NOCTALIA = {
    "lockScreen": ('j.cmd("jangada-bloquear")', "Bloquear a tela"),
    "sessionMenu": ('j.cmd("jangada-menu")', "Menu jangada"),
}

ativos, conflitos, sem_par = [], [], []
for _, corpo in blocos("binds"):
    for m in re.finditer(r'(?m)^\s*([\w+]+)((?:\s+[\w-]+=\S+)*)\s*\{([^}]*)\}', corpo):
        tecla_n, props, acoes = m.group(1), m.group(2), m.group(3).strip().rstrip(";").strip()
        teclas = teclas_niri(tecla_n)
        opc = []
        if "allow-when-locked=true" in props:
            opc.append("locked = true")
        titulo = re.search(r'hotkey-overlay-title="([^"]*)"', props)
        am = re.match(r'([\w-]+)\s*(.*)', acoes, re.S)
        if not am:
            continue
        acao, resto = am.group(1), am.group(2)
        args = textos(resto)
        if acao in ("spawn", "spawn-sh"):
            if acao == "spawn-sh":
                args = ["sh", "-c", " ".join(args)]
            if not args:
                continue
            junto = " ".join(args)
            if re.search(r"\bqs\b.*noctalia|noctalia-shell|\bnoctalia\s+msg\b", junto):
                eq = next((v for k, v in NOCTALIA.items() if k in junto), None)
                if not eq:
                    sem_par.append((tecla_n, "Noctalia: " + junto))
                    continue
                expr, rotulo = eq
            else:
                if teclas == "SUPER + RETURN" and os.path.basename(args[0]) in TERMINAIS:
                    terminal = os.path.basename(args[0])
                expr, rotulo = comando(args)
        else:
            eq = acao_niri(acao, args[0] if args else resto.strip().strip('"'))
            if not eq:
                sem_par.append((tecla_n, acoes))
                continue
            expr, rotulo = eq
            if "resize" in expr:
                opc.append("repeating = true")
        if titulo:
            rotulo = titulo.group(1)
        linha = f"j.atalho({lua_teclas(teclas)}, {lua_str(rotulo)}, {expr}"
        linha += (", { " + ", ".join(opc) + " })") if opc else ")"
        if chave(teclas) in padrao:
            conflitos.append((teclas, padrao[chave(teclas)], linha))
        else:
            ativos.append(linha)

# --- Teclado, ambiente e programas ao iniciar ----------------------------------
entrada = []
for _, inp in blocos("input"):
    for _, kb in blocos("keyboard", inp):
        for _, xkb in blocos("xkb", kb):
            for chave, hypr in (("layout", "kb_layout"), ("variant", "kb_variant"),
                                ("options", "kb_options"), ("model", "kb_model")):
                v = valor(xkb, chave)
                if v:
                    entrada.append(f"{hypr} = {lua_str(v)},")
        for chave, hypr in (("repeat-rate", "repeat_rate"), ("repeat-delay", "repeat_delay")):
            v = valor(kb, chave)
            if v and v.isdigit():
                entrada.append(f"{hypr} = {v},")
    break

ambiente = []
for _, env in blocos("environment"):
    for m in re.finditer(r'(?m)^\s*([A-Za-z_][A-Za-z0-9_]*)\s+("(?:[^"\\]|\\.)*"|null)', env):
        nome, v = m.group(1), m.group(2)
        if v == "null":
            continue
        ambiente.append((nome, textos(v)[0]))

# O Hyprland já traz o XWayland e o jangada sobe barra, notificações e agente de
# senha; esses programas do niri ficam de fora.
PULAR_INICIO = re.compile(r"noctalia|\bqs\b|xwayland-satellite|polkit|waybar|mako|swaync|dunst|swaybg|hyprpaper")
inicio, inicio_pulado = [], []
for m in re.finditer(r'(?m)^\s*spawn(-sh)?-at-startup\s+(.*)$', texto):
    args = textos(m.group(2))
    if not args:
        continue
    junto = " ".join(args) if not m.group(1) else args[0]
    if m.group(1) is None and len(args) >= 3 and args[0] in ("sh", "bash") and args[1] == "-c":
        junto = args[2]
    (inicio_pulado if PULAR_INICIO.search(junto) else inicio).append(junto)

# --- Monitores -------------------------------------------------------------------
TRANSFORM = {"normal": 0, "90": 1, "180": 2, "270": 3, "flipped": 4,
             "flipped-90": 5, "flipped-180": 6, "flipped-270": 7}
monitores = []
for cab, corpo in blocos("output"):
    # O KDL 2 aceita nome sem aspas (output DP-1 { ... }).
    nome = textos(cab) or cab.split()[:1]
    if not nome:
        continue
    campos = [f"output = {lua_str(nome[0])}"]
    if re.search(r'(?m)^\s*off\s*;?\s*$', corpo):
        campos.append("disabled = true")
        monitores.append("hl.monitor({ " + ", ".join(campos) + " })")
        continue
    modo = valor(corpo, "mode")
    campos.append(f'mode = {lua_str(modo) if modo else lua_str("preferred")}')
    pos = re.search(r'position\s+x=(-?\d+)\s+y=(-?\d+)', corpo)
    campos.append(f'position = {lua_str(pos.group(1) + "x" + pos.group(2)) if pos else lua_str("auto")}')
    esc = valor(corpo, "scale")
    campos.append(f"scale = {esc if esc and re.fullmatch(r'\d+(\.\d+)?', esc) else lua_str('auto')}")
    rot = valor(corpo, "transform")
    if rot in TRANSFORM and TRANSFORM[rot]:
        campos.append(f"transform = {TRANSFORM[rot]}")
    monitores.append("hl.monitor({ " + ", ".join(campos) + " })")

# --- Escrita ---------------------------------------------------------------------
hoje = date.today().strftime("%d/%m/%Y")
cab = [f"-- Importado do niri por jangada-importar em {hoje}.",
       f"-- Origem: {origem}",
       "-- Revise antes de copiar para o arquivo sem a extensão .importado."]
if avisos:
    cab += ["--", "-- Atenção: " + "; ".join(avisos) + "."]

u = cab + ["", 'local SUPER = "SUPER"', ""]
if entrada:
    u += ["-- Teclado", "hl.config({", "  input = {"]
    u += ["    " + e for e in entrada]
    u += ["  },", "})", ""]
# Variáveis de driver valem para a placa desta máquina, e o jangada já escolhe
# a GPU sozinho (JANGADA_GPU): elas saem comentadas, para decidir caso a caso.
GPU_ENV = re.compile(r"^(LIBVA_DRIVER_NAME|__GLX_VENDOR_LIBRARY_NAME|GBM_BACKEND|NVD_BACKEND|"
                     r"__NV_|VDPAU_DRIVER|WLR_|AQ_DRM_DEVICES|DRI_PRIME)")
if ambiente:
    u += ["-- Ambiente"]
    for n, v in ambiente:
        linha = f"hl.env({lua_str(n)}, {lua_str(v)})"
        if GPU_ENV.match(n):
            u.append(f"-- {linha}  -- driver de vídeo: confira se vale nesta máquina")
        else:
            u.append(linha)
    u.append("")
if inicio:
    u += ["-- Programas ao iniciar"] + [f"j.ao_iniciar({lua_cmd(c)})" for c in inicio] + [""]
if inicio_pulado:
    u += ["-- Ficaram de fora (o jangada ou o Hyprland já cuidam disto):"]
    u += [f"--   {coment(c)}" for c in inicio_pulado] + [""]
if ativos:
    u += ["-- Atalhos"] + ativos + [""]
if conflitos:
    u += ["-- Estes batem com atalhos do jangada. Para usar a versão do niri,",
          "-- descomente as duas linhas; o hl.unbind tira o padrão antes."]
    for teclas, desc, linha in conflitos:
        u += [f"-- Padrão do jangada: {desc}",
              f"-- hl.unbind({lua_teclas(teclas)})",
              "-- " + linha]
    u += [""]
if sem_par:
    u += ["-- Sem equivalente direto (ajuste à mão, se quiser):"]
    u += [f"--   {coment(t)}: {coment(a)}" for t, a in sem_par] + [""]

arquivos = {os.path.join(saida, "hypr", "usuario.lua.importado"): "\n".join(u).rstrip() + "\n"}

if monitores:
    mon = cab + ["-- Descubra os nomes na máquina nova com: hyprctl monitors", ""] + monitores
    mon += ["", "-- Qualquer outro monitor entra à direita.",
            'hl.monitor({ output = "", mode = "preferred", position = "auto-right", scale = "auto" })']
    arquivos[os.path.join(saida, "hypr", "monitores.lua.importado")] = "\n".join(mon) + "\n"

if terminal:
    conf = [f"# Importado do niri por jangada-importar em {hoje}.",
            "# Copie as linhas que quiser para o jangada.conf.",
            f"JANGADA_TERMINAL={terminal}"]
    arquivos[os.path.join(saida, "jangada.conf.importado")] = "\n".join(conf) + "\n"

for caminho, conteudo in arquivos.items():
    with open(caminho, "w", encoding="utf-8") as f:
        f.write(conteudo)
    print("gravado:", caminho)
print(f"{len(ativos)} atalhos, {len(conflitos)} em conflito com o padrão, "
      f"{len(sem_par)} sem equivalente, {len(monitores)} monitores")
for a in avisos:
    print("atenção:", a)
PY
echo "Compare com os arquivos atuais antes de copiar, por exemplo:"
echo "  diff -u $saida/hypr/usuario.lua $saida/hypr/usuario.lua.importado"
