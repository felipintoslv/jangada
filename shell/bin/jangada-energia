#!/usr/bin/env bash
# Menu de energia: perfil de consumo, estado da bateria e ações de sessão.
#
# Uso:
#   jangada-energia [menu|status|perfil <nome>]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

menu_fuzzel() {
  jangada_fuzzel --prompt "${1:-energia} > "
}

# Desligar e reiniciar ficam a um clique de distância no módulo da bateria;
# a segunda pergunta existe para que um clique errado não derrube a máquina.
confirmar() {
  local acao="$1" resposta
  resposta="$(printf '%s\n' "Não" "Sim, $acao" | menu_fuzzel "confirmar")" || return 1
  [[ "$resposta" == "Sim,"* ]]
}

# O power-profiles-daemon é opcional: sem o comando, ou com o serviço parado,
# a seção de perfis some do menu em vez de o script quebrar.
tem_perfis() {
  command -v powerprofilesctl >/dev/null 2>&1 && powerprofilesctl get >/dev/null 2>&1
}

icone_perfil() {
  case "$1" in
    balanced)    printf '󰾅' ;;
    power-saver) printf '󰾆' ;;
    *)           printf '󰓅' ;;
  esac
}

# Só o texto, sem ícone: é o que vai para o notify-send, porque o mako pode
# estar com uma fonte sem os glifos da Nerd Font e mostraria um quadrado.
nome_perfil() {
  case "$1" in
    performance) printf 'Desempenho' ;;
    balanced)    printf 'Equilibrado' ;;
    power-saver) printf 'Economia' ;;
    *)           printf '%s' "$1" ;;
  esac
}

# Nomes vindos do powerprofilesctl list, com o ativo marcado pelo get. O
# asterisco da listagem não é usado porque o get já responde isso sozinho.
listar_perfis() {
  local atual nome marca
  atual="$(powerprofilesctl get 2>/dev/null || true)"
  while read -r nome; do
    [[ -n "$nome" ]] || continue
    marca="  "
    [[ "$nome" == "$atual" ]] && marca="✔ "
    printf '%s %s  %s [%s]\n' "$marca" "$(icone_perfil "$nome")" "$(nome_perfil "$nome")" "$nome"
  done < <(powerprofilesctl list 2>/dev/null | sed -n 's/^[* ] \{0,1\}\([a-z-]\{1,\}\):$/\1/p')
}

traduzir_estado() {
  case "$1" in
    Charging)       printf 'carregando' ;;
    Discharging)    printf 'descarregando' ;;
    Full)           printf 'cheia' ;;
    "Not charging") printf 'sem carregar' ;;
    *)              printf 'estado desconhecido' ;;
  esac
}

# Linha informativa: escolher não faz nada. Máquina sem bateria não gera linha.
estado_bateria() {
  local bat capacidade estado icone tomada
  for bat in /sys/class/power_supply/BAT*; do
    [[ -r "$bat/capacity" ]] || continue
    capacidade="$(<"$bat/capacity")"
    estado="$(<"$bat/status")"
    icone='󰁹'
    [[ "$estado" == Charging ]] && icone='󰂄'
    printf '   %s  Bateria %s: %s%% (%s)\n' \
      "$icone" "${bat##*/}" "$capacidade" "$(traduzir_estado "$estado")"
  done
  # Uma máquina pode expor mais de um adaptador (AC0 e ADP1, por exemplo);
  # basta um ligado para a linha dizer que está na tomada.
  local achou=0 ligado=0
  for tomada in /sys/class/power_supply/A{C,DP}*/online; do
    [[ -r "$tomada" ]] || continue
    achou=1
    [[ "$(<"$tomada")" == 1 ]] && ligado=1
  done
  if ((achou)); then
    if ((ligado)); then
      printf '   󰚥  Na tomada\n'
    else
      printf '   󰠠  Fora da tomada\n'
    fi
  fi
}

aplicar_perfil() {
  local nome="$1"
  if powerprofilesctl set "$nome" 2>/dev/null; then
    notify-send -a jangada -u low "Energia" "Perfil de energia: $(nome_perfil "$nome")" 2>/dev/null || true
  else
    notify-send -a jangada -u normal "Energia" "Não foi possível mudar para $nome" 2>/dev/null || true
  fi
}

menu_energia() {
  local opcoes escolha perfis bateria nome

  opcoes=""
  if tem_perfis; then
    perfis="$(listar_perfis)"
    [[ -n "$perfis" ]] && opcoes+="$perfis"$'\n'
  fi

  bateria="$(estado_bateria)"
  [[ -n "$bateria" ]] && opcoes+="$bateria"$'\n'

  opcoes+="󰌾  Bloquear a tela"$'\n'
  opcoes+="󰒲  Suspender"$'\n'
  opcoes+="󰍃  Sair da sessão"$'\n'
  opcoes+="󰜉  Reiniciar"$'\n'
  opcoes+="󰐥  Desligar"

  escolha="$(menu_fuzzel "energia" <<<"$opcoes")" || return 0
  [[ -n "$escolha" ]] || return 0

  case "$escolha" in
    *"Bloquear a tela"*)
      setsid -f "$JANGADA_PATH/bin/jangada-bloquear" >/dev/null 2>&1
      ;;
    *"Suspender"*)
      systemctl suspend
      ;;
    *"Sair da sessão"*)
      hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || true
      ;;
    *"Reiniciar"*)
      if confirmar "reiniciar"; then systemctl reboot; fi
      ;;
    *"Desligar"*)
      if confirmar "desligar"; then systemctl poweroff; fi
      ;;
    *"Bateria"*|*"tomada"*)
      ;;
    *)
      nome="$(sed -n 's/.*\[\([a-z-]\{1,\}\)\]$/\1/p' <<<"$escolha")"
      [[ -n "$nome" ]] && aplicar_perfil "$nome"
      ;;
  esac
}

mostrar_status() {
  if tem_perfis; then
    printf 'perfil: %s\n' "$(powerprofilesctl get 2>/dev/null || echo desconhecido)"
  else
    printf 'perfil: power-profiles-daemon ausente ou parado\n'
  fi
  # Tira a margem e o ícone da linha de menu, deixando só o texto.
  estado_bateria | sed 's/^[^[:alnum:]]*//; s/^/energia: /'
}

case "${1:-menu}" in
  -h|--ajuda)
    sed -n '2,6s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  status)
    mostrar_status
    ;;
  perfil)
    if ! tem_perfis; then
      echo "power-profiles-daemon ausente ou parado" >&2
      exit 1
    fi
    [[ -n "${2:-}" ]] || { echo "uso: jangada-energia perfil <nome>" >&2; exit 1; }
    aplicar_perfil "$2"
    ;;
  menu|*)
    menu_energia
    ;;
esac
