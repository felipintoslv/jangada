#!/usr/bin/env bash
# Calendário interativo do Jangada com memória de eventos marcados.
#
# Uso:
#   jangada-calendario                       abre o calendário gráfico
#   jangada-calendario add [data] "evento"   adiciona um compromisso (ex: add amanhã "14h Reunião")
#   jangada-calendario listar                lista os compromissos agendados
#   jangada-calendario importar arquivo.ics  importa eventos de um arquivo iCalendar
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

exec python3 - "$@" << 'PYEOF'
import sys
import os
import json
import re
import subprocess
import datetime
import calendar
import contextlib
import fcntl
import tempfile

# O Qt só é necessário para a janela. Sem ele, os subcomandos de linha de
# comando (add, listar, importar) continuam funcionando e dá para testá-los.
try:
    from PyQt6.QtWidgets import (
        QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel,
        QPushButton, QLineEdit, QListWidget, QListWidgetItem,
        QGridLayout, QFrame, QScrollArea, QMessageBox
    )
    from PyQt6.QtCore import Qt, QDate, QSize
    from PyQt6.QtGui import QFont, QColor, QPalette, QKeyEvent
    TEM_QT = True
except ImportError:
    TEM_QT = False
    QWidget = object
    QKeyEvent = object

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "jangada",
)
EVENTOS_FILE = os.path.join(CONFIG_DIR, "eventos.json")
TRAVA_FILE = os.path.join(CONFIG_DIR, ".eventos.json.trava")

# Avisos (arquivo corrompido posto de lado) que a janela ainda não mostrou.
AVISOS_PENDENTES = []
CORES_FILE = os.path.join(CONFIG_DIR, "waybar/cores.css")

MESES_PT = [
    "", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
    "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"
]
DIAS_SEMANA_PT = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"]
DIAS_SEMANA_COMPLETO = [
    "Segunda-feira", "Terça-feira", "Quarta-feira",
    "Quinta-feira", "Sexta-feira", "Sábado", "Domingo"
]

def carregar_cores():
    cores = {
        "superficie": "#14171a",
        "texto": "#e0e3e8",
        "texto_suave": "#9da4ae",
        "primaria": "#95cdf7",
        "texto_primario": "#00344e",
        "atencao": "#cec0e8",
        "borda": "#262b32",
    }
    if os.path.exists(CORES_FILE):
        try:
            with open(CORES_FILE, "r", encoding="utf-8") as f:
                for linha in f:
                    m = re.search(r"@define-color\s+([a-zA-Z0-9_]+)\s+(#[0-9a-fA-F]+);", linha)
                    if m:
                        cores[m.group(1)] = m.group(2)
        except Exception:
            pass
    return cores

class ErroEventos(Exception):
    """Falha ao ler ou gravar o arquivo de eventos; nada foi gravado."""

def avisar(mensagem):
    print(f"jangada-calendario: {mensagem}", file=sys.stderr)
    AVISOS_PENDENTES.append(mensagem)

@contextlib.contextmanager
def trava_eventos():
    """Trava exclusiva entre processos para ler, alterar e gravar os eventos.

    O arquivo de trava fica na mesma pasta e é aberto sem seguir link
    simbólico, para ninguém apontar a trava para outro arquivo.
    """
    os.makedirs(CONFIG_DIR, exist_ok=True)
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(TRAVA_FILE, flags, 0o600)
    except OSError as e:
        raise ErroEventos(f"não consegui abrir a trava {TRAVA_FILE}: {e}") from e
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)  # fechar o descritor solta a trava

def formato_valido(dados):
    """Os eventos são um objeto {"aaaa-mm-dd": ["texto", ...]}."""
    if not isinstance(dados, dict):
        return False
    return all(isinstance(k, str) and isinstance(v, list)
               and all(isinstance(t, str) for t in v)
               for k, v in dados.items())

def por_de_lado(motivo):
    """Move o arquivo ilegível para .corrompido-<data>, sem apagar nada."""
    carimbo = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    destino = f"{EVENTOS_FILE}.corrompido-{carimbo}"
    n = 1
    while os.path.lexists(destino):
        n += 1
        destino = f"{EVENTOS_FILE}.corrompido-{carimbo}-{n}"
    try:
        os.rename(EVENTOS_FILE, destino)
    except OSError as e:
        raise ErroEventos(
            f"{EVENTOS_FILE} está ilegível ({motivo}) e não consegui "
            f"guardá-lo à parte: {e}. Nada foi gravado."
        ) from e
    avisar(
        f"o arquivo de eventos estava ilegível ({motivo}). Ele foi guardado "
        f"em {destino} e o calendário começa vazio; os eventos antigos podem "
        "ser recuperados de lá."
    )

def _carregar_travado():
    """Lê os eventos; quem chama já segura a trava."""
    try:
        with open(EVENTOS_FILE, "r", encoding="utf-8") as f:
            dados = json.load(f)
    except FileNotFoundError:
        return {}
    except (json.JSONDecodeError, UnicodeDecodeError) as e:
        por_de_lado(f"JSON inválido: {e}")
        return {}
    except OSError as e:
        # Permissão negada, pasta no lugar do arquivo etc.: não é corrupção,
        # e gravar por cima apagaria os dados; então para aqui.
        raise ErroEventos(f"não consegui ler {EVENTOS_FILE}: {e}") from e
    if not formato_valido(dados):
        por_de_lado("formato inesperado")
        return {}
    return dados

def carregar_eventos():
    with trava_eventos():
        return _carregar_travado()

def salvar_eventos(eventos):
    """Grava de forma atômica: temporário na mesma pasta, fsync e os.replace.

    Uma queda no meio deixa o arquivo antigo inteiro, nunca um pela metade.
    Quem chama já segura a trava (use alterar_eventos).
    """
    os.makedirs(CONFIG_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".eventos.json.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(eventos, f, ensure_ascii=False, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, EVENTOS_FILE)
    except BaseException as e:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        if isinstance(e, OSError):
            raise ErroEventos(f"não consegui gravar {EVENTOS_FILE}: {e}") from e
        raise
    # Garante que a troca de nome também chegou ao disco.
    with contextlib.suppress(OSError):
        dfd = os.open(CONFIG_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)

def alterar_eventos(mudanca):
    """Aplica uma alteração sem perder as de outros processos.

    Sob a trava: relê o arquivo do disco, aplica só a mudança pedida e grava.
    Devolve os eventos como ficaram, para a janela se atualizar. A função
    mudanca recebe o dicionário e o altera no lugar; se devolver False, nada
    é gravado.
    """
    with trava_eventos():
        eventos = _carregar_travado()
        if mudanca(eventos) is not False:
            salvar_eventos(eventos)
        return eventos

def normalizar_data(texto_data):
    hoje = datetime.date.today()
    txt = texto_data.strip().lower()
    if txt in ["hoje", "today"]:
        return hoje.strftime("%Y-%m-%d")
    if txt in ["amanha", "amanhã", "tomorrow"]:
        return (hoje + datetime.timedelta(days=1)).strftime("%Y-%m-%d")
    if txt in ["depois de amanha", "depois de amanhã"]:
        return (hoje + datetime.timedelta(days=2)).strftime("%Y-%m-%d")
    m = re.match(r"^(\d{1,2})/(\d{1,2})(?:/(\d{4}))?$", txt)
    if m:
        dia = int(m.group(1))
        mes = int(m.group(2))
        ano = int(m.group(3)) if m.group(3) else hoje.year
        return datetime.date(ano, mes, dia).strftime("%Y-%m-%d")
    m = re.match(r"^(\d{4})-(\d{1,2})-(\d{1,2})$", txt)
    if m:
        return datetime.date(int(m.group(1)), int(m.group(2)), int(m.group(3))).strftime("%Y-%m-%d")
    return None

def cli_adicionar(args):
    if not args:
        print("Uso: jangada-calendario add [data] 'descrição do evento'", file=sys.stderr)
        sys.exit(1)
    data_str = None
    texto = None
    if len(args) == 1:
        data_str = datetime.date.today().strftime("%Y-%m-%d")
        texto = args[0]
    else:
        d = normalizar_data(args[0])
        if d:
            data_str = d
            texto = " ".join(args[1:])
        else:
            d2 = normalizar_data(args[-1])
            if d2:
                data_str = d2
                texto = " ".join(args[:-1])
            else:
                data_str = datetime.date.today().strftime("%Y-%m-%d")
                texto = " ".join(args)

    alterar_eventos(lambda eventos: eventos.setdefault(data_str, []).append(texto))

    ano, mes, dia = map(int, data_str.split("-"))
    print(f"✔ Compromisso adicionado em {dia:02d}/{mes:02d}/{ano}: {texto}")
    # O texto do evento vem do usuário: vai como argumento, não interpolado
    # numa linha de comando, senão um apóstrofo na descrição quebra a chamada.
    try:
        subprocess.run(
            ["notify-send", "-a", "jangada", "-u", "low", "Calendário",
             f"Evento agendado para {dia:02d}/{mes:02d}: {texto}"],
            check=False,
        )
    except FileNotFoundError:
        pass

def cli_listar():
    eventos = carregar_eventos()
    if not eventos:
        print("Nenhum evento registrado no calendário.")
        return
    hoje = datetime.date.today()
    hoje_str = hoje.strftime("%Y-%m-%d")
    amanha_str = (hoje + datetime.timedelta(days=1)).strftime("%Y-%m-%d")

    chaves_ordenadas = sorted(eventos.keys())
    print("\n📅 Compromissos no calendário:\n")
    total = 0
    for ch in chaves_ordenadas:
        evs = eventos[ch]
        if not evs:
            continue
        ano, mes, dia = map(int, ch.split("-"))
        sufixo = ""
        if ch == hoje_str:
            sufixo = " (Hoje)"
        elif ch == amanha_str:
            sufixo = " (Amanhã)"

        print(f"  {dia:02d}/{mes:02d}/{ano}{sufixo}:")
        for ev in evs:
            print(f"    • {ev}")
            total += 1
    print(f"\nTotal: {total} compromisso(s) registrado(s).\n")

def cli_importar(args):
    if not args:
        print("Uso: jangada-calendario importar caminho/arquivo.ics", file=sys.stderr)
        sys.exit(1)
    caminho = os.path.expanduser(args[0])
    if not os.path.exists(caminho):
        print(f"Arquivo não encontrado: {caminho}", file=sys.stderr)
        sys.exit(1)

    # Lê o .ics antes, fora da trava, e só depois aplica ao arquivo relido.
    lidos = []
    with open(caminho, "r", encoding="utf-8", errors="ignore") as f:
        em_vevent = False
        data_evento = None
        resumo = None
        for linha in f:
            linha = linha.strip()
            if linha == "BEGIN:VEVENT":
                em_vevent = True
                data_evento = None
                resumo = None
            elif linha == "END:VEVENT":
                if data_evento and resumo:
                    lidos.append((data_evento, resumo))
                em_vevent = False
            elif em_vevent:
                if linha.startswith("DTSTART"):
                    m = re.search(r"(\d{4})(\d{2})(\d{2})", linha)
                    if m:
                        data_evento = f"{m.group(1)}-{m.group(2)}-{m.group(3)}"
                elif linha.startswith("SUMMARY:"):
                    resumo = linha[8:].strip()

    adicionados = 0

    def importar(eventos):
        nonlocal adicionados
        for data_evento, resumo in lidos:
            dia = eventos.setdefault(data_evento, [])
            if resumo not in dia:
                dia.append(resumo)
                adicionados += 1
        return adicionados > 0

    alterar_eventos(importar)
    print(f"✔ {adicionados} evento(s) importados com sucesso para o calendário.")

class CalendarioJangada(QWidget):
    def __init__(self):
        super().__init__()
        self.cores = carregar_cores()
        try:
            self.eventos = carregar_eventos()
        except ErroEventos as e:
            # Sem conseguir ler, a janela não abre: gravar por cima perderia dados.
            QMessageBox.critical(None, "Calendário", str(e))
            raise SystemExit(1)
        
        hoje = datetime.date.today()
        self.ano_atual = hoje.year
        self.mes_atual = hoje.month
        self.data_selecionada = hoje
        
        self.init_ui()
        self.atualizar_calendario()
        self.atualizar_painel_eventos()

    def mostrar_avisos(self):
        while AVISOS_PENDENTES:
            QMessageBox.warning(self, "Calendário", AVISOS_PENDENTES.pop(0))

    def showEvent(self, event):
        super().showEvent(event)
        self.mostrar_avisos()

    def aplicar(self, mudanca):
        """Relê do disco sob trava, aplica só a mudança e mostra o que ficou."""
        try:
            self.eventos = alterar_eventos(mudanca)
        except ErroEventos as e:
            print(f"jangada-calendario: {e}", file=sys.stderr)
            QMessageBox.critical(self, "Calendário", str(e))
            return False
        self.atualizar_calendario()
        self.atualizar_painel_eventos()
        self.mostrar_avisos()
        return True

    def init_ui(self):
        self.setWindowTitle("Calendário Jangada")
        self.setObjectName("CalendarioWindow")
        self.resize(740, 520)
        self.setStyleSheet(f"""
            QWidget#CalendarioWindow {{
                background-color: {self.cores['superficie']};
                color: {self.cores['texto']};
                font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', sans-serif;
            }}
            QLabel {{
                color: {self.cores['texto']};
            }}
            QPushButton {{
                background-color: transparent;
                color: {self.cores['texto']};
                border: 1px solid transparent;
                border-radius: 6px;
                padding: 5px;
                font-size: 13px;
            }}
            QPushButton:hover {{
                background-color: rgba(255, 255, 255, 0.08);
            }}
            QLineEdit {{
                background-color: rgba(255, 255, 255, 0.05);
                color: {self.cores['texto']};
                border: 1px solid {self.cores.get('borda', '#333')};
                border-radius: 6px;
                padding: 7px 10px;
                font-size: 13px;
            }}
            QLineEdit:focus {{
                border: 1px solid {self.cores['primaria']};
            }}
            QListWidget {{
                background-color: rgba(255, 255, 255, 0.02);
                border: 1px solid {self.cores.get('borda', '#333')};
                border-radius: 6px;
                padding: 4px;
                color: {self.cores['texto']};
            }}
            QListWidget::item {{
                padding: 6px 8px;
                border-radius: 4px;
            }}
            QListWidget::item:hover {{
                background-color: rgba(255, 255, 255, 0.06);
            }}
        """)

        layout_principal = QHBoxLayout(self)
        layout_principal.setContentsMargins(18, 18, 18, 18)
        layout_principal.setSpacing(20)

        # Painel Esquerdo: Mês e Grade
        painel_esquerdo = QVBoxLayout()
        painel_esquerdo.setSpacing(10)

        # Cabeçalho do Mês
        header_layout = QHBoxLayout()
        self.btn_anterior = QPushButton("◀")
        self.btn_anterior.setFixedSize(32, 32)
        self.btn_anterior.clicked.connect(self.mes_anterior)

        self.lbl_mes_ano = QLabel("")
        self.lbl_mes_ano.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.lbl_mes_ano.setStyleSheet(f"font-size: 16px; font-weight: bold; color: {self.cores['primaria']};")

        self.btn_proximo = QPushButton("▶")
        self.btn_proximo.setFixedSize(32, 32)
        self.btn_proximo.clicked.connect(self.mes_proximo)

        self.btn_hoje = QPushButton("Hoje")
        self.btn_hoje.setFixedHeight(30)
        self.btn_hoje.setStyleSheet("background: rgba(255,255,255,0.06); padding: 4px 10px; font-weight: bold;")
        self.btn_hoje.clicked.connect(self.ir_para_hoje)

        header_layout.addWidget(self.btn_anterior)
        header_layout.addWidget(self.lbl_mes_ano, 1)
        header_layout.addWidget(self.btn_proximo)
        header_layout.addWidget(self.btn_hoje)
        painel_esquerdo.addLayout(header_layout)

        # Grade de dias
        self.grid_dias = QGridLayout()
        self.grid_dias.setSpacing(4)

        for col, dia_nome in enumerate(DIAS_SEMANA_PT):
            lbl = QLabel(dia_nome)
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            lbl.setStyleSheet(f"font-size: 11px; font-weight: bold; color: {self.cores['texto_suave']}; padding: 4px;")
            self.grid_dias.addWidget(lbl, 0, col)

        self.botoes_dias = []
        for lin in range(1, 7):
            linha_botoes = []
            for col in range(7):
                btn = QPushButton("")
                btn.setFixedSize(44, 38)
                btn.setCursor(Qt.CursorShape.PointingHandCursor)
                self.grid_dias.addWidget(btn, lin, col)
                linha_botoes.append(btn)
            self.botoes_dias.append(linha_botoes)

        painel_esquerdo.addLayout(self.grid_dias)
        layout_principal.addLayout(painel_esquerdo, 5)

        linha_div = QFrame()
        linha_div.setFrameShape(QFrame.Shape.VLine)
        linha_div.setStyleSheet(f"color: {self.cores.get('borda', '#333')};")
        layout_principal.addWidget(linha_div)

        # Painel Direito: Detalhes do Dia e Eventos
        painel_direito = QVBoxLayout()
        painel_direito.setSpacing(10)

        self.lbl_data_selecionada = QLabel("")
        self.lbl_data_selecionada.setStyleSheet(f"font-size: 14px; font-weight: bold; color: {self.cores['primaria']};")
        painel_direito.addWidget(self.lbl_data_selecionada)

        lbl_eventos_tit = QLabel("Eventos marcados:")
        lbl_eventos_tit.setStyleSheet(f"font-size: 12px; color: {self.cores['texto_suave']};")
        painel_direito.addWidget(lbl_eventos_tit)

        self.lista_eventos = QListWidget()
        painel_direito.addWidget(self.lista_eventos, 1)

        add_layout = QHBoxLayout()
        self.txt_novo_evento = QLineEdit()
        self.txt_novo_evento.setPlaceholderText("Novo evento (ex: 14:00 Reunião)...")
        self.txt_novo_evento.returnPressed.connect(self.adicionar_evento)

        self.btn_add_evento = QPushButton("+ Adicionar")
        self.btn_add_evento.setStyleSheet(f"""
            QPushButton {{
                background-color: {self.cores['primaria']};
                color: {self.cores['texto_primario']};
                font-weight: bold;
                padding: 7px 12px;
            }}
            QPushButton:hover {{
                background-color: {self.cores['texto']};
            }}
        """)
        self.btn_add_evento.clicked.connect(self.adicionar_evento)

        self.btn_remover_evento = QPushButton("Remover")
        self.btn_remover_evento.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(255, 255, 255, 0.08);
                color: {self.cores['texto_suave']};
                padding: 7px 10px;
            }}
            QPushButton:hover {{
                background-color: rgba(230, 80, 80, 0.3);
                color: #ff8888;
            }}
        """)
        self.btn_remover_evento.clicked.connect(self.remover_evento_selecionado)

        add_layout.addWidget(self.txt_novo_evento, 1)
        add_layout.addWidget(self.btn_add_evento)
        add_layout.addWidget(self.btn_remover_evento)
        painel_direito.addLayout(add_layout)

        self.lbl_proximos = QLabel("")
        self.lbl_proximos.setStyleSheet(f"font-size: 11px; color: {self.cores['texto_suave']}; margin-top: 4px;")
        painel_direito.addWidget(self.lbl_proximos)

        layout_principal.addLayout(painel_direito, 6)

    def mes_anterior(self):
        if self.mes_atual == 1:
            self.mes_atual = 12
            self.ano_atual -= 1
        else:
            self.mes_atual -= 1
        self.atualizar_calendario()

    def mes_proximo(self):
        if self.mes_atual == 12:
            self.mes_atual = 1
            self.ano_atual += 1
        else:
            self.mes_atual += 1
        self.atualizar_calendario()

    def ir_para_hoje(self):
        hoje = datetime.date.today()
        self.ano_atual = hoje.year
        self.mes_atual = hoje.month
        self.data_selecionada = hoje
        self.atualizar_calendario()
        self.atualizar_painel_eventos()

    def atualizar_calendario(self):
        self.lbl_mes_ano.setText(f"{MESES_PT[self.mes_atual]} {self.ano_atual}")
        
        hoje = datetime.date.today()
        cal = calendar.Calendar(firstweekday=0)
        dias_mes = list(cal.itermonthdates(self.ano_atual, self.mes_atual))

        idx = 0
        for lin in range(6):
            for col in range(7):
                btn = self.botoes_dias[lin][col]
                if idx < len(dias_mes):
                    data = dias_mes[idx]
                    btn.setVisible(True)
                    
                    chave_data = data.strftime("%Y-%m-%d")
                    tem_eventos = bool(self.eventos.get(chave_data))
                    
                    texto_dia = str(data.day)
                    if tem_eventos:
                        texto_dia += " •"

                    btn.setText(texto_dia)
                    btn.disconnect()
                    btn.clicked.connect(lambda checked, d=data: self.selecionar_dia(d))

                    eh_mes_atual = (data.month == self.mes_atual)
                    eh_hoje = (data == hoje)
                    eh_selecionado = (data == self.data_selecionada)

                    estilo = "border-radius: 6px; font-size: 13px; "
                    if eh_selecionado:
                        estilo += f"background-color: {self.cores['primaria']}; color: {self.cores['texto_primario']}; font-weight: bold;"
                    elif eh_hoje:
                        estilo += f"border: 2px solid {self.cores['primaria']}; color: {self.cores['primaria']}; font-weight: bold;"
                        if tem_eventos:
                            estilo += " background-color: rgba(255, 255, 255, 0.08);"
                    elif tem_eventos:
                        estilo += f"background-color: rgba(255, 255, 255, 0.08); color: {self.cores['atencao']}; font-weight: bold;"
                    elif eh_mes_atual:
                        estilo += f"color: {self.cores['texto']};"
                    else:
                        estilo += "color: rgba(255, 255, 255, 0.22);"

                    btn.setStyleSheet(f"QPushButton {{ {estilo} }} QPushButton:hover {{ background-color: rgba(255,255,255,0.15); }}")
                    idx += 1
                else:
                    btn.setVisible(False)

    def selecionar_dia(self, data):
        self.data_selecionada = data
        if data.month != self.mes_atual or data.year != self.ano_atual:
            self.ano_atual = data.year
            self.mes_atual = data.month
        self.atualizar_calendario()
        self.atualizar_painel_eventos()

    def atualizar_painel_eventos(self):
        d = self.data_selecionada
        dia_sem = DIAS_SEMANA_COMPLETO[d.weekday()]
        dia_txt = f"{dia_sem}, {d.day} de {MESES_PT[d.month]} de {d.year}"
        self.lbl_data_selecionada.setText(dia_txt)

        self.lista_eventos.clear()
        chave = d.strftime("%Y-%m-%d")
        evs = self.eventos.get(chave, [])

        if not evs:
            item = QListWidgetItem("Nenhum evento para este dia.")
            item.setFlags(Qt.ItemFlag.NoItemFlags)
            item.setForeground(QColor(self.cores['texto_suave']))
            self.lista_eventos.addItem(item)
        else:
            for ev in evs:
                item = QListWidgetItem(f"󰸗  {ev}")
                self.lista_eventos.addItem(item)

        hoje = datetime.date.today()
        proximos = []
        for i in range(1, 15):
            futura = hoje + datetime.timedelta(days=i)
            ch = futura.strftime("%Y-%m-%d")
            if ch in self.eventos and self.eventos[ch]:
                for ev in self.eventos[ch]:
                    proximos.append(f"{futura.day}/{futura.month}: {ev}")
                    if len(proximos) >= 2:
                        break
            if len(proximos) >= 2:
                break

        if proximos:
            self.lbl_proximos.setText("Próximos: " + " · ".join(proximos))
        else:
            self.lbl_proximos.setText("Nenhum evento nos próximos 14 dias.")

    def adicionar_evento(self):
        texto = self.txt_novo_evento.text().strip()
        if not texto:
            return
        chave = self.data_selecionada.strftime("%Y-%m-%d")
        if self.aplicar(lambda eventos: eventos.setdefault(chave, []).append(texto)):
            self.txt_novo_evento.clear()

    def remover_evento_selecionado(self):
        linha = self.lista_eventos.currentRow()
        chave = self.data_selecionada.strftime("%Y-%m-%d")
        evs = self.eventos.get(chave, [])
        if not 0 <= linha < len(evs):
            return
        # A posição na lista pode ter mudado no disco (outra janela, o add):
        # remove pelo texto mostrado e, se ele já não existir, não mexe em nada.
        texto = evs[linha]
        # Entre repetições do mesmo texto, qual delas é a escolhida.
        ocorrencia = evs[:linha].count(texto)

        def remover(eventos):
            dia = eventos.get(chave, [])
            posicoes = [i for i, t in enumerate(dia) if t == texto]
            if not posicoes:
                return False
            del dia[posicoes[min(ocorrencia, len(posicoes) - 1)]]
            if not dia:
                del eventos[chave]

        self.aplicar(remover)

    def keyPressEvent(self, event: QKeyEvent):
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)

AJUDA = """Calendário do jangada.

Uso:
  jangada-calendario                       abre o calendário gráfico
  jangada-calendario add [data] "evento"   adiciona um compromisso
  jangada-calendario listar                lista os compromissos agendados
  jangada-calendario importar arquivo.ics  importa eventos de um arquivo iCalendar

A data aceita hoje, amanhã, depois de amanhã, dd/mm, dd/mm/aaaa ou aaaa-mm-dd.
Sem data, o compromisso vai para hoje."""

def main():
    try:
        executar(sys.argv[1:])
    except ErroEventos as e:
        print(f"jangada-calendario: {e}", file=sys.stderr)
        sys.exit(1)

def executar(args):
    if args:
        cmd = args[0].lower()
        if cmd in ["-h", "--ajuda", "ajuda", "help"]:
            print(AJUDA)
            return
        elif cmd in ["add", "adicionar", "novo"]:
            cli_adicionar(args[1:])
            return
        elif cmd in ["listar", "ls", "eventos"]:
            cli_listar()
            return
        elif cmd in ["importar", "import"]:
            cli_importar(args[1:])
            return

    if not TEM_QT:
        print("jangada-calendario: a janela precisa do PyQt6 (pacote python-pyqt6).", file=sys.stderr)
        sys.exit(1)
    app = QApplication(sys.argv)
    app.setApplicationName("jangada-calendario")
    app.setDesktopFileName("org.jangada.calendario")
    win = CalendarioJangada()
    win.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
