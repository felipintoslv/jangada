#!/usr/bin/env bash
# Captura de tela para a área de transferência e para ~/Imagens/Capturas.
# Uso: jangada-captura regiao|tela
set -euo pipefail
pasta="$HOME/Imagens/Capturas"
[[ -d "$HOME/Imagens" ]] || pasta="$HOME/Pictures/Screenshots"
mkdir -p "$pasta"
arquivo="$pasta/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-regiao}" in
  regiao) regiao="$(slurp)" || exit 0; grim -g "$regiao" "$arquivo" ;;
  tela)   grim "$arquivo" ;;
  *) echo "uso: jangada-captura regiao|tela" >&2; exit 1 ;;
esac
wl-copy <"$arquivo"
notify-send -a jangada -i "$arquivo" "Captura salva" "$arquivo"
