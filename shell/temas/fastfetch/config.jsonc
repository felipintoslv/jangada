// Configuração do fastfetch do jangada, usada por jangada-logo.
// Não substitui ~/.config/fastfetch; é carregada só pelo comando do jangada.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.local/share/jangada/default/logo/jangada.txt",
    "color": { "1": "bright_white", "2": "yellow", "3": "yellow", "4": "cyan" },
    "padding": { "right": 2 }
  },
  "display": { "separator": "  " },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    { "type": "os", "key": "sistema" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "compositor" },
    { "type": "terminal", "key": "terminal" },
    { "type": "shell", "key": "shell" },
    { "type": "packages", "key": "pacotes" },
    { "type": "uptime", "key": "ligado há" },
    { "type": "memory", "key": "memória" },
    { "type": "disk", "key": "disco", "folders": "/" },
    { "type": "command", "key": "agentes", "text": "$JANGADA_PATH/bin/jangada-agentes --lista 2>/dev/null | wc -l" },
    "break",
    "colors"
  ]
}
